DB_PASSWORD=replace-with-a-random-password
DB_ROOT_PASSWORD=replace-with-a-different-random-password
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
TRUST_PROXY=false
PUBLIC_ORIGIN=http://localhost:3000
# Google OAuth Web application; callback: PUBLIC_ORIGIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verification email (587 STARTTLS or 465 with SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Set a random 32-byte hexadecimal key before enabling the maintenance profile.
BACKUP_KEY=
BACKUP_INTERVAL_SECONDS=86400
