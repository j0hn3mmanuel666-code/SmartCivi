{{> head}}

<div class="min-h-screen bg-gradient-to-br from-blue-900 to-blue-700 flex items-center justify-center px-4">
    <div class="text-center text-white">
        <h1 class="text-6xl font-bold mb-4">404</h1>
        <p class="text-2xl mb-8">Page Not Found</p>
        <p class="text-lg mb-8 text-blue-100">The page you're looking for doesn't exist.</p>
        <a href="/" class="inline-block bg-white text-blue-900 font-bold py-2 px-8 rounded-lg hover:bg-blue-100 transition">
            Go Home
        </a>
    </div>
</div>

{{> footer}}
