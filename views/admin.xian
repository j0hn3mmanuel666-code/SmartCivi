{{> head}}
<body>
  <div class="app-shell">
    {{> workspace-sidebar}}
    <main class="main-area">{{> workspace-topbar}}
      <div class="page-content"><section class="welcome-row"><div><p class="eyebrow"><span class="eyebrow-line"></span> SYSTEM ADMINISTRATION</p><h1>Users &amp; categories</h1><p class="welcome-subtitle">Manage who can access DocuTrack and which civil records applicants can request.</p></div></section>
        {{#each success_msg}}<div class="notice notice-success">{{this}}</div>{{/each}}{{#each error_msg}}<div class="notice notice-error">{{this}}</div>{{/each}}
        <section class="admin-columns"><article class="panel admin-panel"><div class="panel-heading"><div><h2>Staff accounts</h2><p>Only staff and administrator accounts can sign in. Suspended users cannot access the workspace.</p></div></div><form class="category-create-form staff-create-form" method="POST" action="/admin/users"><input type="hidden" name="_csrf" value="{{csrfToken}}"><label class="form-label">Staff member name<input name="name" maxlength="120" required></label><label class="form-label">Staff email address<input name="email" type="email" maxlength="190" required></label><label class="form-label">Temporary password<input name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required></label><label class="form-label">Role<select name="role" required><option value="staff">Staff</option><option value="admin">Administrator</option></select></label><button class="button button-primary" type="submit">Create staff account</button></form><div class="table-scroll"><table class="document-table"><thead><tr><th>ACCOUNT</th><th>ROLE</th><th>STATUS</th><th>ACCESS</th></tr></thead><tbody>{{#each users}}<tr><td><div class="admin-user"><strong>{{name}}</strong><span>{{email}}</span></div></td><td colspan="3"><form class="user-access-form" method="POST" action="/admin/users/{{id}}"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><select name="role" aria-label="Role for {{name}}">{{#if isApplicant}}<option value="" selected disabled>Legacy applicant · choose a staff role</option>{{/if}}<option value="staff" {{#if isStaff}}selected{{/if}}>Staff</option><option value="admin" {{#if isAdmin}}selected{{/if}}>Administrator</option></select><select name="accountStatus" aria-label="Account status for {{name}}"><option value="active" {{#if isActive}}selected{{/if}}>Active</option><option value="suspended" {{#unless isActive}}selected{{/unless}}>Suspended</option></select><button class="button button-light save-access" type="submit">Save</button></form></td></tr>{{else}}<tr><td colspan="4" class="empty-row">No staff accounts.</td></tr>{{/each}}</tbody></table></div><div class="admin-note">Applicant requests are public submissions and do not create user accounts. Legacy applicant accounts cannot sign in; promote an existing account to staff only when appropriate.</div></article>
          <article class="panel admin-panel"><div class="panel-heading"><div><h2>Document categories</h2><p>Applicants can choose active request types.</p></div></div><form class="category-create-form" method="POST" action="/admin/categories"><input type="hidden" name="_csrf" value="{{csrfToken}}"><label class="form-label">Category name<input name="name" maxlength="100" placeholder="e.g. Certified true copy" required></label><label class="form-label">Description<input name="description" maxlength="500" placeholder="Short description for applicants"></label><label class="form-label">Typical requirements<textarea name="requirements" maxlength="5000" rows="3" placeholder="List the supporting documents applicants may need."></textarea></label><button class="button button-primary" type="submit">Add category</button></form><div class="category-list">{{#each categories}}<article class="category-row"><div><strong>{{name}}</strong><span>{{#if description}}{{description}}{{else}}No description{{/if}}</span><small>{{#if active}}Active{{else}}Archived{{/if}}</small></div><form method="POST" action="/admin/categories/{{id}}"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><input type="hidden" name="active" value="{{#if active}}false{{else}}true{{/if}}"><button class="button button-light" type="submit">{{#if active}}Archive{{else}}Enable{{/if}}</button></form></article>{{else}}<p class="notification-empty">No document categories yet.</p>{{/each}}</div></article>
        </section><footer class="page-footer"><span>© 2026 DocuTrack · Administrator workspace</span><span><span class="system-status"></span> MySQL-backed access management</span></footer>
      </div>
    </main>
  </div>
  <script src="/workspace.js" defer></script>
{{> footer }}
