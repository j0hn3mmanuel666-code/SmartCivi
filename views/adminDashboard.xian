{{> head }}
<body class="min-h-screen bg-zinc-50 text-zinc-900 antialiased">

  <nav class="sticky top-0 z-50 border-b border-zinc-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-8 gap-y-3 px-5 py-4">
      <a href="/admin" class="text-lg font-bold tracking-tight text-zinc-900">SmartCivi<span class="text-emerald-700">.</span><span class="ml-2 text-xs font-medium uppercase tracking-widest text-zinc-500">Admin</span></a>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
        <a href="/admin" class="text-emerald-800">Overview</a>
        <a href="/admin/requests" class="text-zinc-600 hover:text-zinc-900">Requests</a>
        <a href="/admin/users" class="text-zinc-600 hover:text-zinc-900">Users</a>
        <a href="/admin/appointments" class="text-zinc-600 hover:text-zinc-900">Appointments</a>
        <a href="/admin/reports" class="text-zinc-600 hover:text-zinc-900">Reports</a>
        <a href="/logout" class="border-l border-zinc-200 pl-5 text-zinc-600 hover:text-zinc-900">Sign out</a>
      </div>
    </div>
  </nav>

  <header class="mx-auto max-w-7xl px-5 pb-7 pt-10 sm:pt-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-emerald-800">Operations</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-950">Admin overview</h1>
    <p class="mt-2 max-w-2xl text-sm text-zinc-600">A live snapshot of requests, document demand, and recent activity.</p>
  </header>

  <main class="mx-auto max-w-7xl px-5 pb-12">
    
    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4 mb-8">
      
      <!-- Total Requests -->
      <div class="rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
        <div class="flex items-center">
          <div class="rounded-md bg-emerald-50 p-3 text-emerald-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-zinc-600">Total requests</p>
            <p class="mt-1 text-3xl font-bold tracking-tight text-zinc-950">{{stats.totalRequests}}</p>
          </div>
        </div>
      </div>

      <!-- Pending Requests -->
      <div class="rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
        <div class="flex items-center">
          <div class="rounded-md bg-amber-50 p-3 text-amber-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-zinc-600">Pending</p>
            <p class="mt-1 text-3xl font-bold tracking-tight text-zinc-950">{{stats.pendingRequests}}</p>
          </div>
        </div>
      </div>

      <!-- Completed Requests -->
      <div class="rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
        <div class="flex items-center">
          <div class="rounded-md bg-teal-50 p-3 text-teal-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-zinc-600">Completed</p>
            <p class="mt-1 text-3xl font-bold tracking-tight text-zinc-950">{{stats.completedRequests}}</p>
          </div>
        </div>
      </div>

      <!-- Total Users -->
      <div class="rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
        <div class="flex items-center">
          <div class="rounded-md bg-orange-50 p-3 text-orange-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-zinc-600">Total users</p>
            <p class="mt-1 text-3xl font-bold tracking-tight text-zinc-950">{{stats.totalUsers}}</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 gap-4 mb-8 lg:grid-cols-2">
      
      <!-- Document Types Chart -->
      <div class="rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
        <h3 class="text-base font-semibold text-zinc-900">Most requested documents</h3>
        <div class="relative mt-4 h-56 sm:h-64">
          <canvas id="documentTypesChart" width="400" height="300"></canvas>
        </div>
        <div class="mt-4 space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 rounded-full bg-[#e9a15b] mr-2"></div>
              <span class="text-sm text-gray-600">Birth Certificate</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.birthCount}}</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Marriage Certificate</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.marriageCount}}</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-red-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Death Certificate</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.deathCount}}</span>
          </div>
        </div>
      </div>

      <!-- Status Distribution Chart -->
      <div class="rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
        <h3 class="text-base font-semibold text-zinc-900">Request status distribution</h3>
        <div class="relative mt-4 h-56 sm:h-64">
          <canvas id="statusChart" width="400" height="300"></canvas>
        </div>
        <div class="mt-4 space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-yellow-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Pending</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.pendingRequests}}</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 rounded-full bg-[#8ba39a] mr-2"></div>
              <span class="text-sm text-gray-600">Processing</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.processingRequests}}</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Approved</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.approvedRequests}}</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 rounded-full bg-[#e9a15b] mr-2"></div>
              <span class="text-sm text-gray-600">Paid</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.paidRequests}}</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Recent Activity and Quick Actions -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      
      <!-- Recent Requests -->
      <div class="rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-base font-semibold text-zinc-900">Recent requests</h3>
          <a href="/admin/requests" class="text-sm font-semibold text-emerald-800 hover:text-emerald-900">View all <span aria-hidden="true">&#8594;</span></a>
        </div>
        <div class="space-y-3">
          {{#each recentRequests}}
            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-zinc-100 py-3 first:border-0">
              <div>
                <p class="text-sm font-medium text-gray-900">{{this.fullName}}</p>
                <p class="text-xs text-gray-600">{{this.documentType}} certificate</p>
              </div>
              <div class="text-right">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                  {{#ifEq this.status 'pending'}}bg-yellow-100 text-yellow-800{{/ifEq}}
                  {{#ifEq this.status 'processing'}}bg-teal-100 text-teal-800{{/ifEq}}
                  {{#ifEq this.status 'approved'}}bg-green-100 text-green-800{{/ifEq}}
                  {{#ifEq this.status 'rejected'}}bg-red-100 text-red-800{{/ifEq}}
                  {{#ifEq this.status 'paid'}}bg-orange-100 text-orange-800{{/ifEq}}">
                  {{this.status}}
                </span>
                <p class="text-xs text-gray-500 mt-1">{{this.createdAt}}</p>
              </div>
            </div>
          {{else}}
            <p class="text-gray-500 text-center py-4">No recent requests</p>
          {{/each}}
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
        <h3 class="text-base font-semibold text-zinc-900 mb-4">Quick actions</h3>
        <div class="divide-y divide-zinc-100">
          <a href="/admin/requests" class="group flex items-center gap-3 py-3 first:pt-0 hover:text-emerald-900">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-emerald-50 text-emerald-800">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </span>
            <span><span class="block text-sm font-semibold text-zinc-900">Manage requests</span><span class="mt-1 block text-xs text-zinc-500">Review and update applications</span></span>
            <span class="ml-auto text-zinc-400 transition group-hover:translate-x-1 group-hover:text-emerald-800" aria-hidden="true">&#8594;</span>
          </a>
          <a href="/admin/users" class="group flex items-center gap-3 py-3 hover:text-emerald-900">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-orange-50 text-orange-800">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2m16 0v-2a4 4 0 00-3-3.87M14 3.13a4 4 0 010 7.75M14 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </span>
            <span><span class="block text-sm font-semibold text-zinc-900">Manage users</span><span class="mt-1 block text-xs text-zinc-500">Review citizen accounts</span></span>
            <span class="ml-auto text-zinc-400 transition group-hover:translate-x-1 group-hover:text-emerald-800" aria-hidden="true">&#8594;</span>
          </a>
          <a href="/admin/appointments" class="group flex items-center gap-3 py-3 hover:text-emerald-900">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-emerald-50 text-emerald-800">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M4 11h16M5 5h14a1 1 0 011 1v13H4V6a1 1 0 011-1z"></path></svg>
            </span>
            <span><span class="block text-sm font-semibold text-zinc-900">Manage appointments</span><span class="mt-1 block text-xs text-zinc-500">Review scheduled visits</span></span>
            <span class="ml-auto text-zinc-400 transition group-hover:translate-x-1 group-hover:text-emerald-800" aria-hidden="true">&#8594;</span>
          </a>
          <a href="/admin/reports" class="group flex items-center gap-3 py-3 hover:text-emerald-900">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-orange-50 text-orange-800">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19V5m0 14h16M8 15v-3m4 3V8m4 7v-5"></path></svg>
            </span>
            <span><span class="block text-sm font-semibold text-zinc-900">Generate reports</span><span class="mt-1 block text-xs text-zinc-500">View registry activity</span></span>
            <span class="ml-auto text-zinc-400 transition group-hover:translate-x-1 group-hover:text-emerald-800" aria-hidden="true">&#8594;</span>
          </a>
          <a href="/records" class="group flex items-center gap-3 py-3 last:pb-0 hover:text-emerald-900">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-zinc-100 text-zinc-700">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.2-5.2M10.8 17a6.2 6.2 0 110-12.4 6.2 6.2 0 010 12.4z"></path></svg>
            </span>
            <span><span class="block text-sm font-semibold text-zinc-900">Search records</span><span class="mt-1 block text-xs text-zinc-500">Find civil registry records</span></span>
            <span class="ml-auto text-zinc-400 transition group-hover:translate-x-1 group-hover:text-emerald-800" aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>

    </div>

  </main>



  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <script>
    // Document Types Pie Chart
    const documentCtx = document.getElementById('documentTypesChart').getContext('2d');
    new Chart(documentCtx, {
      type: 'doughnut',
      data: {
        labels: ['Birth Certificate', 'Marriage Certificate', 'Death Certificate'],
        datasets: [{
          data: [{{stats.birthCount}}, {{stats.marriageCount}}, {{stats.deathCount}}],
          backgroundColor: ['#e9a15b', '#1f593e', '#bd5948'],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        }
      }
    });

    // Status Distribution Chart
    const statusCtx = document.getElementById('statusChart').getContext('2d');
    new Chart(statusCtx, {
      type: 'doughnut',
      data: {
        labels: ['Pending', 'Processing', 'Approved', 'Paid'],
        datasets: [{
          data: [{{stats.pendingRequests}}, {{stats.processingRequests}}, {{stats.approvedRequests}}, {{stats.paidRequests}}],
          backgroundColor: ['#e9a15b', '#8ba39a', '#1f593e', '#c77c3e'],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        }
      }
    });
  </script>

</body>