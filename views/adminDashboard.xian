{{> head }}
<body class="bg-gradient-to-br from-pink-300 via-purple-300 to-blue-400 text-gray-800 min-h-screen">

  <nav class="fixed w-full top-0 z-50 bg-gradient-to-r from-pink-500 to-blue-600 text-white shadow-lg">
    <div class="container mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="text-2xl font-bold tracking-wide">SmartCivi</a>

      <ul class="hidden md:flex space-x-6 font-medium">
        <li><a href="/admin" class="hover:text-yellow-300 transition-all text-yellow-300">Dashboard</a></li>
        <li><a href="/admin/requests" class="hover:text-yellow-300 transition-all">Requests</a></li>
        <li><a href="/admin/users" class="hover:text-yellow-300 transition-all">Users</a></li>
        <li><a href="/help" class="hover:text-yellow-300 transition-all">Help</a></li>
      </ul>

      <div class="hidden md:flex space-x-4">
        <a href="/logout" class="bg-white text-blue-600 px-4 py-2 rounded-md hover:bg-gray-100 transition-all">Logout</a>
      </div>

      <button class="md:hidden hover:opacity-80">☰</button>
    </div>
  </nav>

  <section class="flex flex-col justify-center items-center text-center h-44 px-6 pt-24">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white drop-shadow-md">Admin Dashboard</h1>
    <p class="text-md md:text-lg text-white mt-3 max-w-2xl">System overview and analytics for SmartCivi civil registry management.</p>
  </section>

  <main class="container mx-auto px-4 py-8">
    
    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      
      <!-- Total Requests -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-blue-100 text-blue-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Total Requests</p>
            <p class="text-2xl font-bold text-gray-900">{{stats.totalRequests}}</p>
          </div>
        </div>
      </div>

      <!-- Pending Requests -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-yellow-100 text-yellow-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Pending</p>
            <p class="text-2xl font-bold text-gray-900">{{stats.pendingRequests}}</p>
          </div>
        </div>
      </div>

      <!-- Completed Requests -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-green-100 text-green-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Completed</p>
            <p class="text-2xl font-bold text-gray-900">{{stats.completedRequests}}</p>
          </div>
        </div>
      </div>

      <!-- Total Users -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-purple-100 text-purple-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Total Users</p>
            <p class="text-2xl font-bold text-gray-900">{{stats.totalUsers}}</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      
      <!-- Document Types Chart -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Most Requested Documents</h3>
        <div class="relative">
          <canvas id="documentTypesChart" width="400" height="300"></canvas>
        </div>
        <div class="mt-4 space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Birth Certificate</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.birthCount}}</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Marriage Certificate</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.marriageCount}}</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-red-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Death Certificate</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.deathCount}}</span>
          </div>
        </div>
      </div>

      <!-- Status Distribution Chart -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Request Status Distribution</h3>
        <div class="relative">
          <canvas id="statusChart" width="400" height="300"></canvas>
        </div>
        <div class="mt-4 space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-yellow-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Pending</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.pendingRequests}}</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Processing</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.processingRequests}}</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Approved</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.approvedRequests}}</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="w-3 h-3 bg-purple-500 rounded-full mr-2"></div>
              <span class="text-sm text-gray-600">Paid</span>
            </div>
            <span class="text-sm font-medium text-gray-900">{{stats.paidRequests}}</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Recent Activity and Quick Actions -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Recent Requests -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-semibold text-gray-800">Recent Requests</h3>
          <a href="/admin/requests" class="text-sm text-blue-600 hover:text-blue-800">View All</a>
        </div>
        <div class="space-y-3">
          {{#each recentRequests}}
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <div>
                <p class="text-sm font-medium text-gray-900">{{this.fullName}}</p>
                <p class="text-xs text-gray-600">{{this.documentType}} certificate</p>
              </div>
              <div class="text-right">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                  {{#ifEq this.status 'pending'}}bg-yellow-100 text-yellow-800{{/ifEq}}
                  {{#ifEq this.status 'processing'}}bg-blue-100 text-blue-800{{/ifEq}}
                  {{#ifEq this.status 'approved'}}bg-green-100 text-green-800{{/ifEq}}
                  {{#ifEq this.status 'rejected'}}bg-red-100 text-red-800{{/ifEq}}
                  {{#ifEq this.status 'paid'}}bg-purple-100 text-purple-800{{/ifEq}}">
                  {{this.status}}
                </span>
                <p class="text-xs text-gray-500 mt-1">{{this.createdAt}}</p>
              </div>
            </div>
          {{else}}
            <p class="text-gray-500 text-center py-4">No recent requests</p>
          {{/each}}
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Quick Actions</h3>
        <div class="space-y-3">
          
          <a href="/admin/requests" class="flex items-center p-3 bg-blue-50 rounded-lg hover:bg-blue-100 transition-all">
            <div class="p-2 bg-blue-600 rounded-lg text-white mr-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-gray-900">Manage Requests</p>
              <p class="text-sm text-gray-600">View and update all requests</p>
            </div>
          </a>

          <a href="/admin/users" class="flex items-center p-3 bg-green-50 rounded-lg hover:bg-green-100 transition-all">
            <div class="p-2 bg-green-600 rounded-lg text-white mr-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-gray-900">Manage Users</p>
              <p class="text-sm text-gray-600">Add and manage user accounts</p>
            </div>
          </a>

          <a href="/admin/appointments" class="flex items-center p-3 bg-orange-50 rounded-lg hover:bg-orange-100 transition-all">
            <div class="p-2 bg-orange-600 rounded-lg text-white mr-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a2 2 0 012-2h4a2 2 0 012 2v4m-6 0V6a2 2 0 012-2

          <a href="/admin/reports" class="flex items-center p-3 bg-purple-50 rounded-lg hover:bg-purple-100 transition-all">
            <div class="p-2 bg-purple-600 rounded-lg text-white mr-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-gray-900">Generate Reports</p>
              <p class="text-sm text-gray-600">Create system reports</p>
            </div>
          </a>

          <a href="/records" class="flex items-center p-3 bg-orange-50 rounded-lg hover:bg-orange-100 transition-all">
            <div class="p-2 bg-orange-600 rounded-lg text-white mr-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <div>
              <p class="font-medium text-gray-900">Search Records</p>
              <p class="text-sm text-gray-600">Search civil registry records</p>
            </div>
          </a>

        </div>
      </div>

    </div>

  </main>



  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <script>
    // Document Types Pie Chart
    const documentCtx = document.getElementById('documentTypesChart').getContext('2d');
    new Chart(documentCtx, {
      type: 'doughnut',
      data: {
        labels: ['Birth Certificate', 'Marriage Certificate', 'Death Certificate'],
        datasets: [{
          data: [{{stats.birthCount}}, {{stats.marriageCount}}, {{stats.deathCount}}],
          backgroundColor: ['#3B82F6', '#10B981', '#EF4444'],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        }
      }
    });

    // Status Distribution Chart
    const statusCtx = document.getElementById('statusChart').getContext('2d');
    new Chart(statusCtx, {
      type: 'doughnut',
      data: {
        labels: ['Pending', 'Processing', 'Approved', 'Paid'],
        datasets: [{
          data: [{{stats.pendingRequests}}, {{stats.processingRequests}}, {{stats.approvedRequests}}, {{stats.paidRequests}}],
          backgroundColor: ['#F59E0B', '#3B82F6', '#10B981', '#8B5CF6'],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        }
      }
    });
  </script>

</body>