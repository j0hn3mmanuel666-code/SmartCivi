{{> head }}
<body class="min-h-screen bg-zinc-50 text-zinc-900 antialiased">

  <nav class="sticky top-0 z-50 border-b border-zinc-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-8 gap-y-3 px-5 py-4">
      <a href="/admin" class="text-lg font-bold tracking-tight text-zinc-900">SmartCivi<span class="text-emerald-700">.</span><span class="ml-2 text-xs font-medium uppercase tracking-widest text-zinc-500">Admin</span></a>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
        <a href="/admin" class="text-zinc-600 hover:text-zinc-900">Overview</a>
        <a href="/admin/requests" class="text-emerald-800">Requests</a>
        <a href="/admin/users" class="text-zinc-600 hover:text-zinc-900">Users</a>
        <a href="/admin/appointments" class="text-zinc-600 hover:text-zinc-900">Appointments</a>
        <a href="/admin/reports" class="text-zinc-600 hover:text-zinc-900">Reports</a>
        <a href="/logout" class="border-l border-zinc-200 pl-5 text-zinc-600 hover:text-zinc-900">Sign out</a>
      </div>
    </div>
  </nav>

  <header class="mx-auto max-w-7xl px-5 pb-7 pt-10 sm:pt-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-emerald-800">Operations</p>
    <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-zinc-950">Manage requests</h1>
        <p class="mt-2 max-w-2xl text-sm text-zinc-600">Review applications, update their status, and open request details.</p>
      </div>
      <a href="/admin" class="text-sm font-semibold text-emerald-800 hover:text-emerald-900">Back to overview <span aria-hidden="true">&#8594;</span></a>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-5 pb-12">
    
    <!-- Filter Tabs -->
    <div class="mb-4 rounded-lg border border-zinc-200 bg-white p-4 shadow-sm">
      <div class="flex flex-wrap gap-2">
        <button id="filterAll" class="min-h-10 rounded-md bg-emerald-800 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-900 transition-all">
          All Requests
        </button>
        <button id="filterPending" class="min-h-10 rounded-md bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-200 transition-all">
          Pending
        </button>
        <button id="filterProcessing" class="min-h-10 rounded-md bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-200 transition-all">
          Processing
        </button>
        <button id="filterApproved" class="min-h-10 rounded-md bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-200 transition-all">
          Approved
        </button>
        <button id="filterPaid" class="min-h-10 rounded-md bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-200 transition-all">
          Paid
        </button>
        <button id="filterRejected" class="min-h-10 rounded-md bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-200 transition-all">
          Rejected
        </button>
      </div>
    </div>

    <!-- Requests Table -->
    <div class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm sm:p-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold text-zinc-900">All requests</h2>
        <div class="text-sm text-zinc-600">
          Total: <span id="totalCount">{{requests.length}}</span> requests
        </div>
      </div>

      {{#if requests}}
        <div class="overflow-x-auto">
          <table class="min-w-[1080px] w-full">
            <thead class="border-y border-zinc-200 bg-zinc-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">ID</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">Name</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">Document</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">Email</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">Phone</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">Submitted</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">Status</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200" id="requestsTableBody">
              {{#each requests}}
                <tr class="border-b border-zinc-100 hover:bg-emerald-50/40 request-row" data-status="{{this.status}}" data-request-id="{{this.id}}">
                  <td class="px-4 py-3 text-sm font-medium text-zinc-500">#{{this.id}}</td>
                  <td class="px-4 py-3 text-sm font-medium text-zinc-900">{{this.fullName}}</td>
                  <td class="px-4 py-3 text-sm capitalize text-zinc-700">{{this.documentType}}</td>
                  <td class="px-4 py-3 text-sm text-zinc-600">{{this.email}}</td>
                  <td class="px-4 py-3 text-sm text-zinc-600">{{this.phone}}</td>
                  <td class="px-4 py-3 text-sm text-zinc-600">{{this.createdAt}}</td>
                  <td class="px-4 py-3">
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                      {{#ifEq this.status 'pending'}}bg-yellow-100 text-yellow-800{{/ifEq}}
                      {{#ifEq this.status 'processing'}}bg-blue-100 text-blue-800{{/ifEq}}
                      {{#ifEq this.status 'approved'}}bg-green-100 text-green-800{{/ifEq}}
                      {{#ifEq this.status 'rejected'}}bg-red-100 text-red-800{{/ifEq}}
                      {{#ifEq this.status 'paid'}}bg-purple-100 text-purple-800{{/ifEq}}
                      {{#ifEq this.status 'payment_pending'}}bg-orange-100 text-orange-800{{/ifEq}}">
                      {{this.status}}
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex items-center space-x-2">
                      <!-- Status Update -->
                      <form method="POST" action="/admin/requests/{{this.id}}/status" class="flex items-center space-x-1">
                        <select name="status" class="min-h-9 rounded-md border border-zinc-300 bg-white px-2 py-1 text-xs text-zinc-700 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20">
                          <option value="pending" {{#ifEq this.status 'pending'}}selected{{/ifEq}}>Pending</option>
                          <option value="processing" {{#ifEq this.status 'processing'}}selected{{/ifEq}}>Processing</option>
                          <option value="approved" {{#ifEq this.status 'approved'}}selected{{/ifEq}}>Approved</option>
                          <option value="rejected" {{#ifEq this.status 'rejected'}}selected{{/ifEq}}>Rejected</option>
                          <option value="paid" {{#ifEq this.status 'paid'}}selected{{/ifEq}}>Paid</option>
                        </select>
                        <button type="submit" class="min-h-9 rounded-md bg-emerald-800 px-3 py-1 text-xs font-semibold text-white hover:bg-emerald-900 transition-all">
                          Update
                        </button>
                      </form>

                      <!-- View Button -->
                      <a href="/request/{{this.id}}" class="inline-flex min-h-9 items-center rounded-md border border-zinc-300 px-3 py-1 text-xs font-semibold text-zinc-700 hover:bg-zinc-100 transition-all">
                        View
                      </a>

                      <!-- Delete Button -->
                      <form method="POST" action="/admin/requests/{{this.id}}/delete" onsubmit="return confirm('Are you sure you want to delete this request? This cannot be undone.')" class="inline">
                        <button type="submit" class="min-h-9 rounded-md px-3 py-1 text-xs font-semibold text-red-700 hover:bg-red-50 transition-all">
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="text-center py-12">
          <div class="text-6xl text-gray-300 mb-4">📋</div>
          <h3 class="text-lg font-medium text-gray-800 mb-2">No Requests Found</h3>
          <p class="text-gray-600">No civil registry requests have been submitted yet.</p>
        </div>
      {{/if}}

    </div>
  </main>



  <script>
    // Filter functionality
    const filterButtons = {
      filterAll: document.getElementById('filterAll'),
      filterPending: document.getElementById('filterPending'),
      filterProcessing: document.getElementById('filterProcessing'),
      filterApproved: document.getElementById('filterApproved'),
      filterPaid: document.getElementById('filterPaid'),
      filterRejected: document.getElementById('filterRejected')
    };

    const requestRows = document.querySelectorAll('.request-row');
    const totalCountElement = document.getElementById('totalCount');

    function setActiveFilter(activeButton) {
      Object.values(filterButtons).forEach(btn => {
        btn.classList.remove('bg-blue-600', 'text-white');
        btn.classList.add('bg-gray-200', 'text-gray-700');
      });
      activeButton.classList.remove('bg-gray-200', 'text-gray-700');
      activeButton.classList.add('bg-blue-600', 'text-white');
    }

    function filterRequests(status) {
      let visibleCount = 0;
      requestRows.forEach(row => {
        const rowStatus = row.getAttribute('data-status');
        if (status === 'all' || rowStatus === status) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });
      totalCountElement.textContent = visibleCount;
    }

    // Add event listeners
    filterButtons.filterAll.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterAll);
      filterRequests('all');
    });

    filterButtons.filterPending.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterPending);
      filterRequests('pending');
    });

    filterButtons.filterProcessing.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterProcessing);
      filterRequests('processing');
    });

    filterButtons.filterApproved.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterApproved);
      filterRequests('approved');
    });

    filterButtons.filterPaid.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterPaid);
      filterRequests('paid');
    });

    filterButtons.filterRejected.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterRejected);
      filterRequests('rejected');
    });

    // AJAX form handling for status updates
    document.addEventListener('submit', async function(e) {
      const form = e.target;
      if (form.action && form.action.includes('/admin/requests/') && form.action.includes('/status')) {
        e.preventDefault();
        
        const formData = new FormData(form);
        const newStatus = formData.get('status');
        
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
          });

          const data = await response.json();
          
          if (data.success) {
            // Update the status badge in the row
            const row = form.closest('tr');
            const statusCell = row.querySelector('td:nth-child(7) span');
            
            // Remove old classes
            statusCell.className = 'inline-flex px-2 py-1 text-xs font-semibold rounded-full';
            
            // Add new classes based on status
            const statusClasses = {
              'pending': 'bg-yellow-100 text-yellow-800',
              'processing': 'bg-blue-100 text-blue-800',
              'approved': 'bg-green-100 text-green-800',
              'rejected': 'bg-red-100 text-red-800',
              'paid': 'bg-purple-100 text-purple-800',
              'payment_pending': 'bg-orange-100 text-orange-800'
            };
            
            statusCell.className += ' ' + (statusClasses[newStatus] || 'bg-gray-100 text-gray-800');
            statusCell.textContent = newStatus;
            
            // Update row data attribute
            row.setAttribute('data-status', newStatus);
            
            showMessage('Status updated successfully', 'success');
          } else {
            showMessage('Failed to update status', 'error');
          }
        } catch (error) {
          console.error('Error updating status:', error);
          showMessage('An error occurred while updating status', 'error');
        }
      }
    });

    // Show message function
    function showMessage(message, type) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `fixed top-20 right-4 px-4 py-2 rounded-md text-white z-50 ${
        type === 'success' ? 'bg-green-600' : 'bg-red-600'
      }`;
      messageDiv.textContent = message;
      
      document.body.appendChild(messageDiv);
      
      setTimeout(() => {
        messageDiv.remove();
      }, 3000);
    }
  </script>

</body>