{{> head }}
<body class="bg-gradient-to-br from-pink-300 via-purple-300 to-blue-400 text-gray-800 min-h-screen">

  <nav class="fixed w-full top-0 z-50 bg-gradient-to-r from-pink-500 to-blue-600 text-white shadow-lg">
    <div class="container mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="text-2xl font-bold tracking-wide">SmartCivi</a>

      <ul class="hidden md:flex space-x-6 font-medium">
        <li><a href="/admin" class="hover:text-yellow-300 transition-all">Dashboard</a></li>
        <li><a href="/admin/requests" class="hover:text-yellow-300 transition-all text-yellow-300">Requests</a></li>
        <li><a href="/admin/users" class="hover:text-yellow-300 transition-all">Users</a></li>
        <li><a href="/help" class="hover:text-yellow-300 transition-all">Help</a></li>
      </ul>

      <div class="hidden md:flex space-x-4">
        <a href="/logout" class="bg-white text-blue-600 px-4 py-2 rounded-md hover:bg-gray-100 transition-all">Logout</a>
      </div>

      <button class="md:hidden hover:opacity-80">☰</button>
    </div>
  </nav>

  <section class="flex flex-col justify-center items-center text-center h-44 px-6 pt-24">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white drop-shadow-md">Manage Requests</h1>
    <p class="text-md md:text-lg text-white mt-3 max-w-2xl">Review, update, and manage all civil registry requests.</p>
    <div class="mt-3">
      <a href="/admin" class="text-sm text-white underline">← Back to Admin Dashboard</a>
    </div>
  </section>

  <main class="container mx-auto px-4 py-8">
    
    <!-- Filter Tabs -->
    <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-4 mb-6 max-w-6xl mx-auto">
      <div class="flex flex-wrap gap-2 justify-center">
        <button id="filterAll" class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 transition-all">
          All Requests
        </button>
        <button id="filterPending" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-300 transition-all">
          Pending
        </button>
        <button id="filterProcessing" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-300 transition-all">
          Processing
        </button>
        <button id="filterApproved" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-300 transition-all">
          Approved
        </button>
        <button id="filterPaid" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-300 transition-all">
          Paid
        </button>
        <button id="filterRejected" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md text-sm font-medium hover:bg-gray-300 transition-all">
          Rejected
        </button>
      </div>
    </div>

    <!-- Requests Table -->
    <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6 max-w-6xl mx-auto">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-semibold text-gray-800">All Requests</h2>
        <div class="text-sm text-gray-600">
          Total: <span id="totalCount">{{requests.length}}</span> requests
        </div>
      </div>

      {{#if requests}}
        <div class="overflow-x-auto">
          <table class="min-w-full">
            <thead class="bg-gray-100">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">ID</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Name</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Document</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Email</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Phone</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Submitted</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Status</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200" id="requestsTableBody">
              {{#each requests}}
                <tr class="hover:bg-gray-50 request-row" data-status="{{this.status}}" data-request-id="{{this.id}}">
                  <td class="px-4 py-3 text-sm text-gray-900">#{{this.id}}</td>
                  <td class="px-4 py-3 text-sm text-gray-900">{{this.fullName}}</td>
                  <td class="px-4 py-3 text-sm text-gray-600 capitalize">{{this.documentType}}</td>
                  <td class="px-4 py-3 text-sm text-gray-600">{{this.email}}</td>
                  <td class="px-4 py-3 text-sm text-gray-600">{{this.phone}}</td>
                  <td class="px-4 py-3 text-sm text-gray-600">{{this.createdAt}}</td>
                  <td class="px-4 py-3">
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                      {{#ifEq this.status 'pending'}}bg-yellow-100 text-yellow-800{{/ifEq}}
                      {{#ifEq this.status 'processing'}}bg-blue-100 text-blue-800{{/ifEq}}
                      {{#ifEq this.status 'approved'}}bg-green-100 text-green-800{{/ifEq}}
                      {{#ifEq this.status 'rejected'}}bg-red-100 text-red-800{{/ifEq}}
                      {{#ifEq this.status 'paid'}}bg-purple-100 text-purple-800{{/ifEq}}
                      {{#ifEq this.status 'payment_pending'}}bg-orange-100 text-orange-800{{/ifEq}}">
                      {{this.status}}
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex items-center space-x-2">
                      <!-- Status Update -->
                      <form method="POST" action="/admin/requests/{{this.id}}/status" class="flex items-center space-x-1">
                        <select name="status" class="text-xs px-2 py-1 border border-gray-300 rounded">
                          <option value="pending" {{#ifEq this.status 'pending'}}selected{{/ifEq}}>Pending</option>
                          <option value="processing" {{#ifEq this.status 'processing'}}selected{{/ifEq}}>Processing</option>
                          <option value="approved" {{#ifEq this.status 'approved'}}selected{{/ifEq}}>Approved</option>
                          <option value="rejected" {{#ifEq this.status 'rejected'}}selected{{/ifEq}}>Rejected</option>
                          <option value="paid" {{#ifEq this.status 'paid'}}selected{{/ifEq}}>Paid</option>
                        </select>
                        <button type="submit" class="bg-blue-600 text-white px-2 py-1 rounded text-xs hover:bg-blue-700 transition-all">
                          Update
                        </button>
                      </form>

                      <!-- View Button -->
                      <a href="/request/{{this.id}}" class="bg-green-600 text-white px-2 py-1 rounded text-xs hover:bg-green-700 transition-all">
                        View
                      </a>

                      <!-- Delete Button -->
                      <form method="POST" action="/admin/requests/{{this.id}}/delete" onsubmit="return confirm('Are you sure you want to delete this request? This cannot be undone.')" class="inline">
                        <button type="submit" class="bg-red-600 text-white px-2 py-1 rounded text-xs hover:bg-red-700 transition-all">
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="text-center py-12">
          <div class="text-6xl text-gray-300 mb-4">📋</div>
          <h3 class="text-lg font-medium text-gray-800 mb-2">No Requests Found</h3>
          <p class="text-gray-600">No civil registry requests have been submitted yet.</p>
        </div>
      {{/if}}

    </div>
  </main>



  <script>
    // Filter functionality
    const filterButtons = {
      filterAll: document.getElementById('filterAll'),
      filterPending: document.getElementById('filterPending'),
      filterProcessing: document.getElementById('filterProcessing'),
      filterApproved: document.getElementById('filterApproved'),
      filterPaid: document.getElementById('filterPaid'),
      filterRejected: document.getElementById('filterRejected')
    };

    const requestRows = document.querySelectorAll('.request-row');
    const totalCountElement = document.getElementById('totalCount');

    function setActiveFilter(activeButton) {
      Object.values(filterButtons).forEach(btn => {
        btn.classList.remove('bg-blue-600', 'text-white');
        btn.classList.add('bg-gray-200', 'text-gray-700');
      });
      activeButton.classList.remove('bg-gray-200', 'text-gray-700');
      activeButton.classList.add('bg-blue-600', 'text-white');
    }

    function filterRequests(status) {
      let visibleCount = 0;
      requestRows.forEach(row => {
        const rowStatus = row.getAttribute('data-status');
        if (status === 'all' || rowStatus === status) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });
      totalCountElement.textContent = visibleCount;
    }

    // Add event listeners
    filterButtons.filterAll.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterAll);
      filterRequests('all');
    });

    filterButtons.filterPending.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterPending);
      filterRequests('pending');
    });

    filterButtons.filterProcessing.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterProcessing);
      filterRequests('processing');
    });

    filterButtons.filterApproved.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterApproved);
      filterRequests('approved');
    });

    filterButtons.filterPaid.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterPaid);
      filterRequests('paid');
    });

    filterButtons.filterRejected.addEventListener('click', () => {
      setActiveFilter(filterButtons.filterRejected);
      filterRequests('rejected');
    });

    // AJAX form handling for status updates
    document.addEventListener('submit', async function(e) {
      const form = e.target;
      if (form.action && form.action.includes('/admin/requests/') && form.action.includes('/status')) {
        e.preventDefault();
        
        const formData = new FormData(form);
        const newStatus = formData.get('status');
        
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
          });

          const data = await response.json();
          
          if (data.success) {
            // Update the status badge in the row
            const row = form.closest('tr');
            const statusCell = row.querySelector('td:nth-child(7) span');
            
            // Remove old classes
            statusCell.className = 'inline-flex px-2 py-1 text-xs font-semibold rounded-full';
            
            // Add new classes based on status
            const statusClasses = {
              'pending': 'bg-yellow-100 text-yellow-800',
              'processing': 'bg-blue-100 text-blue-800',
              'approved': 'bg-green-100 text-green-800',
              'rejected': 'bg-red-100 text-red-800',
              'paid': 'bg-purple-100 text-purple-800',
              'payment_pending': 'bg-orange-100 text-orange-800'
            };
            
            statusCell.className += ' ' + (statusClasses[newStatus] || 'bg-gray-100 text-gray-800');
            statusCell.textContent = newStatus;
            
            // Update row data attribute
            row.setAttribute('data-status', newStatus);
            
            showMessage('Status updated successfully', 'success');
          } else {
            showMessage('Failed to update status', 'error');
          }
        } catch (error) {
          console.error('Error updating status:', error);
          showMessage('An error occurred while updating status', 'error');
        }
      }
    });

    // Show message function
    function showMessage(message, type) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `fixed top-20 right-4 px-4 py-2 rounded-md text-white z-50 ${
        type === 'success' ? 'bg-green-600' : 'bg-red-600'
      }`;
      messageDiv.textContent = message;
      
      document.body.appendChild(messageDiv);
      
      setTimeout(() => {
        messageDiv.remove();
      }, 3000);
    }
  </script>

</body>