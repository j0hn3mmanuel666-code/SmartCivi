{{> head }}
<body class="office legacy-workspace bg-gradient-to-br from-pink-300 via-purple-300 to-blue-400 text-gray-800 min-h-screen">

  {{> staffNav}}

  <section class="flex flex-col justify-center items-center text-center h-44 px-6 pt-24">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white drop-shadow-md">Request Attachments</h1>
    <p class="text-md md:text-lg text-white mt-3 max-w-2xl">View and manage attachments for your civil registry request.</p>
    <div class="mt-3">
      <a href="/request/{{requestId}}" class="text-sm text-white underline">← Back to Request Details</a>
    </div>
  </section>

  <main id="main" class="container mx-auto px-4 py-8">
    
    {{#if request}}
      <!-- Request Information -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6 mb-6 max-w-4xl mx-auto">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Request Information</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-gray-600">Request ID</p>
            <p class="font-medium text-gray-900">#{{request.id}}</p>
          </div>
          <div>
            <p class="text-sm text-gray-600">Document Type</p>
            <p class="font-medium text-gray-900 capitalize">{{request.documentType}} Certificate</p>
          </div>
          <div>
            <p class="text-sm text-gray-600">Applicant Name</p>
            <p class="font-medium text-gray-900">{{request.fullName}}</p>
          </div>
          <div>
            <p class="text-sm text-gray-600">Status</p>
            <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
              {{#ifEq request.status 'pending'}}bg-yellow-100 text-yellow-800{{/ifEq}}
              {{#ifEq request.status 'processing'}}bg-blue-100 text-blue-800{{/ifEq}}
              {{#ifEq request.status 'approved'}}bg-green-100 text-green-800{{/ifEq}}
              {{#ifEq request.status 'rejected'}}bg-red-100 text-red-800{{/ifEq}}
              {{#ifEq request.status 'paid'}}bg-purple-100 text-purple-800{{/ifEq}}">
              {{request.status}}
            </span>
          </div>
        </div>
      </div>

      <!-- Upload Attachments Section -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6 mb-6 max-w-4xl mx-auto">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Upload Supporting Documents</h2>
        <p class="text-gray-600 mb-4">Upload any supporting documents required for your {{request.documentType}} certificate request.</p>
        
        <form id="uploadForm" enctype="multipart/form-data" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Select Files</label>
            <input type="file" id="fileInput" name="attachments" multiple accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" 
                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <p class="text-xs text-gray-500 mt-1">Accepted formats: PDF, JPG, PNG, DOC, DOCX (Max 5MB per file)</p>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Document Description</label>
            <input type="text" id="descriptionInput" placeholder="e.g., Birth Certificate Copy, Valid ID, etc." 
                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          
          <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 transition-all">
            Upload Files
          </button>
        </form>
      </div>

      <!-- Existing Attachments -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6 max-w-4xl mx-auto">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Uploaded Documents</h2>
        
        <div id="attachmentsList">
          {{#if attachments}}
            <div class="space-y-3">
              {{#each attachments}}
                <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                  <div class="flex items-center space-x-3">
                    <div class="p-2 bg-blue-100 rounded-lg">
                      {{#if (isImage this.fileType)}}
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                      {{else}}
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                      {{/if}}
                    </div>
                    <div>
                      <p class="font-medium text-gray-900">{{this.fileName}}</p>
                      <p class="text-sm text-gray-600">{{this.description}}</p>
                      <p class="text-xs text-gray-500">Uploaded: {{this.uploadedAt}} • {{this.fileSize}}</p>
                    </div>
                  </div>
                  <div class="flex items-center space-x-2">
                    <a href="/attachments/{{this.id}}/download" class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700 transition-all">
                      Download
                    </a>
                    <button onclick="deleteAttachment({{this.id}})" class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700 transition-all">
                      Delete
                    </button>
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <div class="text-center py-12">
              <div class="text-6xl text-gray-300 mb-4">📎</div>
              <h3 class="text-lg font-medium text-gray-800 mb-2">No Attachments Yet</h3>
              <p class="text-gray-600">Upload supporting documents to help process your request faster.</p>
            </div>
          {{/if}}
        </div>
      </div>

    {{else}}
      <!-- Request Not Found -->
      <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6 max-w-4xl mx-auto">
        <div class="text-center py-12">
          <div class="text-6xl text-gray-300 mb-4">❌</div>
          <h2 class="text-2xl font-bold text-gray-800 mb-2">Request Not Found</h2>
          <p class="text-gray-600 mb-6">The request you're looking for doesn't exist or you don't have permission to view it.</p>
          <a href="/records" class="bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 transition-all">
            Back to My Records
          </a>
        </div>
      </div>
    {{/if}}

  </main>

  <script>
    // File upload handling
    document.getElementById('uploadForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const fileInput = document.getElementById('fileInput');
      const descriptionInput = document.getElementById('descriptionInput');
      const files = fileInput.files;
      
      if (files.length === 0) {
        alert('Please select at least one file to upload');
        return;
      }
      
      const formData = new FormData();
      for (let i = 0; i < files.length; i++) {
        formData.append('attachments', files[i]);
      }
      formData.append('description', descriptionInput.value);
      formData.append('requestId', '{{requestId}}');
      
      try {
        const response = await fetch('/attachments/upload', {
          method: 'POST',
          body: formData
        });
        
        const result = await response.json();
        
        if (result.success) {
          showMessage('Files uploaded successfully!', 'success');
          // Reload page to show new attachments
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          showMessage(result.message || 'Upload failed', 'error');
        }
      } catch (error) {
        console.error('Upload error:', error);
        showMessage('Upload failed. Please try again.', 'error');
      }
    });

    // Delete attachment function
    async function deleteAttachment(attachmentId) {
      if (!confirm('Are you sure you want to delete this attachment?')) {
        return;
      }
      
      try {
        const response = await fetch(`/attachments/${attachmentId}/delete`, {
          method: 'DELETE'
        });
        
        const result = await response.json();
        
        if (result.success) {
          showMessage('Attachment deleted successfully!', 'success');
          // Reload page to update list
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          showMessage(result.message || 'Delete failed', 'error');
        }
      } catch (error) {
        console.error('Delete error:', error);
        showMessage('Delete failed. Please try again.', 'error');
      }
    }

    // Show message function
    function showMessage(message, type) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `fixed top-20 right-4 px-4 py-2 rounded-md text-white z-50 ${
        type === 'success' ? 'bg-green-600' : 'bg-red-600'
      }`;
      messageDiv.textContent = message;
      
      document.body.appendChild(messageDiv);
      
      setTimeout(() => {
        messageDiv.remove();
      }, 3000);
    }

    // File size validation
    document.getElementById('fileInput').addEventListener('change', function(e) {
      const files = e.target.files;
      const maxSize = 5 * 1024 * 1024; // 5MB
      
      for (let i = 0; i < files.length; i++) {
        if (files[i].size > maxSize) {
          alert(`File "${files[i].name}" is too large. Maximum size is 5MB.`);
          e.target.value = '';
          return;
        }
      }
    });
  </script>

</body>