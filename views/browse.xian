{{> head }}
<body class="min-h-screen bg-[#f3f6f2] text-[#202923] antialiased" style="background-image: linear-gradient(rgba(31, 83, 58, .035) 1px, transparent 1px), linear-gradient(90deg, rgba(31, 83, 58, .035) 1px, transparent 1px); background-size: 36px 36px;">
	<nav class="sticky top-0 z-50 border-b border-[#dce4dc] bg-white/95 backdrop-blur">
		<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-4">
			<a href="/" class="flex items-center gap-3 text-lg font-bold tracking-tight text-[#20372b]">
				<span class="flex h-9 w-9 items-center justify-center rounded-md bg-[#1f593e] text-sm font-bold text-white">S</span>
				SmartCivi
			</a>
			<div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium">
				{{#if user}}
					<a href="/dashboard" class="text-[#536158] transition hover:text-[#1f593e]">Dashboard</a>
					<a href="/dashboard/my-requests" class="text-[#536158] transition hover:text-[#1f593e]">My requests</a>
					<a href="/my-appointments" class="text-[#536158] transition hover:text-[#1f593e]">Appointments</a>
					<a href="/logout" class="rounded-md border border-[#dce4dc] px-3 py-2 text-[#38483d] transition hover:bg-[#f3f6f2]">Sign out</a>
				{{else}}
					<a href="/login" class="rounded-md bg-[#1f593e] px-4 py-2 text-white transition hover:bg-[#174630]">Sign in</a>
				{{/if}}
			</div>
		</div>
	</nav>

	<main class="mx-auto max-w-7xl px-5 pb-14 pt-9 sm:pt-12">
		<header class="mb-8 grid gap-7 border-b border-[#d5dfd6] pb-8 lg:grid-cols-[1fr_22rem] lg:items-end">
			<div>
				<p class="mb-3 text-xs font-bold uppercase tracking-[.16em] text-[#24724c]">Citizen services <span class="mx-2 text-[#c27a3a]">/</span> SmartCivi</p>
				<div class="flex flex-wrap items-end justify-between gap-4">
					<div>
						<h1 class="max-w-2xl text-3xl font-bold leading-tight tracking-tight text-[#202923] sm:text-4xl">What can we help you with?</h1>
						<p class="mt-3 max-w-xl text-sm leading-6 text-[#5d6a60]">Start an application, follow its progress, or find the right office.</p>
					</div>
					{{#if user}}
						<p class="rounded-md border border-[#d5dfd6] bg-white/80 px-3 py-2 text-sm text-[#536158]">Welcome, <span class="font-semibold text-[#243b2d]">{{user.name}}</span></p>
					{{/if}}
				</div>
			</div>
			<div>
				<label for="serviceSearch" class="mb-2 block text-xs font-semibold uppercase tracking-widest text-[#536158]">Find a service</label>
				<input id="serviceSearch" type="search" placeholder="Search services..." class="min-h-12 w-full rounded-md border border-[#cbd7cd] bg-white px-4 text-sm text-[#202923] shadow-sm outline-none transition placeholder:text-[#879289] focus:border-[#24724c] focus:ring-2 focus:ring-[#24724c]/20">
			</div>
		</header>

		<section aria-label="Available services">
			<div class="mb-4 flex items-center justify-between gap-4">
				<h2 class="text-sm font-semibold text-[#34473a]">Available services</h2>
				<p id="serviceCount" class="text-xs text-[#6b786e]" role="status" aria-live="polite">8 services</p>
			</div>
			<div id="serviceGrid" class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
				<a href="/request/submit" data-service="submit a request apply birth marriage death certificate document online application" class="service-card group relative flex min-h-56 flex-col justify-between overflow-hidden rounded-lg bg-[#1f593e] p-6 text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-[#194b34] hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f593e] md:col-span-2">
					<span class="absolute -right-8 -top-12 h-48 w-48 rounded-full border-[24px] border-white/5" aria-hidden="true"></span>
					<div class="relative flex items-start justify-between gap-4">
						<div>
							<span class="text-xs font-bold uppercase tracking-[.16em] text-[#cde5d4]">Apply online <span class="mx-2 text-[#e7a765]">/</span> 01</span>
							<h3 class="mt-6 text-2xl font-semibold tracking-tight">Submit a request</h3>
							<p class="mt-2 max-w-md text-sm leading-6 text-white/75">Apply for birth, marriage, death certificates, and other civil registry documents.</p>
						</div>
						<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#e9a15b] text-lg font-semibold text-[#24372b] transition-transform group-hover:translate-x-1" aria-hidden="true">&#8594;</span>
					</div>
					<span class="relative mt-5 text-sm font-semibold text-[#f4d3b0]">Begin application</span>
				</a>

				<a href="/status" data-service="check status track progress request application" class="service-card group flex min-h-56 flex-col justify-between rounded-lg border border-[#d8e1d9] bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#91b59b] hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f593e]">
					<div class="flex items-start justify-between gap-3"><span class="text-xs font-bold uppercase tracking-[.14em] text-[#24724c]">Track <span class="mx-1 text-[#c27a3a]">/</span> 02</span><span class="text-xl text-[#24724c]" aria-hidden="true">&#8599;</span></div>
					<div><h3 class="text-lg font-semibold text-[#202923]">Check request status</h3><p class="mt-2 text-sm leading-6 text-[#657168]">See the latest progress on an application.</p></div>
					<span class="text-sm font-semibold text-[#24724c]">Track a request <span aria-hidden="true">&#8594;</span></span>
				</a>

				<a href="/request" data-service="set appointment schedule in person document processing" class="service-card group flex min-h-48 flex-col justify-between rounded-lg border border-[#d8e1d9] bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#91b59b] hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f593e]">
					<div class="flex items-start justify-between gap-3"><span class="text-xs font-bold uppercase tracking-[.14em] text-[#24724c]">Plan a visit <span class="mx-1 text-[#c27a3a]">/</span> 03</span><span class="text-xl text-[#24724c]" aria-hidden="true">&#8599;</span></div>
					<div><h3 class="text-lg font-semibold text-[#202923]">Set an appointment</h3><p class="mt-2 text-sm leading-6 text-[#657168]">Schedule an in-person visit for document processing.</p></div>
					<span class="text-sm font-semibold text-[#24724c]">Choose a date <span aria-hidden="true">&#8594;</span></span>
				</a>

				<a href="/my-appointments" data-service="my appointments view manage scheduled appointments" class="service-card group flex min-h-48 flex-col justify-between rounded-lg border border-[#d8e1d9] bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#91b59b] hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f593e]">
					<div class="flex items-start justify-between gap-3"><span class="text-xs font-bold uppercase tracking-[.14em] text-[#24724c]">Your schedule <span class="mx-1 text-[#c27a3a]">/</span> 04</span><span class="text-xl text-[#24724c]" aria-hidden="true">&#8599;</span></div>
					<div><h3 class="text-lg font-semibold text-[#202923]">My appointments</h3><p class="mt-2 text-sm leading-6 text-[#657168]">View dates and updates from the office.</p></div>
					<span class="text-sm font-semibold text-[#24724c]">View appointments <span aria-hidden="true">&#8594;</span></span>
				</a>

				<a href="/records" data-service="my records view download civil documents" class="service-card group flex min-h-48 flex-col justify-between rounded-lg border border-[#d8e1d9] bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#91b59b] hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f593e]">
					<div class="flex items-start justify-between gap-3"><span class="text-xs font-bold uppercase tracking-[.14em] text-[#24724c]">Documents <span class="mx-1 text-[#c27a3a]">/</span> 05</span><span class="text-xl text-[#24724c]" aria-hidden="true">&#8599;</span></div>
					<div><h3 class="text-lg font-semibold text-[#202923]">My records</h3><p class="mt-2 text-sm leading-6 text-[#657168]">Access and download your available documents.</p></div>
					<span class="text-sm font-semibold text-[#24724c]">Browse records <span aria-hidden="true">&#8594;</span></span>
				</a>

				<a href="/payments" data-service="payments receipts pay payment history" class="service-card group flex min-h-48 flex-col justify-between rounded-lg border border-[#d8e1d9] bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#91b59b] hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f593e]">
					<div class="flex items-start justify-between gap-3"><span class="text-xs font-bold uppercase tracking-[.14em] text-[#24724c]">Account <span class="mx-1 text-[#c27a3a]">/</span> 06</span><span class="text-xl text-[#24724c]" aria-hidden="true">&#8599;</span></div>
					<div><h3 class="text-lg font-semibold text-[#202923]">Payments and receipts</h3><p class="mt-2 text-sm leading-6 text-[#657168]">Review payments and download receipts.</p></div>
					<span class="text-sm font-semibold text-[#24724c]">View payments <span aria-hidden="true">&#8594;</span></span>
				</a>

				<a href="/offices" data-service="local offices locations hours address" class="service-card group flex min-h-48 flex-col justify-between rounded-lg border border-[#d8e1d9] bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#91b59b] hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f593e]">
					<div class="flex items-start justify-between gap-3"><span class="text-xs font-bold uppercase tracking-[.14em] text-[#24724c]">In person <span class="mx-1 text-[#c27a3a]">/</span> 07</span><span class="text-xl text-[#24724c]" aria-hidden="true">&#8599;</span></div>
					<div><h3 class="text-lg font-semibold text-[#202923]">Local offices</h3><p class="mt-2 text-sm leading-6 text-[#657168]">Find office locations and operating hours.</p></div>
					<span class="text-sm font-semibold text-[#24724c]">Find an office <span aria-hidden="true">&#8594;</span></span>
				</a>

				<a href="/help" data-service="help support faq assistance" class="service-card group flex min-h-48 flex-col justify-between rounded-lg border border-[#d8e1d9] bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#91b59b] hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f593e]">
					<div class="flex items-start justify-between gap-3"><span class="text-xs font-bold uppercase tracking-[.14em] text-[#24724c]">Support <span class="mx-1 text-[#c27a3a]">/</span> 08</span><span class="text-xl text-[#24724c]" aria-hidden="true">&#8599;</span></div>
					<div><h3 class="text-lg font-semibold text-[#202923]">Help and support</h3><p class="mt-2 text-sm leading-6 text-[#657168]">Get help with services, requests, and appointments.</p></div>
					<span class="text-sm font-semibold text-[#24724c]">Get assistance <span aria-hidden="true">&#8594;</span></span>
				</a>
			</div>
			<p id="serviceEmpty" class="hidden rounded-lg border border-dashed border-[#cbd7cd] bg-white/70 px-5 py-10 text-center text-sm text-[#657168]">No services match that search.</p>
		</section>

		<footer class="mt-10 flex flex-col gap-2 border-t border-[#d5dfd6] pt-5 text-xs text-[#6b786e] sm:flex-row sm:items-center sm:justify-between">
			<span>SmartCivi Citizen Services</span>
			<a href="/help" class="font-semibold text-[#24724c] hover:text-[#174630]">Need assistance? Contact support <span aria-hidden="true">&#8594;</span></a>
		</footer>
	</main>

	<script>
		const serviceSearch = document.getElementById('serviceSearch');
		const serviceCards = Array.from(document.querySelectorAll('.service-card'));
		const serviceCount = document.getElementById('serviceCount');
		const serviceEmpty = document.getElementById('serviceEmpty');

		serviceSearch.addEventListener('input', () => {
			const query = serviceSearch.value.trim().toLowerCase();
			let visibleCount = 0;

			serviceCards.forEach((card) => {
				const matches = card.dataset.service.includes(query);
				card.hidden = !matches;
				if (matches) visibleCount++;
			});

			serviceCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'service' : 'services'}`;
			serviceEmpty.classList.toggle('hidden', visibleCount > 0);
		});
	</script>
</body>
</html>