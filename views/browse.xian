{{> head officeStyles=true}}<body class="office services-page">
{{#if user}}{{> staffNav}}{{else}}<header class="office-header"><div class="office-brand"><a class="brand-link" href="/">SmartCivi</a><a class="button" href="/login">Sign in</a></div></header>{{/if}}
<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>Citizen services</h1><p>Start a document request, track its progress, or arrange a visit to the registry office.</p></div></header>
<div class="service-toolbar"><label for="serviceSearch"><span>Find a service</span><input id="serviceSearch" type="search" placeholder="Search services" autocomplete="off"></label><span id="serviceCount" class="small muted" role="status" aria-live="polite">8 services</span></div>
<section id="serviceGrid" class="service-grid" aria-label="Available services"><a href="/request/submit" data-service="submit request apply birth marriage death certificate document online application" class="service-card"><span class="service-icon">{{> navIcon icon="requests"}}</span><h2>Submit a request</h2><p>Apply for a birth, marriage or death certificate.</p><span class="service-action">Begin application<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
<a href="/status" data-service="status track progress request application" class="service-card"><span class="service-icon">{{> navIcon icon="audit"}}</span><h2>Check request status</h2><p>See the latest progress on your application.</p><span class="service-action">Track a request<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
<a href="/appoint" data-service="set appointment schedule visit processing" class="service-card"><span class="service-icon">{{> navIcon icon="calendar"}}</span><h2>Set an appointment</h2><p>Schedule an office visit for document processing.</p><span class="service-action">Choose a date<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
<a href="/my-appointments" data-service="my appointments schedule" class="service-card"><span class="service-icon">{{> navIcon icon="calendar"}}</span><h2>My appointments</h2><p>Review your dates and updates from the office.</p><span class="service-action">View appointments<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
<a href="/records" data-service="my records view download documents" class="service-card"><span class="service-icon">{{> navIcon icon="record"}}</span><h2>My records</h2><p>View available document previews and records.</p><span class="service-action">Browse records<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
<a href="/payments" data-service="payments receipts history" class="service-card"><span class="service-icon">{{> navIcon icon="payment"}}</span><h2>Payments and receipts</h2><p>Review payment history and available payment records.</p><span class="service-action">View payments<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
<a href="/offices" data-service="local offices locations visit" class="service-card"><span class="service-icon">{{> navIcon icon="portal"}}</span><h2>Local offices</h2><p>Find office locations for in-person services.</p><span class="service-action">Find an office<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
<a href="/help" data-service="help support assistance" class="service-card"><span class="service-icon">{{> navIcon icon="help"}}</span><h2>Help and support</h2><p>Get guidance on requests, appointments and your account.</p><span class="service-action">Get guidance<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a></section>
<p id="serviceEmpty" class="empty panel" hidden>No services match that search. Try a certificate type or another service name.</p>
</main>{{> officeFooter}}
<script>
(() => { const input=document.getElementById('serviceSearch'),cards=[...document.querySelectorAll('.service-card')]; input.addEventListener('input',()=>{let count=0;const q=input.value.trim().toLowerCase();cards.forEach(card=>{card.hidden=!card.dataset.service.includes(q);if(!card.hidden)count++;});document.getElementById('serviceCount').textContent=count+' '+(count===1?'service':'services');document.getElementById('serviceEmpty').hidden=count>0;});})();
</script></body></html>
