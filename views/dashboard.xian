{{> head officeStyles=true}}
<body class="office">{{> staffNav}}
<main id="main" class="office-main">{{> officeFlash}}
  <header class="page-heading"><div><h1>Welcome{{#if user.name}}, {{user.name}}{{/if}}</h1><p>Manage your civil document requests, appointments and updates from the Bansud registry office.</p></div><a class="button secondary" href="/dashboard/my-requests">Track a request</a></header>
  <div class="citizen-workspace">
    <section class="request-spotlight" aria-labelledby="request-heading">
      <h2 id="request-heading">Request a civil document</h2>
      <p>Apply for a birth, marriage or death certificate. Your requests and processing history stay together in your account.</p>
      <div class="actions"><a class="button" href="/request/submit">Start a document request<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a><a class="spotlight-link" href="/appoint">Book an office appointment</a></div>
    </section>
    <section class="panel task-panel" aria-labelledby="tasks-heading"><h2 id="tasks-heading">Your services</h2>
      <div class="task-list">
        <a href="/dashboard/my-requests"><span><strong>My requests</strong><span>Track processing and view your request history.</span></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a>
        <a href="/my-appointments"><span><strong>Appointments</strong><span>Check your visit date or request a new schedule.</span></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a>
        <a href="/payments"><span><strong>Payments and records</strong><span>Review payment details and available records.</span></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a>
        <a href="/dashboard/notifications"><span><strong>Notifications</strong><span>Read updates about your requests and appointments.</span></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a>
      </div>
    </section>
    <section class="processing-guide" aria-labelledby="processing-heading"><h2 id="processing-heading">From request to release</h2><ol class="service-steps"><li><strong>Submit your details</strong><span>Choose a document and complete your request.</span></li><li><strong>The office reviews it</strong><span>Authorized personnel verify and process your information.</span></li><li><strong>Follow your progress</strong><span>Check My requests for status changes and release updates.</span></li></ol></section>
    <aside class="support-strip"><div><h2>Need help with your application?</h2><p>Find guidance on requirements, appointments and official document release.</p></div><a class="button secondary" href="/help">Help and office guidance</a></aside>
  </div>
</main>{{> officeFooter}}</body></html>
