{{> head}}
<body class="min-h-screen bg-[#f3f6f2] text-[#202923] antialiased" style="background-image: linear-gradient(rgba(31, 83, 58, .035) 1px, transparent 1px), linear-gradient(90deg, rgba(31, 83, 58, .035) 1px, transparent 1px); background-size: 36px 36px;">
  <nav class="border-b border-[#dce4dc] bg-white">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
      <a href="/" class="flex items-center gap-3 text-lg font-bold tracking-tight text-[#20372b]"><span class="flex h-9 w-9 items-center justify-center rounded-md bg-[#1f593e] text-sm text-white">S</span>SmartCivi</a>
      <a href="/browse" class="text-sm font-semibold text-[#24724c] hover:text-[#174630]">Explore services <span aria-hidden="true">&#8594;</span></a>
    </div>
  </nav>
  <main class="mx-auto max-w-6xl px-5 py-8 sm:py-12">
    <section class="mx-auto max-w-2xl rounded-lg border border-[#d8e1d9] bg-white p-7 shadow-sm sm:p-10">
      <p class="text-xs font-bold uppercase tracking-[.16em] text-[#24724c]">Account access</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-[#202923]">Password recovery</h1>
      <p class="mt-3 text-sm leading-6 text-[#657168]">Password recovery is not available yet. Return to sign in or contact support for help accessing your account.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/login" class="inline-flex min-h-11 items-center rounded-md bg-[#1f593e] px-4 py-2 text-sm font-semibold text-white hover:bg-[#174630]">Back to sign in</a>
        <a href="mailto:support@smartcivi.ph" class="inline-flex min-h-11 items-center rounded-md border border-[#cbd7cd] px-4 py-2 text-sm font-semibold text-[#24724c] hover:bg-[#f3f6f2]">Contact support</a>
      </div>
    </section>
  </main>
</body>
