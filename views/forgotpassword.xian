{{> head}}
<body class="auth-page">
  <main class="auth-layout">
    <section class="auth-story"><a class="brand auth-brand" href="/"><span class="brand-mark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.75h7.2L19 8.55v11.7H7a2 2 0 0 1-2-2v-12.5a2 2 0 0 1 2-2Z"/><path d="M14 4v5h5M9 13h6M9 16.5h6"/></svg></span><span class="brand-copy"><strong>DocuTrack</strong><small>CIVIL DOCUMENTS</small></span></a><div class="auth-story-content"><span class="auth-kicker">ACCOUNT SUPPORT</span><h1>Your records<br>stay protected.</h1><p>Password recovery is handled by the records office so identity can be verified before an account is changed.</p></div><span class="auth-copyright">© 2026 DocuTrack · Civil Document Processing and Tracking System</span></section>
    <section class="auth-main"><div class="auth-card"><span class="auth-kicker">PASSWORD ASSISTANCE</span><h2>Need help signing in?</h2><p class="auth-intro">Contact your DocuTrack administrator or records office to verify your identity and reset your staff password. Automated email recovery is not configured for this installation.</p><a class="button button-primary auth-submit auth-link-button" href="/login">Back to sign in</a><p class="auth-switch">Need to submit a request? <a href="/requests/new">Continue without signing in</a></p></div></section>
  </main>
{{> footer }}
