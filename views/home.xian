{{> head }}
<body class="overflow-x-hidden bg-[#f3f6f2] text-[#202923] antialiased">
  <nav class="sticky top-0 z-50 border-b border-[#dce4dc] bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-4">
      <a href="/" class="flex items-center gap-3 text-lg font-bold tracking-tight text-[#20372b]">
        <span class="flex h-9 w-9 items-center justify-center rounded-md bg-[#1f593e] text-sm font-bold text-white">S</span>
        SmartCivi
      </a>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium">
        <a href="/browse" class="text-[#536158] transition hover:text-[#1f593e]">Services</a>
        <a href="#about" class="text-[#536158] transition hover:text-[#1f593e]">About</a>
        <a href="#contact" class="text-[#536158] transition hover:text-[#1f593e]">Contact</a>
        <a href="/login" class="rounded-md bg-[#1f593e] px-4 py-2 text-white transition hover:bg-[#174630]">Sign in</a>
      </div>
    </div>
  </nav>

  <section class="relative flex min-h-[72vh] items-end overflow-hidden bg-[#173b2b] sm:min-h-[76vh]">
    <img src="https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=2000&q=85" alt="Documents being prepared for an official application" class="absolute inset-0 h-full w-full object-cover object-center">
    <div class="absolute inset-0 bg-[#102a1e]/65" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-5 pb-16 pt-20 sm:pb-20">
      <p class="mb-5 text-xs font-bold uppercase tracking-[.18em] text-[#e7b47f]">Municipal civil registry <span class="mx-2 text-white/50">/</span> SmartCivi</p>
      <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight text-white sm:text-6xl">Civil services, made clearer.</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-white/80 sm:text-lg">Submit document requests, follow their progress, and connect with your local registry office in one place.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/browse" class="inline-flex min-h-12 items-center rounded-md bg-[#e9a15b] px-5 py-3 text-sm font-bold text-[#20372b] transition hover:bg-[#f0b87f]">Explore services <span class="ml-3" aria-hidden="true">&#8594;</span></a>
        <a href="/login" class="inline-flex min-h-12 items-center rounded-md border border-white/50 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">Sign in to your account</a>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="relative overflow-hidden bg-white px-4 py-20">
    <div class="container relative z-10 mx-auto max-w-4xl text-center">
      <p class="mb-4 text-xs font-bold uppercase tracking-[.16em] text-[#24724c]">About SmartCivi</p>
      <h2 class="mb-6 text-3xl font-bold tracking-tight text-[#202923] sm:text-4xl">A simpler way to access civil registry services.</h2>
      <p class="text-base leading-7 text-[#5d6a60] sm:text-lg">
        SmartCivi is a cutting-edge digital civil registry platform designed to revolutionize how municipalities manage and process citizen records such as birth, marriage, and death certificates. Our system combines efficiency, security, and user-friendly design to provide seamless access to essential civil services for both residents and municipal officers.
      </p>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="border-y border-[#dce4dc] bg-[#f3f6f2] px-4 py-20">
    <div class="container mx-auto">
      <div class="text-center mb-16">
        <p class="mb-3 text-xs font-bold uppercase tracking-[.16em] text-[#24724c]">One connected portal</p>
        <h2 class="mb-3 text-3xl font-bold tracking-tight text-[#202923] sm:text-4xl">From application to update</h2>
        <p class="mx-auto max-w-2xl text-base text-[#5d6a60]">Keep the essential steps of a civil registry request in one clear place.</p>
      </div>

      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-4 md:grid-cols-3">
        <!-- Feature 1 -->
        <div class="feature-card group rounded-lg border border-[#d8e1d9] bg-white p-7 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
          <div class="mb-6 flex h-11 w-11 items-center justify-center rounded-md bg-[#e7f1e8] text-[#24724c]">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-[#202923]">Online requests</h3>
          <p class="text-sm leading-6 text-[#657168]">Submit a document application and provide the details needed for processing.</p>
        </div>

        <!-- Feature 2 -->
        <div class="feature-card group rounded-lg border border-[#d8e1d9] bg-white p-7 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md" style="animation-delay: 0.1s">
          <div class="mb-6 flex h-11 w-11 items-center justify-center rounded-md bg-[#fff0df] text-[#a85e24]">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-[#202923]">Request tracking</h3>
          <p class="text-sm leading-6 text-[#657168]">Check request status and review updates without returning to the office.</p>
        </div>

        <!-- Feature 3 -->
        <div class="feature-card group rounded-lg border border-[#d8e1d9] bg-white p-7 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md" style="animation-delay: 0.2s">
          <div class="mb-6 flex h-11 w-11 items-center justify-center rounded-md bg-[#e7f1e8] text-[#24724c]">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-[#202923]">Office coordination</h3>
          <p class="text-sm leading-6 text-[#657168]">Registry staff can review applications and manage citizen service workflows.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="border-y border-white/10 bg-[#1f593e] px-4 py-16">
    <div class="container mx-auto">
      <div class="grid grid-cols-1 gap-8 text-center text-white md:grid-cols-3">
        <div class="counter-card">
          <div class="mb-2 text-4xl font-bold tracking-tight">24/7</div>
          <div class="text-sm text-white/70">Service availability</div>
        </div>
        <div class="counter-card" style="animation-delay: 0.1s">
          <div class="mb-2 text-4xl font-bold tracking-tight">100%</div>
          <div class="text-sm text-white/70">Digital processing</div>
        </div>
        <div class="counter-card" style="animation-delay: 0.2s">
          <div class="mb-2 text-4xl font-bold tracking-tight text-[#f0b87f]">Fast</div>
          <div class="text-sm text-white/70">Document delivery</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="bg-white px-4 py-20">
    <div class="container mx-auto max-w-3xl text-center">
      <p class="mb-3 text-xs font-bold uppercase tracking-[.16em] text-[#24724c]">Get in touch</p>
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-[#202923] sm:text-4xl">Questions about a service?</h2>
      <p class="mb-7 text-base text-[#5d6a60]">Contact the SmartCivi support team for help with requests, records, or appointments.</p>
      <a href="mailto:support@smartcivi.ph" class="inline-flex min-h-12 items-center gap-2 rounded-md bg-[#1f593e] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#174630]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        Email Support
      </a>
    </div>
  </section>



  <style>
    /* Animations */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in-up {
      animation: fadeInUp 0.8s ease-out forwards;
    }

    .feature-card {
      animation: fadeInUp 0.6s ease-out forwards;
      opacity: 0;
    }

    .feature-card:nth-child(1) { animation-delay: 0s; }
    .feature-card:nth-child(2) { animation-delay: 0.1s; }
    .feature-card:nth-child(3) { animation-delay: 0.2s; }

    .counter-card {
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
    }

    /* Scroll animations */
    .fade-in-on-scroll {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }

    .fade-in-on-scroll.visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>

  <script>
    // Scroll animation observer
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.fade-in-on-scroll').forEach(el => observer.observe(el));
  </script>
</body>
</html>