{{> head }}
<body class="bg-gradient-to-br from-pink-300 via-purple-300 to-blue-400 min-h-screen flex items-center justify-center">

  

  <form 
    class="bg-white bg-opacity-80 backdrop-blur-lg w-96 p-8 rounded-xl shadow-lg border border-gray-200"
    method="POST" 
    action="/login"
  >
    <h2 class="text-3xl font-extrabold text-center mb-6 text-blue-700 drop-shadow">SmartCivi Login</h2>
    
    <input 
      type="email" 
      name="email" 
      placeholder="Email" 
      class="mb-4 w-full p-3 rounded-md border border-gray-300 focus:ring-2 focus:ring-blue-400 outline-none"
      required 
    />
    
    <input 
      type="password" 
      name="password" 
      placeholder="Password" 
      class="mb-4 w-full p-3 rounded-md border border-gray-300 focus:ring-2 focus:ring-blue-400 outline-none"
      required 
    />
    
    <button 
      type="submit" 
      class="w-full bg-gradient-to-r from-blue-500 to-pink-500 text-white py-3 rounded-md font-semibold hover:opacity-90 transition-all"
    >
      Log In
    </button>

    <a href="/register" class="block text-center text-blue-700 mt-4 hover:underline">
      Don't have an account? Register
    </a>
  </form>



