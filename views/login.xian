{{> head }}
<body class="min-h-screen bg-[#f3f6f2] text-[#202923] antialiased" style="background-image: linear-gradient(rgba(31, 83, 58, .035) 1px, transparent 1px), linear-gradient(90deg, rgba(31, 83, 58, .035) 1px, transparent 1px); background-size: 36px 36px;">
  <nav class="border-b border-[#dce4dc] bg-white">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
      <a href="/" class="flex items-center gap-3 text-lg font-bold tracking-tight text-[#20372b]"><span class="flex h-9 w-9 items-center justify-center rounded-md bg-[#1f593e] text-sm text-white">S</span>SmartCivi</a>
      <a href="/browse" class="text-sm font-semibold text-[#24724c] hover:text-[#174630]">Explore services <span aria-hidden="true">&#8594;</span></a>
    </div>
  </nav>

  <main class="mx-auto grid max-w-6xl gap-6 px-5 py-8 sm:py-12 lg:grid-cols-[.9fr_1.1fr] lg:items-stretch">
    <section class="flex min-h-64 flex-col justify-between rounded-lg bg-[#1f593e] p-7 text-white sm:p-9">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.16em] text-[#e7b47f]">Citizen portal</p>
        <h1 class="mt-8 max-w-md text-3xl font-bold leading-tight tracking-tight sm:text-4xl">Your civil services, in one place.</h1>
        <p class="mt-4 max-w-md text-sm leading-6 text-white/75">Sign in to submit or track document requests, manage appointments, and view service updates.</p>
      </div>
      <p class="mt-10 border-t border-white/20 pt-4 text-xs font-medium uppercase tracking-widest text-white/60">SmartCivi <span class="mx-2 text-[#e7b47f]">/</span> Municipal Civil Registry</p>
    </section>

    <form class="rounded-lg border border-[#d8e1d9] bg-white p-6 shadow-sm sm:p-9" method="POST" action="/login">
      <p class="text-xs font-bold uppercase tracking-[.16em] text-[#24724c]">Welcome back</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-[#202923]">Sign in to SmartCivi</h2>
      <p class="mt-2 text-sm text-[#657168]">Use the email address linked to your account.</p>

      {{#if error_msg}}
        <div role="alert" class="mt-5 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{error_msg}}</div>
      {{/if}}

      <div class="mt-7 space-y-5">
        <div>
          <label for="email" class="mb-2 block text-sm font-semibold text-[#34473a]">Email address</label>
          <input id="email" type="email" name="email" autocomplete="email" required class="min-h-12 w-full rounded-md border border-[#cbd7cd] bg-white px-3 text-sm outline-none transition placeholder:text-[#879289] focus:border-[#24724c] focus:ring-2 focus:ring-[#24724c]/20">
        </div>
        <div>
          <div class="mb-2 flex items-center justify-between gap-3">
            <label for="password" class="block text-sm font-semibold text-[#34473a]">Password</label>
            <a href="/forgot-password" class="text-xs font-semibold text-[#24724c] hover:text-[#174630]">Forgot password?</a>
          </div>
          <input id="password" type="password" name="password" autocomplete="current-password" required class="min-h-12 w-full rounded-md border border-[#cbd7cd] bg-white px-3 text-sm outline-none transition focus:border-[#24724c] focus:ring-2 focus:ring-[#24724c]/20">
        </div>
        <button type="submit" class="min-h-12 w-full rounded-md bg-[#1f593e] px-4 py-3 text-sm font-bold text-white transition hover:bg-[#174630] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f593e]">Sign in</button>
      </div>

      <p class="mt-6 border-t border-[#e5ebe5] pt-5 text-center text-sm text-[#657168]">New to SmartCivi? <a href="/register" class="font-semibold text-[#24724c] hover:text-[#174630]">Create an account</a></p>
    </form>
  </main>



