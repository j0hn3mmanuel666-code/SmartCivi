{{> head }}
<body class="min-h-screen bg-zinc-50 text-zinc-900 antialiased">
  {{> sidebar}}
  <header class="mx-auto max-w-7xl px-5 pb-7 pt-10 sm:pt-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-emerald-800">Citizen portal</p>
    <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-zinc-950">My requests</h1>
        <p class="mt-2 text-sm text-zinc-600">Follow the status of your civil service reports.</p>
      </div>
      <a href="/request/submit" class="rounded-md bg-emerald-800 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-900">Submit a request</a>
    </div>
  </header>
  <main class="mx-auto max-w-7xl px-5 pb-12">
    <section class="rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
      {{#if requests}}
        <div class="divide-y divide-zinc-100">
          {{#each requests}}
            <article class="flex flex-col gap-3 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="font-semibold capitalize text-zinc-900">{{this.documentType}} request</h2>
                <p class="mt-1 text-sm text-zinc-600">Request #{{this.id}} · Submitted {{this.createdAt}}</p>
              </div>
              <div class="flex items-center gap-4">
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800">{{this.status}}</span>
                <a href="/request/{{this.id}}" class="text-sm font-semibold text-emerald-800 hover:text-emerald-900">View details</a>
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="py-10 text-center">
          <h2 class="text-lg font-semibold">No requests yet</h2>
          <p class="mt-2 text-sm text-zinc-600">Submitted requests and their latest updates will appear here.</p>
          <a href="/request/submit" class="mt-5 inline-flex rounded-md bg-emerald-800 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-900">Start a request</a>
        </div>
      {{/if}}
    </section>
  </main>
</body>
</html>
