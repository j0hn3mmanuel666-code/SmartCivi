{{> head }}
<body class="office legacy-workspace bg-gradient-to-br from-pink-300 via-purple-300 to-blue-400 text-gray-800 min-h-screen">

  {{#if user}}{{> staffNav}}{{else}}<header class="office-header"><div class="office-brand"><a class="brand-link" href="/">SmartCivi</a><a class="button" href="/login">Sign in</a></div></header>{{/if}}

  <section class="flex flex-col justify-center items-center text-center h-44 px-6 pt-24">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white drop-shadow-md">Local Office Info</h1>
    <p class="text-md md:text-lg text-white mt-3 max-w-2xl">Find branch locations and office hours for in-person services.</p>
    <div class="mt-3">
      <a href="/browse" class="text-sm text-white underline">← Back to Services</a>
    </div>
  </section>

  <main id="main" class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <section class="lg:col-span-2 bg-white bg-opacity-90 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">PSA Offices — Oriental Mindoro</h2>
        <p class="text-sm text-gray-600 mb-4">Below are nearby PSA offices and satellite locations. Please verify office hours with the PSA before visiting.</p>

        <div class="space-y-4">
          {{#each offices}}
            <div class="border rounded p-4 bg-gray-50">
              <div class="font-semibold text-gray-800">{{this.name}}</div>
              <div class="text-sm text-gray-600">{{this.address}}</div>
              {{#if this.phone}}<div class="text-sm text-gray-600">Phone: {{this.phone}}</div>{{/if}}
            </div>
          {{/each}}
        </div>
      </section>

      <aside class="bg-white bg-opacity-90 rounded-lg shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-3">Map</h3>
        <div class="w-full h-64 bg-gray-200 rounded overflow-hidden">
          <iframe class="w-full h-full" frameborder="0" src="https://maps.google.com/maps?q=psa%20office%20oriental%20mindoro&t=&z=9&ie=UTF8&iwloc=&output=embed"></iframe>
        </div>
        <p class="text-xs text-gray-600 mt-3">Map is an embedded Google Maps search for PSA offices in Oriental Mindoro. Use it to get directions or click a marker to see details.</p>
      </aside>
    </div>
  </main>



</body>
