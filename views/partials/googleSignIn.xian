{{#if googleReady}}
<form method="post" action="/auth/google" class="auth-google-form">
  <button type="submit" class="auth-google"><svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M43.61 24.46c0-1.36-.12-2.66-.35-3.92H24v7.42h11a9.4 9.4 0 0 1-4.08 6.18v5.14h6.61c3.87-3.56 6.08-8.81 6.08-14.82Z"/><path fill="#34A853" d="M24 44c5.51 0 10.13-1.83 13.51-4.95l-6.61-5.14c-1.83 1.23-4.18 1.97-6.9 1.97-5.32 0-9.85-3.59-11.47-8.42H5.7v5.3A20 20 0 0 0 24 44Z"/><path fill="#FBBC05" d="M12.53 27.46a12 12 0 0 1 0-6.92v-5.3H5.7a20 20 0 0 0 0 17.52l6.83-5.3Z"/><path fill="#EA4335" d="M24 12.12c3 0 5.68 1.03 7.8 3.04l5.85-5.85A19.65 19.65 0 0 0 24 4 20 20 0 0 0 5.7 15.24l6.83 5.3c1.62-4.83 6.15-8.42 11.47-8.42Z"/></svg>Continue with Google</button>
</form>
<div class="auth-divider"><span>or use your email</span></div>
{{else}}
<button type="button" class="auth-google" disabled>Continue with Google</button>
<p class="auth-provider-note">Google sign-in will be available soon.</p>
<div class="auth-divider"><span>use your email</span></div>
{{/if}}
