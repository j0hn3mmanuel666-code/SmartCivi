<div class="w-64 bg-blue-900 text-white h-screen fixed left-0 top-0 overflow-y-auto pt-20">
    <nav class="px-4 py-6">
        <div class="mb-8">
            <h2 class="text-lg font-bold text-white">Navigation</h2>
        </div>

        <ul class="space-y-2">
            <li>
                <a href="/dashboard" class="block px-4 py-2 rounded hover:bg-blue-800">
                    📊 Dashboard
                </a>
            </li>
            <li>
                <a href="/profile" class="block px-4 py-2 rounded hover:bg-blue-800">
                    👤 My Profile
                </a>
            </li>

            <!-- RIMS Module -->
            <li class="pt-4 border-t border-blue-700">
                <span class="text-xs uppercase text-blue-300 font-semibold px-4 py-2">Resident Management</span>
            </li>
            <li>
                <a href="/residents" class="block px-4 py-2 rounded hover:bg-blue-800">
                    👥 Residents
                </a>
            </li>
            <li>
                <a href="/barangays" class="block px-4 py-2 rounded hover:bg-blue-800">
                    🗺️ Barangays
                </a>
            </li>
            <li>
                <a href="/reports/residents" class="block px-4 py-2 rounded hover:bg-blue-800">
                    📊 Reports
                </a>
            </li>
            <li>
                <a href="/resident-activities" class="block px-4 py-2 rounded hover:bg-blue-800">
                    📝 Activity Log
                </a>
            </li>

            {{#eq role 'Administrator'}}
            <li class="pt-4 border-t border-blue-700">
                <span class="text-xs uppercase text-blue-300 font-semibold px-4 py-2">Admin</span>
            </li>
            <li>
                <a href="/users" class="block px-4 py-2 rounded hover:bg-blue-800">
                    👥 User Management
                </a>
            </li>
            <li>
                <a href="/audit-logs" class="block px-4 py-2 rounded hover:bg-blue-800">
                    📋 Audit Logs
                </a>
            </li>
            {{/eq}}
        </ul>
    </nav>
</div>
