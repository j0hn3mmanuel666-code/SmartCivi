{{> head }}
<body class="office legacy-workspace bg-gradient-to-br from-pink-300 via-purple-300 to-blue-400 text-gray-800 min-h-screen">

  {{> staffNav}}

  <section class="flex flex-col justify-center items-center text-center h-44 px-6 pt-24">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white drop-shadow-md">Payment</h1>
    <p class="text-md md:text-lg text-white mt-3 max-w-2xl">Complete your payment to process your civil registry request.</p>
    <div class="mt-3">
      <a href="/request/{{requestId}}" class="text-sm text-white underline">← Back to Request Details</a>
    </div>
  </section>

  <main id="main" class="container mx-auto px-4 py-8">
    <p class="notice mx-auto max-w-4xl" role="note">Payment demonstration: online payment is simulated. No payment gateway is connected and no funds are transferred. Confirm current fees and payment instructions with the Bansud LGU office.</p>
    <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6 max-w-4xl mx-auto">
      
      {{#if request}}
        <!-- Payment Summary -->
        <div class="border-b border-gray-200 pb-6 mb-6">
          <h2 class="text-2xl font-bold text-gray-800 mb-4">Payment Summary</h2>
          <div class="bg-gray-50 rounded-lg p-4">
            <div class="flex justify-between items-center mb-2">
              <span class="text-gray-600">Document Type:</span>
              <span class="font-medium capitalize">{{request.documentType}} Certificate</span>
            </div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-gray-600">Applicant:</span>
              <span class="font-medium">{{request.fullName}}</span>
            </div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-gray-600">Request ID:</span>
              <span class="font-medium">#{{request.id}}</span>
            </div>
            <div class="border-t pt-2 mt-4">
              <div class="flex justify-between items-center text-lg font-bold">
                <span>Total Amount:</span>
                <span class="text-green-600">₱{{paymentAmount}}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Payment Methods -->
        <div class="mb-8">
          <h3 class="text-xl font-semibold text-gray-800 mb-4">Choose Payment Method</h3>
          
          <form id="paymentForm" action="/request/{{request.id}}/process-payment" method="POST">
            <div class="space-y-4">
              
              <!-- Online Payment -->
              <div class="border rounded-lg p-4 hover:bg-gray-50 cursor-pointer payment-option" data-method="online">
                <label class="flex items-center cursor-pointer">
                  <input type="radio" name="paymentMethod" value="online" class="mr-3" required>
                  <div class="flex-1">
                    <div class="font-medium text-gray-800">Online Payment</div>
                    <div class="text-sm text-gray-600">Pay securely using GCash, PayMaya, or Credit/Debit Card</div>
                  </div>
                  <div class="text-right">
                    <div class="text-sm text-green-600 font-medium">Available Now</div>
                  </div>
                </label>
              </div>

              <!-- Over-the-Counter Payment -->
              <div class="border rounded-lg p-4 hover:bg-gray-50 cursor-pointer payment-option" data-method="otc">
                <label class="flex items-center cursor-pointer">
                  <input type="radio" name="paymentMethod" value="otc" class="mr-3" required>
                  <div class="flex-1">
                    <div class="font-medium text-gray-800">Over-the-Counter Payment</div>
                    <div class="text-sm text-gray-600">Pay at any 7-Eleven, Bayad Center, or SM Bills Payment</div>
                  </div>
                  <div class="text-right">
                    <div class="text-sm text-blue-600 font-medium">Generate Reference</div>
                  </div>
                </label>
              </div>

              <!-- Bank Transfer -->
              <div class="border rounded-lg p-4 hover:bg-gray-50 cursor-pointer payment-option" data-method="bank">
                <label class="flex items-center cursor-pointer">
                  <input type="radio" name="paymentMethod" value="bank" class="mr-3" required>
                  <div class="flex-1">
                    <div class="font-medium text-gray-800">Bank Transfer</div>
                    <div class="text-sm text-gray-600">Transfer to our official bank account</div>
                  </div>
                  <div class="text-right">
                    <div class="text-sm text-purple-600 font-medium">Get Bank Details</div>
                  </div>
                </label>
              </div>

            </div>

            <!-- Payment Details Section (Hidden by default) -->
            <div id="paymentDetails" class="mt-6 hidden">
              
              <!-- Online Payment Details -->
              <div id="onlineDetails" class="payment-details hidden">
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                  <h4 class="font-medium text-green-800 mb-2">Online Payment</h4>
                  <p class="text-sm text-green-700 mb-4">You will be redirected to our secure payment gateway to complete your transaction.</p>
                  <div class="flex space-x-2">
                    <img src="https://via.placeholder.com/60x30/00D632/FFFFFF?text=GCash" alt="GCash" class="rounded">
                    <img src="https://via.placeholder.com/60x30/00A8E6/FFFFFF?text=PayMaya" alt="PayMaya" class="rounded">
                    <img src="https://via.placeholder.com/60x30/1565C0/FFFFFF?text=Visa" alt="Visa" class="rounded">
                    <img src="https://via.placeholder.com/60x30/EB001B/FFFFFF?text=MC" alt="Mastercard" class="rounded">
                  </div>
                </div>
              </div>

              <!-- OTC Payment Details -->
              <div id="otcDetails" class="payment-details hidden">
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                  <h4 class="font-medium text-blue-800 mb-2">Over-the-Counter Payment</h4>
                  <p class="text-sm text-blue-700 mb-3">A payment reference number will be generated for you to use at any of these locations:</p>
                  <ul class="text-sm text-blue-700 space-y-1">
                    <li>• 7-Eleven stores nationwide</li>
                    <li>• Bayad Center outlets</li>
                    <li>• SM Bills Payment counters</li>
                    <li>• Cebuana Lhuillier branches</li>
                  </ul>
                </div>
              </div>

              <!-- Bank Transfer Details -->
              <div id="bankDetails" class="payment-details hidden">
                <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
                  <h4 class="font-medium text-purple-800 mb-2">Bank Transfer Details</h4>
                  <div class="text-sm text-purple-700 space-y-2">
                    <div><strong>Bank:</strong> Philippine National Bank (PNB)</div>
                    <div><strong>Account Name:</strong> SmartCivi Payment Services</div>
                    <div><strong>Account Number:</strong> 1234-5678-9012-3456</div>
                    <div><strong>Reference:</strong> REQ-{{request.id}}</div>
                  </div>
                  <p class="text-xs text-purple-600 mt-3">Please include the reference number in your transfer details.</p>
                </div>
              </div>

            </div>

            <!-- Submit Button -->
            <div class="mt-8 flex flex-col sm:flex-row gap-4">
              <a href="/request/{{request.id}}" class="bg-gray-600 text-white px-6 py-3 rounded-md hover:bg-gray-700 transition-all text-center">
                Back to Request
              </a>
              <button type="submit" id="proceedPayment" class="bg-green-600 text-white px-6 py-3 rounded-md hover:bg-green-700 transition-all disabled:bg-gray-400 disabled:cursor-not-allowed" disabled>
                Proceed with Payment
              </button>
            </div>

          </form>
        </div>

      {{else}}
        <!-- Request Not Found -->
        <div class="text-center py-12">
          <div class="text-6xl text-gray-300 mb-4">💳</div>
          <h2 class="text-2xl font-bold text-gray-800 mb-2">Payment Not Available</h2>
          <p class="text-gray-600 mb-6">The request you're trying to pay for doesn't exist or is not ready for payment.</p>
          <a href="/status" class="bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 transition-all">
            Back to Status
          </a>
        </div>
      {{/if}}

    </div>
  </main>



  <script>
    // Payment method selection
    document.querySelectorAll('input[name="paymentMethod"]').forEach(radio => {
      radio.addEventListener('change', function() {
        const method = this.value;
        const detailsContainer = document.getElementById('paymentDetails');
        const proceedButton = document.getElementById('proceedPayment');
        
        // Hide all payment details
        document.querySelectorAll('.payment-details').forEach(detail => {
          detail.classList.add('hidden');
        });
        
        // Show selected payment details
        document.getElementById(method + 'Details').classList.remove('hidden');
        detailsContainer.classList.remove('hidden');
        
        // Enable proceed button
        proceedButton.disabled = false;
      });
    });

    // Form submission
    document.getElementById('paymentForm').addEventListener('submit', function(e) {
      const selectedMethod = document.querySelector('input[name="paymentMethod"]:checked');
      if (!selectedMethod) {
        e.preventDefault();
        alert('Please select a payment method');
        return;
      }
      
      // Show loading state
      const button = document.getElementById('proceedPayment');
      button.textContent = 'Processing...';
      button.disabled = true;
    });
  </script>

</body>
