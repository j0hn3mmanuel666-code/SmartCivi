{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}<header class="page-heading"><div><h1>{{title}}</h1><p>{{#if archived}}Restore this archived item before editing.{{else}}Enter amounts in Philippine pesos with up to two decimal places. Spending above allocation is reported as over budget.{{/if}}</p></div><a class="button secondary" href="{{base}}">Back to budget</a></header>
<section class="panel"><form method="post" action="{{action}}" data-save><fieldset {{#if archived}}disabled{{/if}} style="border:0;margin:0;padding:0"><legend>Budget item details</legend><div class="form-grid"><label>Department *<input name="department" value="{{value.department}}" maxlength="150" required></label><label>Budget item *<input name="item" value="{{value.item}}" maxlength="255" required></label><label>Fiscal year *<input name="fiscalYear" type="number" min="1900" max="9999" step="1" value="{{value.fiscalYear}}" required></label><label>Allocated budget (PHP) *<input name="allocated" type="text" inputmode="decimal" pattern="[0-9]{1,13}(\.[0-9]{1,2})?" value="{{value.allocated}}" required></label><label>Spent amount (PHP) *<input name="spent" type="text" inputmode="decimal" pattern="[0-9]{1,13}(\.[0-9]{1,2})?" value="{{value.spent}}" required></label></div><div class="actions"><button class="button">Save budget item</button><a class="button secondary" href="{{base}}">Cancel</a></div></fieldset></form></section>
{{#if existing}}<form method="post" action="{{action}}/archive" data-confirm="{{#if archived}}Restore this budget item?{{else}}Archive this budget item? It will be excluded from active reports; history will be retained.{{/if}}"><button class="button danger">{{#if archived}}Restore budget item{{else}}Archive budget item{{/if}}</button></form>{{/if}}</main>{{> officeFooter}}</body></html>
