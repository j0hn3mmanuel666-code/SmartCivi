{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>{{title}}</h1><p>Employee records share the resource assignment history. Archive records to retain their history.</p></div><a class="button no-print" href="{{base}}/new">Add employee</a></header>
<section class="panel"><form method="get" action="{{base}}" class="toolbar"><label>Search<input name="q" value="{{q}}" maxlength="100" placeholder="Name, employee code, position, department or contact"></label><label class="check"><input type="checkbox" name="archived" value="1" {{#if archived}}checked{{/if}}>Archived only</label><button class="button">Search</button><a class="button secondary" href="{{csvUrl}}">Export CSV</a><a class="button secondary" href="{{printUrl}}">Print view</a>{{#if print}}<button class="button secondary" type="button" data-print>Print</button>{{/if}}</form><p>{{count}} matching employees{{#if archived}} · Archived records{{/if}}</p>
<div class="table-wrap"><table class="office-table"><thead><tr>{{#each columns}}<th scope="col">{{this}}</th>{{/each}}<th scope="col" class="no-print">Actions</th></tr></thead><tbody>{{#each rows}}<tr>{{#each cells}}<td>{{this}}</td>{{/each}}<td class="no-print"><a href="{{../base}}/{{id}}">Open</a></td></tr>{{else}}<tr><td colspan="8">No matching employees. Adjust the search or add an employee.</td></tr>{{/each}}</tbody></table></div>
{{#unless print}}<div class="pagination"><span>Page {{page}} of {{pages}} · 25 per page</span><div>{{#if previous}}<a class="button secondary" href="{{previous}}">Previous</a>{{/if}}{{#if next}}<a class="button secondary" href="{{next}}">Next</a>{{/if}}</div></div>{{/unless}}</section></main>{{> officeFooter}}</body></html>
