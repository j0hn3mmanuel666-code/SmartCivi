{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}<header class="page-heading"><div><h1>{{title}}</h1><p>{{#if archived}}Restore this employee before editing.{{else}}Employee codes are assigned automatically. Employees on leave or inactive cannot receive assignments.{{/if}}</p></div><a class="button secondary" href="{{base}}">Back to personnel</a></header>
<section class="panel"><form method="post" action="{{action}}" data-save><fieldset {{#if archived}}disabled{{/if}} style="border:0;margin:0;padding:0"><legend>Employee details</legend><div class="form-grid">{{#if existing}}<label>Employee code<input value="{{value.code}}" readonly></label>{{/if}}<label>Full name *<input name="fullName" value="{{value.name}}" maxlength="255" required></label><label>Position *<input name="position" value="{{value.position}}" maxlength="150" required></label><label>Department *<input name="department" value="{{value.department}}" maxlength="150" required></label><label>Contact number{{#unless existing}} *{{/unless}}<input name="contactNumber" type="tel" value="{{value.contactNumber}}" maxlength="40" {{#unless existing}}required{{/unless}}></label><label>Employment status *<select name="employeeStatus" required><option value="active" {{#ifEq value.employeeStatus 'active'}}selected{{/ifEq}}>Active</option><option value="on_leave" {{#ifEq value.employeeStatus 'on_leave'}}selected{{/ifEq}}>On leave</option><option value="inactive" {{#ifEq value.employeeStatus 'inactive'}}selected{{/ifEq}}>Inactive</option></select></label></div><div class="actions"><button class="button">Save employee</button><a class="button secondary" href="{{base}}">Cancel</a></div></fieldset></form></section>
{{#if existing}}<div class="actions"><a class="button secondary" href="/admin/resources/{{value.id}}">Assignment and movement history</a><form method="post" action="{{action}}/archive" data-confirm="{{#if archived}}Restore this employee?{{else}}Archive this employee? Outstanding assignments must be returned first. History will be retained.{{/if}}"><button class="button danger">{{#if archived}}Restore employee{{else}}Archive employee{{/if}}</button></form></div>{{/if}}</main>{{> officeFooter}}</body></html>
