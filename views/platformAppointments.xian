{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}<header class="page-heading"><div><h1>{{title}}</h1><p>{{count}} scheduled appointments. Times are shown in Philippine time. Appointment and document processing statuses are tracked separately.</p></div>{{#unless staffView}}<a class="button" href="/appoint">Book appointment</a>{{/unless}}</header>
{{#each appointments}}<section class="panel"><h2>Request #{{id}} · {{documentType}} certificate</h2><p><strong>{{when}}</strong> · <span class="badge">{{appointmentStatus}}</span></p><p>{{fullName}} · {{email}}</p>{{#if notes}}<p>{{notes}}</p>{{/if}}{{#if rescheduleRequested}}<p class="notice">Reschedule requested: {{rescheduleReason}}</p>{{/if}}
{{#if ../staffView}}<form method="post" action="/admin/appointments/{{id}}/status"><div class="form-grid"><label><span>Appointment status</span><select name="status"><option value="scheduled" {{#ifEq appointmentStatus 'scheduled'}}selected{{/ifEq}}>Scheduled</option><option value="confirmed" {{#ifEq appointmentStatus 'confirmed'}}selected{{/ifEq}}>Confirmed</option><option value="rescheduled" {{#ifEq appointmentStatus 'rescheduled'}}selected{{/ifEq}}>Rescheduled</option><option value="completed" {{#ifEq appointmentStatus 'completed'}}selected{{/ifEq}}>Completed</option><option value="cancelled" {{#ifEq appointmentStatus 'cancelled'}}selected{{/ifEq}}>Cancelled</option></select></label><label><span>Appointment date and time</span><input type="datetime-local" name="appointmentDate" value="{{dateValue}}" required></label><label class="wide"><span>Notes visible to client</span><textarea name="notes" maxlength="3000">{{notes}}</textarea></label></div><div class="actions"><button class="button" type="submit">Update appointment</button><a class="button secondary" href="/admin/requests/{{id}}">Review request</a></div></form>
{{else}}<details><summary>Request a different date</summary><form method="post" action="/appointments/{{id}}/reschedule"><label><span>Reason / preferred schedule *</span><textarea name="rescheduleReason" maxlength="1000" required></textarea></label><div class="actions"><button class="button" type="submit">Send reschedule request</button><a class="button secondary" href="/request/{{id}}">View request</a></div></form></details>{{/if}}</section>
{{else}}<section class="panel empty"><h2>No appointments yet</h2><p>Scheduled appointments will appear here.</p></section>{{/each}}
<div class="pagination">{{#if previous}}<a class="button secondary" href="{{previous}}">Previous</a>{{/if}}{{#if next}}<a class="button secondary" href="{{next}}">Next</a>{{/if}}</div></main>{{> officeFooter}}</body></html>
