{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>Office overview</h1><p>Welcome, {{user.name}}. Manage the records, requests and resources available to your role.</p></div>{{#if canRegistry}}<a class="button" href="/admin/residents">Register a civil record</a>{{else}}{{#if canResources}}<a class="button" href="/admin/resources/new">Add resource</a>{{/if}}{{/if}}</header>
<div class="stats-strip">{{#each stats}}<a href="{{url}}"><strong>{{value}}</strong><span>{{label}}</span></a>{{/each}}</div>
<div class="dashboard-columns"><div>
{{#if canRequests}}<section class="panel"><h2>Recent document requests</h2>{{#if requests}}<div class="table-wrap"><table class="office-table"><thead><tr><th>Request</th><th>Resident / client</th><th>Document</th><th>Status</th></tr></thead><tbody>{{#each requests}}<tr><td><a href="/admin/requests/{{id}}">#{{id}}</a></td><td>{{fullName}}</td><td>{{documentType}}</td><td><span class="badge">{{status}}</span></td></tr>{{/each}}</tbody></table></div>{{else}}<p class="muted">No document requests have been submitted yet.</p>{{/if}}<div class="actions"><a class="button secondary" href="/admin/requests">Manage requests</a></div></section>{{/if}}
{{#if canResources}}<section class="panel"><h2>Supplies requiring attention</h2>{{#if lowStock}}<ul class="list">{{#each lowStock}}<li><a href="/admin/resources/{{id}}">{{code}} · {{name}}</a><br><span class="small muted">{{quantity}} {{unit}} available · Minimum {{minimum}}</span></li>{{/each}}</ul>{{else}}<p class="muted">No supplies are below their configured stock threshold.</p>{{/if}}</section>{{/if}}
{{#if canResidents}}<section class="panel"><h2>Start with the resident</h2><p class="muted">Find an existing profile before creating a new one. Civil records share the resident’s master identifier.</p><div class="actions"><a class="button secondary" href="/admin/residents">Find a resident</a><a class="button secondary" href="/admin/residents/new">Add resident</a></div></section>{{/if}}</div>
<aside><section class="panel"><h2>Latest notifications</h2>{{#if notices}}<ul class="list">{{#each notices}}<li><a href="{{url}}">{{title}}</a><p class="small muted">{{message}}</p></li>{{/each}}</ul>{{else}}<p class="muted">You’re up to date. New request and resource alerts will appear here.</p>{{/if}}<div class="actions"><a href="/dashboard/notifications" class="button secondary">All notifications</a></div></section><section class="panel"><h2>Citizen services remain open</h2><p class="muted">Residents can continue submitting requests, scheduling appointments and reviewing payments.</p><a class="button secondary" href="/browse">Open citizen services</a></section></aside></div>
</main>{{> officeFooter}}</body></html>
