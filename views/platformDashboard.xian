{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>Office overview</h1><p>Welcome, {{user.name}}. Manage the records, requests and resources available to your role.</p></div>{{#if canRegistry}}<a class="button" href="/admin/residents">Register a civil record</a>{{else}}{{#if canResources}}<a class="button" href="/admin/resources/new">Add resource</a>{{/if}}{{/if}}</header>
<div class="stats-strip">{{#each stats}}<a href="{{url}}"><strong>{{value}}</strong><span>{{label}}</span></a>{{/each}}</div>
{{#if canResidents}}<section class="resident-module-section" aria-labelledby="resident-modules-heading"><h2 id="resident-modules-heading">Resident management</h2><div class="resident-modules">
<a href="/admin/residents"><span class="resident-module-icon">{{> navIcon icon="people"}}</span><strong>Resident profiles</strong><span>Register, search and maintain resident information.</span></a>
{{#if canBarangays}}<a href="/admin/barangays"><span class="resident-module-icon">{{> navIcon icon="portal"}}</span><strong>Barangay management</strong><span>Maintain the locations used in resident records.</span></a>{{/if}}
{{#if canPopulation}}<a href="/admin/population"><span class="resident-module-icon">{{> navIcon icon="chart"}}</span><strong>Reports and statistics</strong><span>Filter population figures and export resident reports.</span></a>{{/if}}
{{#if canResidentActivity}}<a href="/admin/resident-activity"><span class="resident-module-icon">{{> navIcon icon="audit"}}</span><strong>Resident activity</strong><span>Review staff activity and resident record changes.</span></a>{{/if}}
</div></section>{{/if}}
{{#if canBudget}}<section class="panel"><div class="planning-section-heading"><div><h2>Department budget</h2><p class="small muted">Allocated and spent amounts for the selected fiscal year.</p></div><a class="button secondary" href="/admin/budget">Manage budget</a></div><form method="get" action="/admin" class="toolbar no-print"><label><span>Fiscal year</span><input name="fiscalYear" type="number" min="1900" max="9999" value="{{fiscalYear}}" required></label><button class="button secondary" type="submit">Apply year</button></form><div class="table-wrap"><table class="office-table"><thead><tr><th>Department</th><th>Allocated (PHP)</th><th>Spent (PHP)</th><th>Remaining (PHP)</th><th>Used</th><th>Budget status</th></tr></thead><tbody>{{#each budgets}}<tr><td>{{department}}</td><td>{{allocated}}</td><td>{{spent}}</td><td>{{remaining}}</td><td>{{#if zeroAllocation}}Not applicable{{else}}{{usedPercent}}%{{/if}}</td><td><span class="badge">{{#if overBudget}}Over budget{{else}}Within budget{{/if}}</span></td></tr>{{else}}<tr><td colspan="6">No budget entries for {{fiscalYear}}. Add a budget item to start tracking department spending.</td></tr>{{/each}}</tbody></table></div></section>{{/if}}
<div class="dashboard-columns"><div>
{{#if canRequests}}<section class="panel"><h2>Recent document requests</h2>{{#if requests}}<div class="table-wrap"><table class="office-table"><thead><tr><th>Request</th><th>Resident / client</th><th>Document</th><th>Status</th></tr></thead><tbody>{{#each requests}}<tr><td><a href="/admin/requests/{{id}}">#{{id}}</a></td><td>{{fullName}}</td><td>{{documentType}}</td><td><span class="badge">{{status}}</span></td></tr>{{/each}}</tbody></table></div>{{else}}<p class="muted">No document requests have been submitted yet.</p>{{/if}}<div class="actions"><a class="button secondary" href="/admin/requests">Manage requests</a></div></section>{{/if}}
{{#if canResources}}<section class="panel"><h2>Needs attention</h2>{{#if attention}}<ul class="list">{{#each attention}}<li><a href="{{url}}">{{title}}</a><p class="small muted">{{detail}}</p></li>{{/each}}</ul><p class="small muted">Budget alerts use fiscal year {{fiscalYear}}. Showing up to 20 resources requiring attention.</p>{{else}}<p class="muted">No over-budget departments, Poor resources or low-stock supplies require attention.</p>{{/if}}</section>{{/if}}
{{#if canResidents}}<section class="panel"><h2>Start with the resident</h2><p class="muted">Find an existing profile before creating a new one. Civil records share the resident’s master identifier.</p><div class="actions"><a class="button secondary" href="/admin/residents">Find a resident</a><a class="button secondary" href="/admin/residents/new">Add resident</a></div></section>{{/if}}</div>
<aside><section class="panel"><h2>Latest notifications</h2>{{#if notices}}<ul class="list">{{#each notices}}<li><a href="{{url}}">{{title}}</a><p class="small muted">{{message}}</p></li>{{/each}}</ul>{{else}}<p class="muted">You’re up to date. New request and resource alerts will appear here.</p>{{/if}}<div class="actions"><a href="/dashboard/notifications" class="button secondary">All notifications</a></div></section><section class="panel"><h2>Citizen services remain open</h2><p class="muted">Residents can continue submitting requests, scheduling appointments and reviewing payments.</p><a class="button secondary" href="/browse">Open citizen services</a></section></aside></div>
</main>{{> officeFooter}}</body></html>
