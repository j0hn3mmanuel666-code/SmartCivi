{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main"><section class="panel"><h1>{{title}}</h1><p role="alert">{{message}}</p><p class="muted">Use your browser’s Back button to correct the form, or return to the overview.</p><a class="button secondary" href="{{#if isStaff}}/admin{{else}}/dashboard{{/if}}">Return to overview</a></section></main>{{> officeFooter}}</body></html>
