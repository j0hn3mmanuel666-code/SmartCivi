{{> head}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>{{title}}</h1><p>{{#if archived}}This record is archived. Restore it before making changes.{{else}}Required fields are marked with an asterisk. {{description}}{{/if}}</p></div><a class="button secondary" href="{{base}}">Back to list</a></header>
<section class="panel"><form method="post" action="{{action}}" data-save><fieldset {{#if archived}}disabled{{/if}} style="border:0;padding:0;margin:0"><legend class="small muted" style="margin-bottom:20px">Record details</legend>{{> officeFields}}<div class="actions"><button type="submit" class="button">Save record</button><a href="{{base}}" class="button secondary">Cancel</a></div></fieldset></form></section>
{{#if existing}}<div class="actions">{{#if registerUrl}}<a class="button" href="{{registerUrl}}">Register civil record</a>{{/if}}<form method="post" action="{{action}}/archive" data-confirm="Change the archive state of this record? Its history will be retained."><button class="button danger" type="submit">{{#if archived}}Restore record{{else}}Archive record{{/if}}</button></form></div>{{/if}}
{{#if related}}<section class="panel"><h2>Linked civil records</h2><ul class="list">{{#each related}}<li><a href="{{url}}">{{label}}</a></li>{{/each}}</ul></section>{{/if}}
</main>{{> officeFooter}}</body></html>
