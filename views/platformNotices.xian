{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}<header class="page-heading"><div><h1>Notifications</h1><p>Updates for your requests and the office tasks assigned to your role.</p></div></header><section class="panel">{{#if notices}}<ul class="list">{{#each notices}}<li {{#if readAt}}class="read-notice"{{/if}}><a href="{{url}}"><strong>{{title}}</strong></a><p>{{message}}</p><p class="small muted">{{when}} · {{#if readAt}}Read{{else}}Unread{{/if}}</p>{{#unless readAt}}<form method="post" action="/dashboard/notifications/{{id}}/read"><button class="button secondary" type="submit">Mark as read</button></form>{{/unless}}</li>{{/each}}</ul>{{else}}<div class="empty"><h2>You’re up to date</h2><p>Request updates and office alerts will appear here.</p></div>{{/if}}<div class="pagination">{{#if previous}}<a class="button secondary" href="{{previous}}">Previous</a>{{/if}}{{#if next}}<a class="button secondary" href="{{next}}">Next</a>{{/if}}</div></section></main>{{> officeFooter}}</body></html>
