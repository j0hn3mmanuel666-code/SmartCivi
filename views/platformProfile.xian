{{> head officeStyles=true}}
<body class="office">
{{> staffNav}}
<main id="main" class="office-main profile-page">
  <header class="page-heading">
    <div><h1>My profile</h1><p>Review your account information and manage how you sign in.</p></div>
  </header>
  {{> officeFlash}}
  <div class="profile-layout">
    <section class="panel profile-details" aria-labelledby="account-details-title">
      <div class="profile-section-heading"><h2 id="account-details-title">Account information</h2><p>Details registered with your SmartCivi account.</p></div>
      <dl class="profile-facts">
        <div><dt><label for="profile-name">Full name</label></dt><dd><form method="post" action="/dashboard/profile" class="profile-name-form"><input id="profile-name" type="text" name="name" value="{{user.name}}" autocomplete="name" maxlength="255" required><button type="submit" class="button">Save name</button></form></dd></div>
        <div><dt>Email address</dt><dd>{{user.email}}</dd></div>
        <div><dt>Account role</dt><dd><span class="profile-role">{{> roleLabel}}</span></dd></div>
      </dl>
      <div class="profile-corrections"><h3>Account corrections</h3><p>You can update your name above. For email address or account role corrections, contact the authorized office administrator.</p></div>
      <div class="profile-links"><a class="button secondary" href="/dashboard/my-requests">My requests</a><a href="/help">Office guidance <span aria-hidden="true">&#8594;</span></a></div>
    </section>
    <section class="panel profile-sign-in" aria-labelledby="google-sign-in-title">
      <div class="profile-section-heading"><h2 id="google-sign-in-title">Google sign-in</h2><p>Connect Google to sign in to SmartCivi.</p></div>
      <div class="profile-provider"><svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M43.61 24.46c0-1.36-.12-2.66-.35-3.92H24v7.42h11a9.4 9.4 0 0 1-4.08 6.18v5.14h6.61c3.87-3.56 6.08-8.81 6.08-14.82Z"/><path fill="#34A853" d="M24 44c5.51 0 10.13-1.83 13.51-4.95l-6.61-5.14c-1.83 1.23-4.18 1.97-6.9 1.97-5.32 0-9.85-3.59-11.47-8.42H5.7v5.3A20 20 0 0 0 24 44Z"/><path fill="#FBBC05" d="M12.53 27.46a12 12 0 0 1 0-6.92v-5.3H5.7a20 20 0 0 0 0 17.52l6.83-5.3Z"/><path fill="#EA4335" d="M24 12.12c3 0 5.68 1.03 7.8 3.04l5.85-5.85A19.65 19.65 0 0 0 24 4 20 20 0 0 0 5.7 15.24l6.83 5.3c1.62-4.83 6.15-8.42 11.47-8.42Z"/></svg><div><h3>Google account</h3><p>Use the Google account with the same email address shown in your profile.</p></div></div>
      {{#if googleReady}}
      <form method="post" action="/auth/google" class="profile-google-form"><input type="hidden" name="intent" value="link"><button type="submit" class="button secondary">Connect Google account</button></form>
      {{else}}
      <p class="profile-provider-unavailable">Google sign-in is currently unavailable.</p>
      {{/if}}
      <p class="profile-permissions">Connecting Google does not change your account role or access permissions.</p>
    </section>
  </div>
</main>
{{> officeFooter}}
</body></html>
