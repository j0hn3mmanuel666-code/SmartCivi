{{> head}}<body class="office">{{> staffNav}}<main id="main" class="office-main"><header class="page-heading"><div><h1>My profile</h1><p>Your account identifies the requests and notifications you can access.</p></div></header><section class="panel"><h2>Account details</h2><dl><dt>Name</dt><dd>{{user.name}}</dd><dt>Email</dt><dd>{{user.email}}</dd><dt>Role</dt><dd>{{user.role}}</dd></dl><p class="muted">Contact the authorized office administrator for account corrections. Passwords are never displayed.</p><div class="actions"><a class="button secondary" href="/dashboard/my-requests">My requests</a><a class="button secondary" href="/help">Office guidance</a></div></section></main>{{> officeFooter}}</body></html>
