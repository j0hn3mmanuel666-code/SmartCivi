{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}<header class="page-heading"><div><h1>Reports and analytics</h1><p>Generate reports from live office records. Date ranges apply to the date added, in Philippine time.</p></div><button class="button secondary" type="button" data-print>Print report</button></header>
<section class="panel"><form method="get" action="/admin/reports" class="toolbar"><label><span>Dataset</span><select name="dataset">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><span>From date</span><input type="date" name="from" value="{{from}}"></label><label><span>Through date</span><input type="date" name="to" value="{{to}}"></label><button class="button" type="submit">Generate report</button><a class="button secondary" href="{{exportUrl}}">Export CSV</a></form><h2>{{count}} matching records</h2>{{#if truncated}}<p class="notice">Showing the latest 100 records. Export CSV for up to 10,000 records, or narrow the date range.</p>{{/if}}{{#if rows}}<div class="table-wrap"><table class="office-table"><thead><tr>{{#each columns}}<th scope="col">{{this}}</th>{{/each}}</tr></thead><tbody>{{#each rows}}<tr>{{#each cells}}<td>{{this}}</td>{{/each}}</tr>{{/each}}</tbody></table></div>{{else}}<div class="empty">No records match this report. Try a different date range or dataset.</div>{{/if}}</section></main>{{> officeFooter}}</body></html>
