{{> head officeStyles=true}}<body class="office population-page">{{> staffNav}}
<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>Population statistics</h1><p>Registered residents of Bongabong. Figures reflect records in SmartCivi and are not a complete population census.</p></div><div class="record-links no-print"><a class="button" href="{{exportUrl}}">Export CSV</a><button class="button secondary" type="button" data-print>Print report</button></div></header>
<section class="panel no-print" aria-label="Population filters"><form action="/admin/population" method="get" class="population-filters">
<label><span>Search resident</span><input name="q" value="{{filters.q}}" maxlength="100" placeholder="Name or Resident ID"></label>
<label><span>Barangay</span><select name="barangay"><option value="">All barangays</option>{{#each barangays}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
<label><span>Sex</span><select name="sex"><option value="">All</option><option value="female" {{#ifEq filters.sex 'female'}}selected{{/ifEq}}>Female</option><option value="male" {{#ifEq filters.sex 'male'}}selected{{/ifEq}}>Male</option><option value="unspecified" {{#ifEq filters.sex 'unspecified'}}selected{{/ifEq}}>Not recorded</option></select></label>
<label><span>Civil status</span><select name="civilStatus"><option value="">All</option>{{#each statuses}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
<label><span>Minimum age</span><input name="ageMin" type="number" min="0" max="150" value="{{filters.ageMin}}"></label><label><span>Maximum age</span><input name="ageMax" type="number" min="0" max="150" value="{{filters.ageMax}}"></label>
<label><span>Calculate age on</span><input name="asOf" type="date" value="{{filters.asOf}}" required></label><label><span>Registered from</span><input name="from" type="date" value="{{filters.from}}"></label><label><span>Registered through</span><input name="to" type="date" value="{{filters.to}}"></label>
<label><span>Record status</span><select name="status"><option value="active" {{#ifEq filters.status 'active'}}selected{{/ifEq}}>Active</option><option value="archived" {{#ifEq filters.status 'archived'}}selected{{/ifEq}}>Archived</option><option value="all" {{#ifEq filters.status 'all'}}selected{{/ifEq}}>All records</option></select></label>
<div class="record-links"><button class="button" type="submit">Apply filters</button><a class="button secondary" href="/admin/population">Reset</a></div></form></section>
<section aria-label="Filtered population summary"><div class="population-summary"><strong>{{count}}</strong><span>matching registered residents</span></div><p class="small muted report-filter-summary">Status: {{filters.status}} · Age calculated on {{filters.asOf}}{{#if filters.barangay}} · Barangay: {{filters.barangay}}{{/if}}{{#if filters.q}} · Search: {{filters.q}}{{/if}}{{#if filters.sex}} · Sex: {{filters.sex}}{{/if}}{{#if filters.civilStatus}} · Civil status: {{filters.civilStatus}}{{/if}} · Age range: {{#if filters.ageMin}}{{filters.ageMin}}{{else}}0{{/if}}–{{#if filters.ageMax}}{{filters.ageMax}}{{else}}all{{/if}}{{#if filters.from}} · Registered from {{filters.from}}{{/if}}{{#if filters.to}} through {{filters.to}}{{/if}}</p>
<div class="population-groups">{{#each groups}}<section class="panel"><h2>{{title}}</h2><dl class="population-breakdown">{{#each rows}}<div><dt>{{label}}</dt><dd>{{count}}</dd></div>{{else}}<p class="muted small">No matching residents.</p>{{/each}}</dl></section>{{/each}}</div></section>
<section class="panel" aria-label="Matching residents"><h2>Matching residents</h2><p class="small muted">Page {{page}} of {{pages}} · Up to 25 residents per page. CSV includes all matching records, up to 10,000.</p><div class="table-wrap"><table class="office-table"><thead><tr>{{#each columns}}<th scope="col">{{this}}</th>{{/each}}<th scope="col" class="no-print">Profile</th></tr></thead><tbody>{{#each rows}}<tr>{{#each cells}}<td>{{this}}</td>{{/each}}<td class="no-print"><a href="/admin/residents/{{id}}/profile">Open</a></td></tr>{{else}}<tr><td colspan="9">No residents match these filters.</td></tr>{{/each}}</tbody></table></div><div class="pagination no-print"><span class="small muted">{{count}} matching records</span><div class="record-links">{{#if previous}}<a class="button secondary" href="{{previous}}">Previous</a>{{/if}}{{#if next}}<a class="button secondary" href="{{next}}">Next</a>{{/if}}</div></div></section></main>{{> officeFooter}}</body></html>
