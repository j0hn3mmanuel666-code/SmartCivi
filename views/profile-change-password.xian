{{> head}}

<div class="flex">
    {{> sidebar}}
    
    <div class="flex-1 ml-64">
        {{> topbar}}

        <div class="p-8">
            {{#if error_msg}}
            <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
                {{#each error_msg}}
                    <p>{{this}}</p>
                {{/each}}
            </div>
            {{/if}}

            {{#if success_msg}}
            <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
                {{#each success_msg}}
                    <p>{{this}}</p>
                {{/each}}
            </div>
            {{/if}}

            <div class="mb-8">
                <a href="/profile" class="text-blue-600 hover:text-blue-800 font-medium">← Back to Profile</a>
            </div>

            <div class="max-w-2xl bg-white rounded-lg shadow p-8">
                <h1 class="text-2xl font-bold text-gray-800 mb-6">Change Password</h1>

                <form method="POST" action="/profile/change-password" class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Current Password *</label>
                        <input type="password" name="old_password" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">New Password *</label>
                        <input type="password" id="new_password" name="new_password" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" oninput="checkPasswordStrength()">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Confirm New Password *</label>
                        <input type="password" name="confirm_password" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>

                    <!-- Password Requirements -->
                    <div class="bg-blue-50 p-4 rounded border border-blue-200">
                        <p class="font-semibold text-gray-800 mb-3">Password Requirements:</p>
                        <ul class="space-y-2 text-sm">
                            <li id="req-length" class="flex items-center text-gray-600">
                                <span class="w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center mr-2 text-xs">✗</span>
                                At least 8 characters
                            </li>
                            <li id="req-uppercase" class="flex items-center text-gray-600">
                                <span class="w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center mr-2 text-xs">✗</span>
                                At least one uppercase letter (A-Z)
                            </li>
                            <li id="req-number" class="flex items-center text-gray-600">
                                <span class="w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center mr-2 text-xs">✗</span>
                                At least one number (0-9)
                            </li>
                            <li id="req-special" class="flex items-center text-gray-600">
                                <span class="w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center mr-2 text-xs">✗</span>
                                At least one special character (!@#$%^&*)
                            </li>
                        </ul>
                    </div>

                    <!-- Buttons -->
                    <div class="flex gap-4 mt-8 pt-6 border-t">
                        <a href="/profile" class="px-6 py-2 border border-gray-300 text-gray-700 font-bold rounded-lg hover:bg-gray-50">
                            Cancel
                        </a>
                        <button type="submit" class="px-6 py-2 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg transition">
                            Change Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function checkPasswordStrength() {
    const password = document.getElementById('new_password').value;
    
    const checks = {
        'req-length': password.length >= 8,
        'req-uppercase': /[A-Z]/.test(password),
        'req-number': /[0-9]/.test(password),
        'req-special': /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)
    };

    for (const [id, isValid] of Object.entries(checks)) {
        const elem = document.getElementById(id);
        if (isValid) {
            elem.classList.add('text-green-600');
            elem.classList.remove('text-gray-600');
            elem.querySelector('span').innerHTML = '✓';
            elem.querySelector('span').classList.add('border-green-500', 'text-green-500');
            elem.querySelector('span').classList.remove('border-gray-300');
        } else {
            elem.classList.remove('text-green-600');
            elem.classList.add('text-gray-600');
            elem.querySelector('span').innerHTML = '✗';
            elem.querySelector('span').classList.remove('border-green-500', 'text-green-500');
            elem.querySelector('span').classList.add('border-gray-300');
        }
    }
}
</script>

{{> footer}}
