{{> head }}
<body class="min-h-screen bg-zinc-50 text-zinc-900 antialiased">
  {{> sidebar}}
  <header class="mx-auto max-w-7xl px-5 pb-7 pt-10 sm:pt-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-emerald-800">Account</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-950">My profile</h1>
    <p class="mt-2 text-sm text-zinc-600">Your account information.</p>
  </header>
  <main class="mx-auto max-w-3xl px-5 pb-12">
    <section class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm">
      <dl class="divide-y divide-zinc-100">
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr]">
          <dt class="text-sm font-medium text-zinc-500">Name</dt>
          <dd class="text-sm font-semibold text-zinc-900">{{user.name}}</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr]">
          <dt class="text-sm font-medium text-zinc-500">Email</dt>
          <dd class="text-sm font-semibold text-zinc-900">{{user.email}}</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr]">
          <dt class="text-sm font-medium text-zinc-500">Account type</dt>
          <dd class="text-sm font-semibold capitalize text-zinc-900">{{user.role}}</dd>
        </div>
      </dl>
    </section>
  </main>
</body>
</html>
