{{> head officeStyles=true}}
<body class="auth-page">
<a href="#main" class="skip-link">Skip to registration</a>
{{> authHeader}}
<main id="main" class="auth-layout">
  <section class="auth-intro" aria-labelledby="register-intro-title">
    <h2 id="register-intro-title">Your local services, <br>one secure account.</h2>
    <p>Create your citizen account to request civil documents, manage appointments and follow updates from the municipal registry.</p>
    <ul class="auth-features"><li>{{> navIcon icon="record"}}<span><strong>Request civil documents</strong><span>Birth, marriage and death certificates.</span></span></li><li>{{> navIcon icon="user"}}<span><strong>Verify your email</strong><span>A verification link helps protect your account.</span></span></li><li>{{> navIcon icon="calendar"}}<span><strong>Stay up to date</strong><span>Follow your requests and upcoming visits.</span></span></li></ul>
    <p class="auth-office">Municipal Civil Registry<br>Bansud, Oriental Mindoro</p>
  </section>
  <section class="auth-card" aria-labelledby="register-title">
    <h1 id="register-title">Create your account</h1>
    <p class="auth-description">Get started with Google or register with your email address.</p>
    {{> authFlash}}
    {{> googleSignIn}}
    {{#unless mailReady}}<div class="auth-alert" role="status">Email registration is temporarily unavailable. Please contact the office or use Google if available.</div>{{/unless}}
    <form method="post" action="/register" class="auth-form">
      <div class="auth-field"><label for="name">Full name</label><input id="name" type="text" name="name" autocomplete="name" maxlength="255" required></div>
      <div class="auth-field"><label for="email">Email address</label><input id="email" type="email" name="email" autocomplete="email" autocapitalize="none" spellcheck="false" maxlength="255" required></div>
      <div class="auth-field"><label for="password">Password</label><div class="auth-password"><input id="password" type="password" name="password" autocomplete="new-password" minlength="8" maxlength="72" aria-describedby="password-hint" required><button type="button" class="auth-password-toggle" data-password-toggle aria-controls="password" aria-pressed="false" aria-label="Show password" hidden>Show</button></div><p id="password-hint" class="auth-provider-note">Use at least 8 characters, up to 72 bytes.</p></div>
      <button class="auth-submit" type="submit" {{#unless mailReady}}disabled{{/unless}}>Create account</button>
    </form>
    <p class="auth-provider-note">We will email you a verification link before you can sign in.</p>
    <p class="auth-register">Already registered? <a href="/login">Sign in</a></p>
    <p class="auth-provider-note"><a href="/verify-email">Resend verification email</a></p>
  </section>
</main>
{{> authFooter}}
</body></html>
