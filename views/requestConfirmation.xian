{{> head }}
<body class="office legacy-workspace bg-gradient-to-br from-pink-300 via-purple-300 to-blue-400 text-gray-800 min-h-screen">

  {{> staffNav}}

  <section class="flex flex-col justify-center items-center text-center h-44 px-6 pt-24 print:hidden">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white drop-shadow-md">Request Confirmation</h1>
    <p class="text-md md:text-lg text-white mt-3 max-w-2xl">Your civil registry request has been successfully submitted.</p>
  </section>

  <main id="main" class="container mx-auto px-4 py-8 print:px-0 print:py-0">
    
    <!-- Print Actions (Hidden on Print) -->
    <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6 max-w-4xl mx-auto mb-6 print:hidden">
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button onclick="window.print()" class="bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 transition-all flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a1 1 0 001-1v-4a1 1 0 00-1-1H9a1 1 0 00-1 1v4a1 1 0 001 1zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
          </svg>
          Print Confirmation
        </button>
        <button onclick="exportToPDF()" class="bg-green-600 text-white px-6 py-3 rounded-md hover:bg-green-700 transition-all flex items-center justify-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Export to PDF
        </button>
        <a href="/browse" class="bg-gray-600 text-white px-6 py-3 rounded-md hover:bg-gray-700 transition-all text-center">
          Submit Another Request
        </a>
      </div>
    </div>

    <!-- Printable Confirmation Card -->
    <div id="confirmation-card" class="bg-white rounded-lg shadow-md max-w-4xl mx-auto print:shadow-none print:max-w-none">
      
      <!-- Header -->
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-8 rounded-t-lg print:bg-blue-600 print:rounded-none">
        <div class="text-center">
          <div class="text-3xl font-bold mb-2">SmartCivi</div>
          <div class="text-lg">Civil Registry Management System</div>
          <div class="text-sm opacity-90 mt-2">Republic of the Philippines</div>
        </div>
      </div>

      <!-- Confirmation Details -->
      <div class="p-8">
        
        <!-- Success Message -->
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-800 mb-2">Request Successfully Submitted!</h2>
          <p class="text-gray-600">Your civil registry document request has been received and is now being processed.</p>
        </div>

        <!-- Request Information -->
        <div class="border-2 border-dashed border-gray-300 p-6 mb-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4 text-center">Request Information</h3>
          
          <div class="grid md:grid-cols-2 gap-6">
            <!-- Left Column -->
            <div class="space-y-4">
              <div class="flex justify-between border-b border-gray-200 pb-2">
                <span class="font-medium text-gray-600">Request ID:</span>
                <span class="font-bold text-blue-600">#{{request.id}}</span>
              </div>
              <div class="flex justify-between border-b border-gray-200 pb-2">
                <span class="font-medium text-gray-600">Full Name:</span>
                <span class="font-semibold">{{request.fullName}}</span>
              </div>
              <div class="flex justify-between border-b border-gray-200 pb-2">
                <span class="font-medium text-gray-600">Email:</span>
                <span>{{request.email}}</span>
              </div>
              <div class="flex justify-between border-b border-gray-200 pb-2">
                <span class="font-medium text-gray-600">Phone:</span>
                <span>{{request.phone}}</span>
              </div>
            </div>
            
            <!-- Right Column -->
            <div class="space-y-4">
              <div class="flex justify-between border-b border-gray-200 pb-2">
                <span class="font-medium text-gray-600">Document Type:</span>
                <span class="font-semibold capitalize">{{request.documentType}} Certificate</span>
              </div>
              <div class="flex justify-between border-b border-gray-200 pb-2">
                <span class="font-medium text-gray-600">Purpose:</span>
                <span>{{request.purpose}}</span>
              </div>
              <div class="flex justify-between border-b border-gray-200 pb-2">
                <span class="font-medium text-gray-600">Date Submitted:</span>
                <span>{{confirmationDate}}</span>
              </div>
              <div class="flex justify-between border-b border-gray-200 pb-2">
                <span class="font-medium text-gray-600">Status:</span>
                <span class="bg-yellow-100 text-yellow-800 px-2 py-1 rounded-full text-sm font-medium">Pending Review</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Processing Information -->
        <div class="bg-blue-50 rounded-lg p-6 mb-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Processing Information</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <div class="flex justify-between mb-2">
                <span class="font-medium text-gray-600">Estimated Processing Time:</span>
                <span class="font-semibold text-blue-600">{{processingInfo.estimatedDays}}</span>
              </div>
              <div class="flex justify-between">
                <span class="font-medium text-gray-600">Processing Fee:</span>
                <span class="font-semibold text-green-600">₱{{processingInfo.fees}}</span>
              </div>
            </div>
            <div>
              <p class="text-sm text-gray-600">
                <strong>Note:</strong> You will receive email notifications at each stage of processing. 
                Payment will be required once your request is approved.
              </p>
            </div>
          </div>
        </div>

        <!-- Next Steps -->
        <div class="bg-gray-50 rounded-lg p-6 mb-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">What Happens Next?</h3>
          <div class="space-y-3">
            {{#each processingInfo.nextSteps}}
            <div class="flex items-start">
              <div class="flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-3 mt-0.5">
                {{@index}}
              </div>
              <p class="text-gray-700">{{this}}</p>
            </div>
            {{/each}}
          </div>
        </div>

        <!-- Important Information -->
        <div class="border-l-4 border-yellow-400 bg-yellow-50 p-4 mb-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-yellow-800">Important Reminders</h3>
              <div class="mt-2 text-sm text-yellow-700">
                <ul class="list-disc list-inside space-y-1">
                  <li>Keep this confirmation for your records</li>
                  <li>Check your email regularly for status updates</li>
                  <li>Have your payment ready when the request is approved</li>
                  <li>Contact our office if you need to make changes to your request</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Information -->
        <div class="text-center border-t border-gray-200 pt-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-2">Need Help?</h3>
          <p class="text-gray-600 mb-4">Contact our office during business hours for assistance with your request.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center text-sm">
            <a href="/status" class="text-blue-600 hover:text-blue-800 font-medium">Check Request Status</a>
            <a href="/help" class="text-blue-600 hover:text-blue-800 font-medium">Help & Support</a>
            <a href="/offices" class="text-blue-600 hover:text-blue-800 font-medium">Office Locations</a>
          </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-8 pt-6 border-t border-gray-200 text-sm text-gray-500">
          <p>Generated on {{confirmationDate}} | SmartCivi Civil Registry System</p>
          <p class="mt-1">This confirmation serves as proof of your request submission.</p>
        </div>

      </div>
    </div>

  </main>

  <!-- Print Styles -->
  <style>
    @media print {
      body {
        background: white !important;
        -webkit-print-color-adjust: exact;
        color-adjust: exact;
      }
      
      .print\\:hidden {
        display: none !important;
      }
      
      .print\\:shadow-none {
        box-shadow: none !important;
      }
      
      .print\\:max-w-none {
        max-width: none !important;
      }
      
      .print\\:px-0 {
        padding-left: 0 !important;
        padding-right: 0 !important;
      }
      
      .print\\:py-0 {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
      }
      
      .print\\:bg-blue-600 {
        background-color: #2563eb !important;
      }
      
      .print\\:rounded-none {
        border-radius: 0 !important;
      }
      
      /* Ensure page breaks */
      #confirmation-card {
        page-break-inside: avoid;
      }
      
      /* Print-specific styling */
      .bg-gradient-to-r {
        background: #2563eb !important;
      }
    }
  </style>

  <!-- JavaScript for PDF Export -->
  <script>
    function exportToPDF() {
      // Create a new window with the confirmation card content
      const printWindow = window.open('', '_blank');
      const confirmationCard = document.getElementById('confirmation-card');
      
      const htmlContent = `
        <!DOCTYPE html>
        <html>
        <head>
          <title>Request Confirmation - SmartCivi</title>
          <style>
            body { 
              font-family: Arial, sans-serif; 
              margin: 0; 
              padding: 20px; 
              background: white;
              color: #333;
            }
            .header {
              background: #2563eb;
              color: white;
              padding: 30px;
              text-align: center;
              margin-bottom: 0;
            }
            .content {
              padding: 30px;
              border: 1px solid #ddd;
            }
            .grid {
              display: grid;
              grid-template-columns: 1fr 1fr;
              gap: 20px;
              margin: 20px 0;
            }
            .info-row {
              display: flex;
              justify-content: space-between;
              padding: 8px 0;
              border-bottom: 1px solid #eee;
            }
            .status-badge {
              background: #fef3c7;
              color: #92400e;
              padding: 4px 8px;
              border-radius: 12px;
              font-size: 12px;
              font-weight: 500;
            }
            .section {
              margin: 20px 0;
              padding: 20px;
              background: #f8f9fa;
              border-radius: 8px;
            }
            .steps {
              list-style: none;
              padding: 0;
            }
            .steps li {
              margin: 10px 0;
              padding-left: 30px;
              position: relative;
            }
            .steps li:before {
              content: counter(step-counter);
              counter-increment: step-counter;
              position: absolute;
              left: 0;
              top: 0;
              background: #2563eb;
              color: white;
              width: 20px;
              height: 20px;
              border-radius: 50%;
              display: flex;
              align-items: center;
              justify-content: center;
              font-size: 12px;
              font-weight: bold;
            }
            .steps {
              counter-reset: step-counter;
            }
            .footer {
              text-align: center;
              margin-top: 30px;
              padding-top: 20px;
              border-top: 1px solid #ddd;
              font-size: 12px;
              color: #666;
            }
          </style>
        </head>
        <body>
          <div class="header">
            <h1>SmartCivi</h1>
            <p>Civil Registry Management System</p>
            <p>Republic of the Philippines</p>
          </div>
          
          <div class="content">
            <div style="text-align: center; margin-bottom: 30px;">
              <h2>Request Confirmation</h2>
              <p>Your civil registry document request has been successfully submitted.</p>
            </div>
            
            <div style="border: 2px dashed #ccc; padding: 20px; margin: 20px 0;">
              <h3 style="text-align: center; margin-bottom: 20px;">Request Information</h3>
              <div class="grid">
                <div>
                  <div class="info-row">
                    <span><strong>Request ID:</strong></span>
                    <span><strong>#{{request.id}}</strong></span>
                  </div>
                  <div class="info-row">
                    <span><strong>Full Name:</strong></span>
                    <span>{{request.fullName}}</span>
                  </div>
                  <div class="info-row">
                    <span><strong>Email:</strong></span>
                    <span>{{request.email}}</span>
                  </div>
                  <div class="info-row">
                    <span><strong>Phone:</strong></span>
                    <span>{{request.phone}}</span>
                  </div>
                </div>
                <div>
                  <div class="info-row">
                    <span><strong>Document Type:</strong></span>
                    <span>{{request.documentType}} Certificate</span>
                  </div>
                  <div class="info-row">
                    <span><strong>Purpose:</strong></span>
                    <span>{{request.purpose}}</span>
                  </div>
                  <div class="info-row">
                    <span><strong>Date Submitted:</strong></span>
                    <span>{{confirmationDate}}</span>
                  </div>
                  <div class="info-row">
                    <span><strong>Status:</strong></span>
                    <span class="status-badge">Pending Review</span>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="section">
              <h3>Processing Information</h3>
              <div class="grid">
                <div>
                  <div class="info-row">
                    <span><strong>Estimated Processing Time:</strong></span>
                    <span>{{processingInfo.estimatedDays}}</span>
                  </div>
                  <div class="info-row">
                    <span><strong>Processing Fee:</strong></span>
                    <span>₱{{processingInfo.fees}}</span>
                  </div>
                </div>
                <div>
                  <p><strong>Note:</strong> You will receive email notifications at each stage of processing. Payment will be required once your request is approved.</p>
                </div>
              </div>
            </div>
            
            <div class="section">
              <h3>What Happens Next?</h3>
              <ol class="steps">
                {{#each processingInfo.nextSteps}}
                <li>{{this}}</li>
                {{/each}}
              </ol>
            </div>
            
            <div class="footer">
              <p>Generated on {{confirmationDate}} | SmartCivi Civil Registry System</p>
              <p>This confirmation serves as proof of your request submission.</p>
            </div>
          </div>
        </body>
        </html>
      `;
      
      printWindow.document.write(htmlContent);
      printWindow.document.close();
      
      // Wait for content to load, then print
      setTimeout(() => {
        printWindow.print();
        printWindow.close();
      }, 500);
    }
  </script>

</body>