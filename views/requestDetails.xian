{{> head }}
<body class="office legacy-workspace bg-gradient-to-br from-pink-300 via-purple-300 to-blue-400 text-gray-800 min-h-screen">

  {{> staffNav}}

  <section class="flex flex-col justify-center items-center text-center h-44 px-6 pt-24">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white drop-shadow-md">Request Details</h1>
    <p class="text-md md:text-lg text-white mt-3 max-w-2xl">View the complete information for your civil registry request.</p>
    <div class="mt-3">
      <a href="/status" class="text-sm text-white underline">← Back to Request Status</a>
    </div>
  </section>

  <main id="main" class="container mx-auto px-4 py-8">
    <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6 max-w-4xl mx-auto">
      
      {{#if request}}
        <!-- Request Header -->
        <div class="border-b border-gray-200 pb-6 mb-6">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between">
            <div>
              <h2 class="text-2xl font-bold text-gray-800">{{request.documentType}} Certificate Request</h2>
              <p class="text-gray-600 mt-1">Request ID: #{{request.id}}</p>
            </div>
            <div class="mt-4 md:mt-0">
              <div class="px-4 py-2 rounded-full text-sm font-medium">
                {{#ifEq request.status 'pending'}}
                  <span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full">Pending</span>
                {{/ifEq}}
                {{#ifEq request.status 'processing'}}
                  <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full">Processing</span>
                {{/ifEq}}
                {{#ifEq request.status 'approved'}}
                  <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full">Approved</span>
                {{/ifEq}}
                {{#ifEq request.status 'payment_pending'}}
                  <span class="bg-orange-100 text-orange-800 px-3 py-1 rounded-full">Payment Pending</span>
                {{/ifEq}}
                {{#ifPaid request}}
                  <span class="bg-purple-100 text-purple-800 px-3 py-1 rounded-full">Paid</span>
                {{/ifPaid}}
                {{#ifEq request.status 'rejected'}}
                  <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full">Rejected</span>
                {{/ifEq}}
              </div>
            </div>
          </div>
        </div>

        <!-- Request Information -->
        <div class="grid md:grid-cols-2 gap-6">
          <!-- Personal Information -->
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Personal Information</h3>
            <div class="space-y-3">
              <div>
                <label class="block text-sm font-medium text-gray-600">Full Name</label>
                <p class="text-gray-800 font-medium">{{request.fullName}}</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-600">Email Address</label>
                <p class="text-gray-800">{{request.email}}</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-600">Phone Number</label>
                <p class="text-gray-800">{{request.phone}}</p>
              </div>
            </div>
          </div>

          <!-- Request Details -->
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Request Details</h3>
            <div class="space-y-3">
              <div>
                <label class="block text-sm font-medium text-gray-600">Document Type</label>
                <p class="text-gray-800 font-medium capitalize">{{request.documentType}} Certificate</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-600">Purpose</label>
                <p class="text-gray-800">{{request.purpose}}</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-600">Date Submitted</label>
                <p class="text-gray-800">{{request.createdAt}}</p>
              </div>
              {{#if request.updatedAt}}
              <div>
                <label class="block text-sm font-medium text-gray-600">Last Updated</label>
                <p class="text-gray-800">{{request.updatedAt}}</p>
              </div>
              {{/if}}
              {{#if request.paymentAmount}}
              <div>
                <label class="block text-sm font-medium text-gray-600">Payment Amount</label>
                <p class="text-gray-800 font-medium">₱{{request.paymentAmount}}</p>
              </div>
              {{/if}}
              {{#if request.paymentReference}}
              <div>
                <label class="block text-sm font-medium text-gray-600">Payment Reference</label>
                <p class="text-gray-800 font-mono">{{request.paymentReference}}</p>
              </div>
              {{/if}}
            </div>
          </div>
        </div>

        <!-- Status Information -->
        <div class="mt-6 bg-blue-50 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Status Information</h3>
          <div class="space-y-2">
            {{#ifEq request.status 'pending'}}
              <p class="text-gray-700">Your request is currently pending review. Our team will process it shortly.</p>
              <p class="text-sm text-gray-600">Expected processing time: 3-5 business days</p>
            {{/ifEq}}
            {{#ifEq request.status 'processing'}}
              <p class="text-gray-700">Your request is currently being processed by our team.</p>
              <p class="text-sm text-gray-600">We'll notify you once it's ready for pickup or delivery.</p>
            {{/ifEq}}
            {{#ifEq request.status 'approved'}}
              <p class="text-green-700 font-medium">Great news! Your request has been approved.</p>
              <p class="text-sm text-gray-600">Please proceed to payment to complete your request.</p>
            {{/ifEq}}
            {{#ifEq request.status 'payment_pending'}}
              <p class="text-orange-700 font-medium">Payment is pending.</p>
              {{#if request.paymentMethod}}
                {{#ifEq request.paymentMethod 'otc'}}
                  <p class="text-sm text-gray-600">Please pay at any authorized payment center using reference: <strong>{{request.paymentReference}}</strong></p>
                {{/ifEq}}
                {{#ifEq request.paymentMethod 'bank'}}
                  <p class="text-sm text-gray-600">Please complete your bank transfer using reference: <strong>{{request.paymentReference}}</strong></p>
                {{/ifEq}}
              {{/if}}
            {{/ifEq}}
            {{#ifPaid request}}
              <p class="text-purple-700 font-medium">Payment received! Your document is being prepared.</p>
              <p class="text-sm text-gray-600">You will be notified when your document is ready for pickup or delivery.</p>
            {{/ifPaid}}
            {{#ifEq request.status 'rejected'}}
              <p class="text-red-700 font-medium">Unfortunately, your request has been rejected.</p>
              <p class="text-sm text-gray-600">Please contact our office for more information or to resubmit with corrections.</p>
            {{/ifEq}}
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href="/status" class="bg-gray-600 text-white px-6 py-3 rounded-md hover:bg-gray-700 transition-all text-center">
            Back to Status
          </a>
          {{#ifEq request.status 'approved'}}
            <a href="/request/{{request.id}}/pay" class="bg-green-600 text-white px-6 py-3 rounded-md hover:bg-green-700 transition-all text-center">
              Proceed to Payment
            </a>
          {{/ifEq}}
          {{#ifEq request.status 'payment_pending'}}
            {{#ifEq request.paymentMethod 'otc'}}
              <div class="bg-orange-600 text-white px-6 py-3 rounded-md text-center">
                Payment Reference: {{request.paymentReference}}
              </div>
            {{/ifEq}}
            {{#ifEq request.paymentMethod 'bank'}}
              <div class="bg-purple-600 text-white px-6 py-3 rounded-md text-center">
                Bank Reference: {{request.paymentReference}}
              </div>
            {{/ifEq}}
          {{/ifEq}}
          <a href="/browse" class="bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 transition-all text-center">
            Submit New Request
          </a>
        </div>

        {{#if events}}<section class="mt-8 border-t border-gray-200 pt-6"><h2 class="text-xl font-semibold mb-4">Processing history</h2><ol class="timeline">{{#each events}}<li><strong>{{status}}</strong> · {{detail}}<small>{{when}}</small></li>{{/each}}</ol></section>{{/if}}
      {{else}}
        <!-- Request Not Found -->
        <div class="text-center py-12">
          <div class="text-6xl text-gray-300 mb-4">📄</div>
          <h2 class="text-2xl font-bold text-gray-800 mb-2">Request Not Found</h2>
          <p class="text-gray-600 mb-6">The request you're looking for doesn't exist or you don't have permission to view it.</p>
          <a href="/status" class="bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 transition-all">
            Back to Status
          </a>
        </div>
      {{/if}}

    </div>
  </main>



</body>
