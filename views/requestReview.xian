{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}<header class="page-heading"><div><h1>Review request #{{request.id}}</h1><p>{{request.documentType}} certificate · {{request.fullName}} · {{request.status}}</p></div><a class="button secondary" href="/admin/requests">All requests</a></header>
<div class="dashboard-columns"><div><section class="panel"><h2>Request details</h2><p><strong>Client:</strong> {{request.fullName}}</p><p><strong>Email:</strong> {{request.email}}</p><p><strong>Phone:</strong> {{request.phone}}</p><p><strong>Purpose:</strong> {{request.purpose}}</p><p><strong>Appointment:</strong> {{request.appointmentDate}}</p><p><strong>Reschedule requested:</strong> {{#if request.rescheduleRequested}}Yes · {{request.rescheduleReason}}{{else}}No{{/if}}</p><p><strong>Notes:</strong> {{request.notes}}</p><p><strong>Assigned to:</strong> {{request.assignee}}</p><a class="button secondary" href="/request/{{request.id}}">Open request details</a></section>
{{#if canRegistry}}<section class="panel"><h2>Link verified registry information</h2><p class="small muted">The database ID is the number at the end of a resident or civil-record page URL. Confirm the client’s documents before linking.</p><form method="post" action="/admin/requests/{{request.id}}/link"><div class="form-grid"><label><span>Resident database ID *</span><input type="number" name="residentId" min="1" value="{{request.residentId}}" required></label><label><span>Civil record database ID</span><input type="number" name="recordId" min="1" value="{{request.recordId}}"></label></div><div class="actions"><button class="button" type="submit">Link verified records</button><a href="/admin/residents" class="button secondary">Find resident</a></div></form></section>{{/if}}
<section class="panel"><h2>Processing history</h2>{{#if events}}<ol class="timeline">{{#each events}}<li><strong>{{status}}</strong> · {{detail}}<small>{{when}} · {{actorName}}</small></li>{{/each}}</ol>{{else}}<p class="muted">No historical events were recorded before this feature was added.</p>{{/if}}</section></div>
<aside><section class="panel"><h2>Update processing status</h2><form method="post" action="/admin/requests/{{request.id}}/status"><label><span>Status</span><select name="status"><option value="pending">Pending</option><option value="processing">Processing</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option value="paid">Paid (verified by office)</option><option value="completed">Completed</option><option value="released">Released</option></select></label><div class="actions"><button class="button" type="submit">Update status</button></div></form></section>
<section class="panel"><h2>Assign responsible personnel</h2><form method="post" action="/admin/requests/{{request.id}}/assign"><label><span>Registry staff</span><select name="assignee" required><option value="">Select personnel</option>{{#each staff}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><div class="actions"><button class="button" type="submit">Assign request</button></div></form></section></aside></div>
</main>{{> officeFooter}}</body></html>
