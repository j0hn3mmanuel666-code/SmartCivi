{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}<header class="page-heading"><div><h1>Review request #{{request.id}}</h1><p>{{request.documentType}} certificate · {{request.fullName}} · {{request.status}}</p></div><a class="button secondary" href="/admin/requests">All requests</a></header>
<div class="dashboard-columns"><div><section class="panel"><h2>Request details</h2><dl class="detail-list"><div><dt>Client</dt><dd>{{request.fullName}}</dd></div><div><dt>Email address</dt><dd>{{request.email}}</dd></div><div><dt>Phone number</dt><dd>{{request.phone}}</dd></div><div><dt>Purpose</dt><dd>{{request.purpose}}</dd></div><div><dt>Appointment</dt><dd>{{localDateTime request.appointmentDate}}</dd></div><div><dt>Reschedule requested</dt><dd>{{#if request.rescheduleRequested}}Yes · {{request.rescheduleReason}}{{else}}No{{/if}}</dd></div><div><dt>Notes</dt><dd>{{#if request.notes}}{{request.notes}}{{else}}None recorded{{/if}}</dd></div><div><dt>Assigned to</dt><dd>{{#if request.assignee}}{{request.assignee}}{{else}}Not assigned{{/if}}</dd></div></dl><div class="actions"><a class="button secondary" href="/request/{{request.id}}">Open request details</a></div></section>
{{#if canRegistry}}<section class="panel"><h2>Link verified registry information</h2><p class="small muted">The database ID is the number at the end of a resident or civil-record page URL. Confirm the client’s documents before linking.</p><form method="post" action="/admin/requests/{{request.id}}/link"><div class="form-grid"><label><span>Resident database ID *</span><input type="number" name="residentId" min="1" value="{{request.residentId}}" required></label><label><span>Civil record database ID</span><input type="number" name="recordId" min="1" value="{{request.recordId}}"></label></div><div class="actions"><button class="button" type="submit">Link verified records</button><a href="/admin/residents" class="button secondary">Find resident</a></div></form></section>{{/if}}
<section class="panel"><h2>Processing history</h2>{{#if events}}<ol class="timeline">{{#each events}}<li><strong>{{status}}</strong> · {{detail}}<small>{{when}} · {{actorName}}</small></li>{{/each}}</ol>{{else}}<p class="muted">No historical events were recorded before this feature was added.</p>{{/if}}</section></div>
<aside><section class="panel"><h2>Update processing status</h2><form method="post" action="/admin/requests/{{request.id}}/status"><label><span>Status</span><select name="status"><option value="pending" {{#ifEq request.status 'pending'}}selected{{/ifEq}}>Pending</option><option value="processing" {{#ifEq request.status 'processing'}}selected{{/ifEq}}>Processing</option><option value="approved" {{#ifEq request.status 'approved'}}selected{{/ifEq}}>Approved</option><option value="rejected" {{#ifEq request.status 'rejected'}}selected{{/ifEq}}>Rejected</option><option value="payment_pending" {{#ifEq request.status 'payment_pending'}}selected{{/ifEq}}>Awaiting payment</option><option value="paid" {{#ifEq request.status 'paid'}}selected{{/ifEq}}>Paid (verified by office)</option><option value="completed" {{#ifEq request.status 'completed'}}selected{{/ifEq}}>Completed</option><option value="released" {{#ifEq request.status 'released'}}selected{{/ifEq}}>Released</option></select></label><div class="actions"><button class="button" type="submit">Update status</button></div></form></section>
<section class="panel"><h2>Assign responsible personnel</h2><form method="post" action="/admin/requests/{{request.id}}/assign"><label><span>Registry staff</span><select name="assignee" required><option value="">Select personnel</option>{{#each staff}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><div class="actions"><button class="button" type="submit">Assign request</button></div></form></section></aside></div>
</main>{{> officeFooter}}</body></html>
