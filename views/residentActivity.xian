{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>Resident activity</h1><p>Resident and barangay record activity, shown in Philippine time.</p></div></header><section class="panel">
<form method="get" action="/admin/resident-activity" class="toolbar"><label><span>Search activity</span><input name="q" value="{{q}}" maxlength="100" placeholder="Staff, action or reference"></label><label><span>Resident reference</span><input name="residentId" type="number" min="1" value="{{residentId}}" placeholder="Internal record number"></label><label><span>From date</span><input name="from" type="date" value="{{from}}"></label><label><span>Through date</span><input name="to" type="date" value="{{to}}"></label><button class="button" type="submit">Search</button><a class="button secondary" href="/admin/resident-activity">Reset</a></form>
<p class="small muted">{{count}} matching activities</p><div class="table-wrap"><table class="office-table"><thead><tr><th scope="col">Time</th><th scope="col">Staff member</th><th scope="col">Action</th><th scope="col">Record type</th><th scope="col">Reference</th><th scope="col">Detail</th></tr></thead><tbody>{{#each rows}}<tr><td>{{time}}</td><td>{{actorName}}</td><td>{{action}}</td><td>{{entity}}</td><td>{{#if url}}<a href="{{url}}">{{entityId}}</a>{{else}}{{entityId}}{{/if}}</td><td>{{detail}}</td></tr>{{else}}<tr><td colspan="6">No matching activity.</td></tr>{{/each}}</tbody></table></div>
<div class="pagination"><span class="small muted">Page {{page}} of {{pages}}</span><div class="record-links">{{#if previous}}<a class="button secondary" href="{{previous}}">Previous</a>{{/if}}{{#if next}}<a class="button secondary" href="{{next}}">Next</a>{{/if}}</div></div></section></main>{{> officeFooter}}</body></html>
