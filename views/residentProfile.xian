{{> head officeStyles=true}}<body class="office resident-profile-page">{{> staffNav}}
<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>Resident profile</h1><p>Municipality of Bongabong · Resident Information Management</p></div><div class="record-links no-print">{{#if printMode}}<button class="button" type="button" data-print>Print profile</button>{{else}}<a class="button" href="/admin/residents/{{resident.id}}/print">Print profile</a>{{/if}}<a class="button secondary" href="/admin/residents/{{resident.id}}">Edit resident</a></div></header>
<section class="panel resident-profile" aria-label="Resident information"><header class="resident-profile-heading"><div><p class="small muted">{{resident.residentCode}}</p><h2>{{fullName}}</h2></div><span class="badge">{{#if archived}}Archived{{else}}Active{{/if}}</span></header>
<dl class="resident-details"><div><dt>First name</dt><dd>{{resident.firstName}}</dd></div><div><dt>Middle name</dt><dd>{{#if resident.middleName}}{{resident.middleName}}{{else}}—{{/if}}</dd></div><div><dt>Last name</dt><dd>{{resident.lastName}}</dd></div><div><dt>Birth date</dt><dd>{{resident.birthDate}}</dd></div><div><dt>Age</dt><dd>{{age}}</dd></div><div><dt>Sex</dt><dd>{{sex}}</dd></div><div><dt>Civil status</dt><dd>{{civilStatus}}</dd></div><div><dt>Barangay</dt><dd>{{resident.barangay}}</dd></div><div><dt>Street / address</dt><dd>{{#if resident.address}}{{resident.address}}{{else}}—{{/if}}</dd></div><div><dt>Contact number</dt><dd>{{#if resident.phone}}{{resident.phone}}{{else}}—{{/if}}</dd></div><div><dt>Email address</dt><dd>{{#if resident.email}}{{resident.email}}{{else}}—{{/if}}</dd></div></dl>
<div class="resident-meta small muted"><p>Registered: {{registered}}</p><p>Last updated: {{updated}}</p><p>Generated: {{printed}} · Philippine time</p></div><p class="small muted">For authorized office use. This profile is a summary of the resident record and is not a civil registry certificate.</p>
<div class="record-links no-print"><a href="/admin/resident-activity?residentId={{resident.id}}">View resident activity</a><a href="/admin/residents">Resident list</a></div></section></main>{{> officeFooter}}</body></html>
