{{> head}}

<div class="flex">
    {{> sidebar}}
    
    <div class="flex-1 ml-64">
        {{> topbar}}

        <div class="p-8">
            {{#if error_msg}}
            <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
                {{#each error_msg}}
                    <p>{{this}}</p>
                {{/each}}
            </div>
            {{/if}}

            {{#if success_msg}}
            <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
                {{#each success_msg}}
                    <p>{{this}}</p>
                {{/each}}
            </div>
            {{/if}}

            <div class="mb-8">
                <a href="/residents" class="text-blue-600 hover:text-blue-800 font-medium">← Back to Residents</a>
            </div>

            <div class="max-w-3xl bg-white rounded-lg shadow p-8">
                <h1 class="text-2xl font-bold text-gray-800 mb-2">Edit Resident</h1>
                <p class="text-gray-600 mb-6">Resident ID: {{resident.resident_id}}</p>

                <form method="POST" action="/residents/{{resident.id}}/edit" class="space-y-6">
                    <!-- Personal Information -->
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b">Personal Information</h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">First Name *</label>
                                <input type="text" name="first_name" value="{{resident.first_name}}" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Middle Name</label>
                                <input type="text" name="middle_name" value="{{resident.middle_name}}" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Last Name *</label>
                                <input type="text" name="last_name" value="{{resident.last_name}}" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Birthdate *</label>
                                <input type="date" name="birthdate" value="{{formatDate resident.birthdate}}" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Sex *</label>
                                <select name="sex" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="">Select Sex</option>
                                    <option value="Male" {{#eq resident.sex 'Male'}}selected{{/eq}}>Male</option>
                                    <option value="Female" {{#eq resident.sex 'Female'}}selected{{/eq}}>Female</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Civil Status *</label>
                                <select name="civil_status" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="">Select Status</option>
                                    <option value="Single" {{#eq resident.civil_status 'Single'}}selected{{/eq}}>Single</option>
                                    <option value="Married" {{#eq resident.civil_status 'Married'}}selected{{/eq}}>Married</option>
                                    <option value="Widowed" {{#eq resident.civil_status 'Widowed'}}selected{{/eq}}>Widowed</option>
                                    <option value="Separated" {{#eq resident.civil_status 'Separated'}}selected{{/eq}}>Separated</option>
                                    <option value="Annulled" {{#eq resident.civil_status 'Annulled'}}selected{{/eq}}>Annulled</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Address *</label>
                            <textarea name="address" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" rows="3">{{resident.address}}</textarea>
                        </div>
                    </div>

                    <!-- Contact & Location Information -->
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b">Contact & Location Information</h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Barangay *</label>
                                <select name="barangay_id" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="">Select Barangay</option>
                                    {{#each barangays}}
                                    <option value="{{id}}" {{#eq ../resident.barangay_id id}}selected{{/eq}}>{{name}}</option>
                                    {{/each}}
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Contact Number *</label>
                                <input type="tel" name="contact_number" value="{{resident.contact_number}}" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <input type="email" name="email" value="{{resident.email}}" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="flex gap-4 mt-8 pt-6 border-t">
                        <a href="/residents" class="px-6 py-2 border border-gray-300 text-gray-700 font-bold rounded-lg hover:bg-gray-50">
                            Cancel
                        </a>
                        <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition">
                            Update Resident
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{{> footer}}
