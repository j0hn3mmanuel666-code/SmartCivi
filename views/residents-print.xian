<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{resident.resident_id}} - {{resident.first_name}} {{resident.last_name}}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; color: #333; line-height: 1.6; }
        .container { max-width: 900px; margin: 0 auto; padding: 40px 20px; }
        .header { text-align: center; border-bottom: 3px solid #333; padding-bottom: 20px; margin-bottom: 30px; }
        .header h1 { font-size: 28px; margin-bottom: 10px; }
        .header p { font-size: 14px; color: #666; }
        .resident-id { background-color: #f0f0f0; padding: 10px; border-radius: 4px; margin: 10px 0; font-weight: bold; }
        .section { margin-bottom: 30px; }
        .section-title { background-color: #e0e0e0; padding: 10px; font-weight: bold; margin-bottom: 15px; border-left: 4px solid #333; }
        .info-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 15px; }
        .info-row.full { grid-template-columns: 1fr; }
        .info-item { }
        .info-label { font-weight: bold; font-size: 12px; color: #666; text-transform: uppercase; margin-bottom: 5px; }
        .info-value { font-size: 14px; color: #333; padding: 8px; background-color: #fafafa; border: 1px solid #ddd; border-radius: 3px; }
        .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; font-size: 12px; color: #666; text-align: center; }
        .status { display: inline-block; padding: 4px 8px; border-radius: 3px; font-size: 12px; font-weight: bold; }
        .status-active { background-color: #d4edda; color: #155724; }
        .status-archived { background-color: #e2e3e5; color: #383d41; }
        @media print {
            body { padding: 0; }
            .container { padding: 0; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>RESIDENT PROFILE</h1>
            <p>Municipality of Bansud, Oriental Mindoro</p>
            <div class="resident-id">Resident ID: {{resident.resident_id}}</div>
        </div>

        <!-- Personal Information -->
        <div class="section">
            <div class="section-title">Personal Information</div>
            <div class="info-row">
                <div class="info-item">
                    <div class="info-label">Full Name</div>
                    <div class="info-value">{{resident.first_name}} {{#if resident.middle_name}}{{resident.middle_name}}{{/if}} {{resident.last_name}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Birthdate</div>
                    <div class="info-value">{{dateFormat resident.birthdate}}</div>
                </div>
            </div>
            <div class="info-row">
                <div class="info-item">
                    <div class="info-label">Sex</div>
                    <div class="info-value">{{resident.sex}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Civil Status</div>
                    <div class="info-value">{{resident.civil_status}}</div>
                </div>
            </div>
        </div>

        <!-- Location Information -->
        <div class="section">
            <div class="section-title">Location Information</div>
            <div class="info-row full">
                <div class="info-item">
                    <div class="info-label">Address</div>
                    <div class="info-value">{{resident.address}}</div>
                </div>
            </div>
            <div class="info-row">
                <div class="info-item">
                    <div class="info-label">Barangay</div>
                    <div class="info-value">{{#if resident.Barangay}}{{resident.Barangay.name}}{{else}}-{{/if}}</div>
                </div>
            </div>
        </div>

        <!-- Contact Information -->
        <div class="section">
            <div class="section-title">Contact Information</div>
            <div class="info-row">
                <div class="info-item">
                    <div class="info-label">Contact Number</div>
                    <div class="info-value">{{resident.contact_number}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Email</div>
                    <div class="info-value">{{#if resident.email}}{{resident.email}}{{else}}-{{/if}}</div>
                </div>
            </div>
        </div>

        <!-- Registration Information -->
        <div class="section">
            <div class="section-title">Registration Information</div>
            <div class="info-row">
                <div class="info-item">
                    <div class="info-label">Registration Date</div>
                    <div class="info-value">{{dateFormat resident.createdAt}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Status</div>
                    <div class="info-value">
                        {{#eq resident.status 'active'}}
                        <span class="status status-active">✅ Active</span>
                        {{else}}
                        <span class="status status-archived">📦 Archived</span>
                        {{/eq}}
                    </div>
                </div>
            </div>
        </div>

        <div class="footer">
            <p>Document Generated: {{dateTimeFormat now}}</p>
            <p style="margin-top: 20px;">This is an official record from the Bansud Resident Information Management System</p>
        </div>
    </div>

    <script>
        window.print();
    </script>
</body>
</html>
