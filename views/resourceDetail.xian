{{> head}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>{{resource.name}}</h1><p>{{resource.code}} · {{resource.department}} · {{resource.category}}{{#if resource.archivedAt}} · Archived{{/if}}</p></div><a class="button secondary" href="/admin/resources">All resources</a></header>
<div class="detail-strip"><div><strong>{{resource.quantity}}</strong><span>{{resource.unit}} available</span></div><div><strong>{{resource.minimum}}</strong><span>Low stock threshold</span></div><div><strong>{{resource.condition}}</strong><span>Condition</span></div>{{#if resource.position}}<div><strong>{{resource.position}}</strong><span>Position</span></div>{{/if}}</div>
{{#unless resource.archivedAt}}<section class="panel"><h2>Record an allocation or stock movement</h2><p class="small muted">Use Allocate for personnel and equipment assignments or supplies issued on loan. Consume records supplies used without a return.</p><form method="post" action="/admin/resources/{{resource.id}}/move" data-save><div class="form-grid"><label><span>Movement</span><select name="action" required><option value="allocate">Allocate / assign</option><option value="replenish">Replenish stock</option><option value="consume">Consume supplies</option></select></label><label><span>Quantity *</span><input name="quantity" type="number" min="1" step="1" max="2147483647" required></label><label><span>Assigned office / recipient (required for allocation)</span><input name="recipient" maxlength="150"></label><label><span>Expected return date</span><input name="dueDate" type="date"></label><label class="wide"><span>Notes</span><input name="notes" maxlength="1000"></label></div><div class="actions"><button class="button" type="submit">Record movement</button></div></form></section>{{/unless}}
<section class="panel"><h2>Outstanding allocations ({{allocationCount}})</h2>{{#if allocations}}<div class="table-wrap"><table class="office-table"><thead><tr><th>Recipient</th><th>Allocated</th><th>Outstanding</th><th>Due</th><th>Return</th></tr></thead><tbody>{{#each allocations}}<tr><td>{{recipient}}</td><td>{{quantity}}</td><td>{{outstanding}}</td><td>{{dueDate}}</td><td>{{#if outstanding}}<form method="post" action="/admin/resources/{{resourceId}}/move" class="toolbar"><input type="hidden" name="action" value="return"><input type="hidden" name="allocationId" value="{{id}}"><label><span>Quantity to return</span><input type="number" name="quantity" min="1" max="{{outstanding}}" value="{{outstanding}}" required></label><button type="submit" class="button secondary">Return</button></form>{{else}}Returned{{/if}}</td></tr>{{/each}}</tbody></table></div><div class="pagination">{{#if allocationPrevious}}<a class="button secondary" href="{{allocationPrevious}}">Previous allocations</a>{{/if}}{{#if allocationNext}}<a class="button secondary" href="{{allocationNext}}">Next allocations</a>{{/if}}</div>{{else}}<p class="muted">No outstanding allocations. Completed returns remain in the movement history.</p>{{/if}}</section>
<section class="panel"><h2>Movement history</h2><div class="table-wrap"><table class="office-table"><thead><tr><th>Time</th><th>Movement</th><th>Quantity</th><th>Available after</th><th>Recipient</th><th>Notes</th></tr></thead><tbody>{{#each movements}}<tr><td>{{when}}</td><td>{{action}}</td><td>{{quantity}}</td><td>{{balance}}</td><td>{{recipient}}</td><td>{{notes}}</td></tr>{{/each}}</tbody></table></div><p class="small muted">Most recent 50 movements. All movements remain in the database.</p></section>
<details class="panel"><summary>Edit resource details</summary><form method="post" action="{{action}}" data-save><fieldset {{#if resource.archivedAt}}disabled{{/if}} style="border:0;padding:20px 0 0;margin:0"><legend class="small muted">Quantity changes use the movement ledger.</legend>{{> officeFields}}<div class="actions"><button class="button" type="submit">Save details</button></div></fieldset></form></details>
<form method="post" action="/admin/resources/{{resource.id}}/archive" data-confirm="Change archive state? Outstanding allocations must be returned first."><button class="button danger" type="submit">{{#if resource.archivedAt}}Restore resource{{else}}Archive resource{{/if}}</button></form>
</main>{{> officeFooter}}</body></html>
