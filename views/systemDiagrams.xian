{{> head officeStyles=true}}<body class="office diagrams-page">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>System diagrams</h1><p>Structural and behavioral documentation for SmartCivi.</p></div><div class="record-links no-print"><a class="button" href="/admin/diagrams/asset/{{diagram.file}}.svg?download=1" download>Download SVG</a><button class="button secondary" type="button" data-print>Print diagram</button></div></header>
<section class="panel no-print"><form method="get" action="/admin/diagrams" class="toolbar"><label><span>Choose a diagram</span><select name="diagram">{{#each diagrams}}<option value="{{file}}" {{#if selected}}selected{{/if}}>{{category}} · {{title}}</option>{{/each}}</select></label><button class="button" type="submit">View diagram</button></form><p class="small muted">These diagrams are an earlier documentation package. Their implementation notes may describe an older version or a proposed feature; use the current application to confirm available behavior.</p></section>
<section class="panel diagram-preview"><h2>{{diagram.title}}</h2><p class="small muted">{{diagram.purpose}}</p><img src="/admin/diagrams/asset/{{diagram.file}}.svg" alt="{{diagram.title}} diagram"><p class="small muted">Original documentation note: {{diagram.note}}</p></section></main>{{> officeFooter}}</body></html>
