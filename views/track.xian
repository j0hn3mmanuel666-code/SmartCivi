{{> head}}
<body class="public-page">
  <header class="public-header"><a class="brand" href="/"><span class="brand-mark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.75h7.2L19 8.55v11.7H7a2 2 0 0 1-2-2v-12.5a2 2 0 0 1 2-2Z"/><path d="M14 4v5h5M9 13h6M9 16.5h6"/></svg></span><span class="brand-copy"><strong>DocuTrack</strong><small>CIVIL DOCUMENTS</small></span></a><a class="staff-link" href="/">← Back to home</a></header>
  <main class="public-main public-narrow">
    <section class="public-page-heading"><p class="eyebrow"><span class="eyebrow-line"></span> REQUEST TRACKING</p><h1>Check your request status</h1><p>Enter your tracking reference and the contact phone number you provided when submitting the request.</p></section>
    <form class="form-card public-track-form" method="POST" action="/track"><input type="hidden" name="_csrf" value="{{csrfToken}}">{{#if trackingError}}<div class="notice notice-error">{{trackingError}}</div>{{/if}}<label class="form-label">Tracking reference<input name="referenceNo" value="{{referenceNo}}" maxlength="32" placeholder="DT-2026-XXXXXXXXXXXXXXXXXXXXXXXX" autocomplete="off" required></label><label class="form-label">Contact phone number<input type="tel" name="contactInfo" maxlength="80" placeholder="Enter the phone used for your request" autocomplete="tel" required></label><button class="button button-primary" type="submit">Check status <span>→</span></button></form>
    {{#if isTracked}}<section class="panel tracked-request"><div class="tracked-request-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> VERIFIED REQUEST</p><h2>{{request.documentType}}</h2><p class="reference-id">{{request.referenceNo}} <span>·</span> Submitted {{request.displayDate}}</p></div><span class="status status-{{request.statusClass}}"><i></i>{{request.status}}</span></div><p class="tracked-updated">Last updated {{request.displayUpdated}}</p>
      {{#if successMessage}}<div class="notice notice-success">{{successMessage}}</div>{{/if}}
      {{#if request.isCorrectionRequested}}<div class="correction-instructions"><strong>Additional information is needed</strong>{{#if request.latestRemarks}}<p>{{request.latestRemarks}}</p>{{else}}<p>Please contact the records office for instructions, then provide the requested information below.</p>{{/if}}</div><form class="correction-form" method="POST" action="/track/corrections"><input type="hidden" name="_csrf" value="{{csrfToken}}"><input type="hidden" name="referenceNo" value="{{request.referenceNo}}"><label class="form-label">Verify your contact phone again<input type="tel" name="contactInfo" maxlength="80" autocomplete="tel" required></label><label class="form-label">Updated purpose<textarea name="purpose" maxlength="5000" rows="4" required placeholder="Provide the corrected or missing purpose information requested by the records office."></textarea></label><button class="button button-primary" type="submit">Resubmit corrections</button></form>{{/if}}
      <p class="tracking-privacy">For your privacy, this page shows request status only. Keep your reference number safe and contact the records office for questions.</p>
    </section>{{/if}}
    <p class="public-signin-note">Processing staff? <a href="/login">Sign in to the staff workspace</a></p>
  </main>
  <footer class="public-footer">© 2026 DocuTrack · Civil Document Processing and Tracking System</footer>
{{> footer }}
