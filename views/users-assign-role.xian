{{> head}}

<div class="flex">
    {{> sidebar}}
    
    <div class="flex-1 ml-64">
        {{> topbar}}

        <div class="p-8">
            {{#if error_msg}}
            <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
                {{#each error_msg}}
                    <p>{{this}}</p>
                {{/each}}
            </div>
            {{/if}}

            <div class="mb-8">
                <a href="/users/{{user.id}}" class="text-blue-600 hover:text-blue-800 font-medium">← Back to Profile</a>
            </div>

            <div class="max-w-2xl bg-white rounded-lg shadow p-8">
                <h1 class="text-2xl font-bold text-gray-800 mb-8">Assign Role</h1>

                <!-- User Info -->
                <div class="bg-blue-50 p-4 rounded-lg mb-8">
                    <div class="mb-3">
                        <p class="text-sm text-gray-600">User:</p>
                        <p class="font-semibold text-gray-800 text-lg">{{user.Profile.first_name}} {{user.Profile.last_name}}</p>
                    </div>
                    <div class="mb-3">
                        <p class="text-sm text-gray-600">Email:</p>
                        <p class="font-semibold text-gray-800">{{user.email}}</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Current Role:</p>
                        <p class="font-semibold text-gray-800">
                            {{#each user.Roles}}
                                {{name}}{{#unless @last}}, {{/unless}}
                            {{/each}}
                        </p>
                    </div>
                </div>

                <!-- Role Selection -->
                <form method="POST" action="/users/{{user.id}}/assign-role">
                    <div class="space-y-4 mb-8">
                        {{#each allRoles}}
                        <label class="block p-4 border-2 rounded-lg cursor-pointer hover:border-blue-500 transition" 
                               style="border-color: {{#eq id ../currentRole}}#3b82f6{{else}}#e5e7eb{{/eq}}">
                            <div class="flex items-start">
                                <input type="radio" name="role_id" value="{{id}}" {{#eq id ../currentRole}}checked{{/eq}} class="mt-1 mr-3">
                                <div class="flex-1">
                                    <p class="font-semibold text-gray-800">{{name}}</p>
                                    <p class="text-sm text-gray-600 mt-1">{{description}}</p>
                                    {{#if Permissions}}
                                    <div class="mt-2 pl-4 border-l-2 border-blue-300">
                                        <p class="text-xs font-semibold text-gray-700 mb-1">Permissions:</p>
                                        <ul class="text-xs text-gray-600 space-y-1">
                                            {{#each Permissions}}
                                            <li>✓ {{name}}</li>
                                            {{/each}}
                                        </ul>
                                    </div>
                                    {{/if}}
                                </div>
                            </div>
                        </label>
                        {{/each}}
                    </div>

                    <!-- Buttons -->
                    <div class="flex gap-4 mt-8 pt-6 border-t">
                        <a href="/users/{{user.id}}" class="px-6 py-2 border border-gray-300 text-gray-700 font-bold rounded-lg hover:bg-gray-50">
                            Cancel
                        </a>
                        <button type="submit" class="px-6 py-2 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg transition">
                            Confirm Role Change
                        </button>
                    </div>

                    <p class="text-xs text-gray-600 mt-4 p-3 bg-yellow-50 rounded border border-yellow-200">
                        ℹ️ Role change takes effect on the user's next login.
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
Handlebars.registerHelper('eq', function(a, b) { return a === b; });
</script>

{{> footer}}
