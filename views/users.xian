{{> head}}

<div class="flex">
    {{> sidebar}}
    
    <div class="flex-1 ml-64">
        {{> topbar}}

        <div class="p-8">
            {{#if success_msg}}
            <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
                {{#each success_msg}}
                    <p>{{this}}</p>
                {{/each}}
            </div>
            {{/if}}

            <div class="flex justify-between items-start mb-6">
                <div>
                    <h1 class="text-3xl font-bold text-gray-800 mb-2">User Management</h1>
                    <p class="text-gray-600">Manage SmartCivi user accounts and access</p>
                </div>
                <a href="/users/add" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-6 rounded-lg transition">
                    + Add User
                </a>
            </div>

            <!-- Filters -->
            <div class="bg-white rounded-lg shadow p-6 mb-6">
                <form method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <input type="text" name="search" placeholder="Search by name, email, username" value="{{search}}" class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    
                    <select name="role" class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">All Roles</option>
                        <option value="Administrator" {{#eq selectedRole 'Administrator'}}selected{{/eq}}>Administrator</option>
                        <option value="LGU Staff" {{#eq selectedRole 'LGU Staff'}}selected{{/eq}}>LGU Staff</option>
                        <option value="Resident" {{#eq selectedRole 'Resident'}}selected{{/eq}}>Resident</option>
                    </select>

                    <select name="status" class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">All Statuses</option>
                        <option value="active" {{#eq selectedStatus 'active'}}selected{{/eq}}>Active</option>
                        <option value="inactive" {{#eq selectedStatus 'inactive'}}selected{{/eq}}>Inactive</option>
                    </select>

                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition">
                        Search
                    </button>
                </form>
            </div>

            <!-- Users Table -->
            <div class="bg-white rounded-lg shadow overflow-hidden">
                {{#if users}}
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-100 border-b">
                            <tr>
                                <th class="text-left py-3 px-4 font-semibold text-gray-800">User</th>
                                <th class="text-left py-3 px-4 font-semibold text-gray-800">Email</th>
                                <th class="text-left py-3 px-4 font-semibold text-gray-800">Role</th>
                                <th class="text-left py-3 px-4 font-semibold text-gray-800">Status</th>
                                <th class="text-left py-3 px-4 font-semibold text-gray-800">Date Created</th>
                                <th class="text-left py-3 px-4 font-semibold text-gray-800">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each users}}
                            <tr class="border-b hover:bg-gray-50">
                                <td class="py-3 px-4">
                                    <div class="flex items-center">
                                        <div class="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center text-white font-bold mr-3">
                                            {{substr Profile.first_name 0 1}}
                                        </div>
                                        <div>
                                            <p class="font-semibold text-gray-800">{{Profile.first_name}} {{Profile.last_name}}</p>
                                            <p class="text-xs text-gray-500">@{{username}}</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-gray-600">{{email}}</td>
                                <td class="py-3 px-4">
                                    {{#each Roles}}
                                    <span class="inline-block bg-blue-100 text-blue-800 text-xs px-3 py-1 rounded-full">{{name}}</span>
                                    {{/each}}
                                </td>
                                <td class="py-3 px-4">
                                    {{#eq status 'active'}}
                                    <span class="inline-block bg-green-100 text-green-800 text-xs px-3 py-1 rounded-full">✅ Active</span>
                                    {{else}}
                                    <span class="inline-block bg-red-100 text-red-800 text-xs px-3 py-1 rounded-full">❌ Inactive</span>
                                    {{/eq}}
                                </td>
                                <td class="py-3 px-4 text-sm text-gray-500">{{dateFormat createdAt}}</td>
                                <td class="py-3 px-4">
                                    <div class="flex gap-2">
                                        <a href="/users/{{id}}" class="text-blue-600 hover:text-blue-800 font-medium">View</a>
                                        <a href="/users/{{id}}/edit" class="text-blue-600 hover:text-blue-800 font-medium">Edit</a>
                                        <a href="/users/{{id}}/assign-role" class="text-purple-600 hover:text-purple-800 font-medium">Role</a>
                                    </div>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="flex justify-center items-center gap-2 py-4 px-4">
                    {{#if (gt currentPage 1)}}
                    <a href="?page={{subtract currentPage 1}}&search={{search}}&role={{selectedRole}}&status={{selectedStatus}}" class="px-3 py-1 border border-gray-300 rounded hover:bg-gray-100">← Prev</a>
                    {{/if}}

                    {{#each (range 1 (add totalPages 1))}}
                    {{#eq this ../currentPage}}
                    <span class="px-3 py-1 bg-blue-600 text-white rounded font-bold">{{this}}</span>
                    {{else}}
                    <a href="?page={{this}}&search={{../search}}&role={{../selectedRole}}&status={{../selectedStatus}}" class="px-3 py-1 border border-gray-300 rounded hover:bg-gray-100">{{this}}</a>
                    {{/eq}}
                    {{/each}}

                    {{#if (lt currentPage totalPages)}}
                    <a href="?page={{add currentPage 1}}&search={{search}}&role={{selectedRole}}&status={{selectedStatus}}" class="px-3 py-1 border border-gray-300 rounded hover:bg-gray-100">Next →</a>
                    {{/if}}
                </div>

                {{else}}
                <div class="text-center py-12">
                    <p class="text-gray-600 text-lg">No users found. <a href="/users/add" class="text-blue-600 hover:text-blue-800 font-semibold">Add one to get started</a></p>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>



{{> footer}}
