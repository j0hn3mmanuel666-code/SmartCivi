{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>User and access management</h1><p>Assign office responsibilities. Citizen accounts keep access to their own requests, appointments and payments.</p></div></header>
<details class="panel disclosure-panel"><summary>Create an account</summary><div class="disclosure-body"><form method="post" action="/admin/users"><div class="form-grid"><label><span>Full name *</span><input name="name" required maxlength="255" autocomplete="name"></label><label><span>Username (optional)</span><input name="username" maxlength="40" minlength="3" pattern="[A-Za-z][A-Za-z0-9._-]{2,39}" autocomplete="off"></label><label><span>Status</span><select name="isActive"><option value="true">Active</option><option value="false">Inactive</option></select></label><label><span>Email *</span><input name="email" type="email" required maxlength="255" autocomplete="email"></label><label><span>Password (8â€“72 bytes) *</span><input name="password" type="password" required minlength="8" maxlength="72" autocomplete="new-password"></label><label><span>Role *</span><select name="role" required><option value="user">Citizen</option><option value="staff">Front desk staff</option><option value="registrar">Civil registrar</option><option value="resource_officer">Resource officer</option><option value="admin">Administrator</option></select></label></div><div class="actions"><button class="button" type="submit">Create account</button></div></form></div></details>
<details class="panel disclosure-panel"><summary>Roles and responsibilities</summary><div class="disclosure-body"><div class="table-wrap"><table class="office-table"><thead><tr><th>Role</th><th>Access</th></tr></thead><tbody><tr><td>Citizen</td><td>Own requests, appointments, payments and notifications</td></tr><tr><td>Front desk staff</td><td>Residents, barangays, population reports, resident activity, document requests and appointments</td></tr><tr><td>Civil registrar</td><td>Resident-management tools plus civil records, requests, appointments and registry reports</td></tr><tr><td>Resource officer</td><td>Personnel, supplies, equipment, stock movements and resource reports</td></tr><tr><td>Administrator</td><td>All office modules, users, audit history, operations and integration readiness</td></tr></tbody></table></div></div></details>
<section class="panel"><h2>Accounts</h2><form method="get" action="/admin/users" class="toolbar"><label><span>Search accounts</span><input type="search" name="q" value="{{q}}" placeholder="Name, username or email address" maxlength="100"></label><button type="submit" class="button">Search</button><a class="button secondary" href="/admin/users">Reset</a></form><p class="small muted">{{range}}</p><div class="table-wrap"><table id="accountsTable" class="office-table"><thead><tr><th>Name</th><th>Username</th><th>Email</th><th>Status</th><th>Role</th><th>Created</th><th>Change access</th></tr></thead><tbody>{{#each users}}<tr><td>{{name}}</td><td>{{#if username}}{{username}}{{else}}â€”{{/if}}</td><td>{{email}}</td><td>{{#if isActive}}Active{{else}}Inactive{{/if}}</td><td>{{> roleLabel user=this}}</td><td>{{localDateTime createdAt}}</td><td><form method="post" action="/admin/users" class="toolbar"><input type="hidden" name="id" value="{{id}}"><label><span>Username for {{name}}</span><input name="username" value="{{username}}" maxlength="40" minlength="3" pattern="[A-Za-z][A-Za-z0-9._-]{2,39}" autocomplete="off"></label><label><span>Status for {{name}}</span><select name="isActive"><option value="true" {{#if isActive}}selected{{/if}}>Active</option><option value="false" {{#unless isActive}}selected{{/unless}}>Inactive</option></select></label><label><span>Role for {{name}}</span><select name="role"><option value="user" {{#ifEq role 'user'}}selected{{/ifEq}}>Citizen</option><option value="staff" {{#ifEq role 'staff'}}selected{{/ifEq}}>Front desk staff</option><option value="registrar" {{#ifEq role 'registrar'}}selected{{/ifEq}}>Civil registrar</option><option value="resource_officer" {{#ifEq role 'resource_officer'}}selected{{/ifEq}}>Resource officer</option><option value="admin" {{#ifEq role 'admin'}}selected{{/ifEq}}>Administrator</option></select></label><button class="button secondary" type="submit">Save access</button></form></td></tr>{{/each}}</tbody></table></div><div class="pagination"><span class="small muted">Page {{page}} of {{pages}}</span><div class="record-links">{{#if previous}}<a class="button secondary" href="{{previous}}">Previous</a>{{/if}}{{#if next}}<a class="button secondary" href="{{next}}">Next</a>{{/if}}</div></div></section>
</main>{{> officeFooter}}</body></html>
