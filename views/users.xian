{{> head }}
<body class="bg-gradient-to-br from-pink-300 via-purple-300 to-blue-400 text-gray-800 min-h-screen">

  <nav class="fixed w-full top-0 z-50 bg-gradient-to-r from-pink-500 to-blue-600 text-white shadow-lg">
    <div class="container mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="text-2xl font-bold tracking-wide">SmartCivi</a>

      <ul class="hidden md:flex space-x-6 font-medium">
        <li><a href="/admin" class="hover:text-yellow-300 transition-all">Dashboard</a></li>
        <li><a href="/admin/requests" class="hover:text-yellow-300 transition-all">Requests</a></li>
        <li><a href="/admin/users" class="hover:text-yellow-300 transition-all text-yellow-300">Users</a></li>
        <li><a href="/help" class="hover:text-yellow-300 transition-all">Help</a></li>
      </ul>

      <div class="hidden md:flex space-x-4">
        <a href="/logout" class="bg-white text-blue-600 px-4 py-2 rounded-md hover:bg-gray-100 transition-all">Logout</a>
      </div>

      <button class="md:hidden hover:opacity-80">☰</button>
    </div>
  </nav>

  <section class="flex flex-col justify-center items-center text-center h-44 px-6 pt-24">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white drop-shadow-md">User Management</h1>
    <p class="text-md md:text-lg text-white mt-3 max-w-2xl">Manage user accounts, roles, and permissions.</p>
    <div class="mt-3">
      <a href="/admin" class="text-sm text-white underline">← Back to Admin Dashboard</a>
    </div>
  </section>

  <main class="container mx-auto px-4 py-8">
    
    <!-- Add New User Section -->
    <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6 mb-6 max-w-4xl mx-auto">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Add New User</h2>
      
      <form method="POST" action="/admin/users" class="grid md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
          <input type="text" name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter full name">
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
          <input type="email" name="email" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter email address">
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
          <input type="password" name="password" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter password">
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
          <select name="role" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">Select Role</option>
            <option value="user">User</option>
            <option value="staff">Staff</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        
        <div class="md:col-span-2">
          <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 transition-all">
            Add User
          </button>
        </div>
      </form>
    </div>

    <!-- Users List -->
    <div class="bg-white bg-opacity-90 rounded-lg shadow-md p-6 max-w-6xl mx-auto">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-semibold text-gray-800">All Users</h2>
        <div class="text-sm text-gray-600">
          Total: {{users.length}} users
        </div>
      </div>

      {{#if users}}
        <div class="overflow-x-auto">
          <table class="min-w-full">
            <thead class="bg-gray-100">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">ID</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Name</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Email</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Role</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Created</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {{#each users}}
                <tr class="hover:bg-gray-50" data-user-id="{{this.id}}">
                  <td class="px-4 py-3 text-sm text-gray-900">{{this.id}}</td>
                  <td class="px-4 py-3 text-sm text-gray-900">{{this.name}}</td>
                  <td class="px-4 py-3 text-sm text-gray-600">{{this.email}}</td>
                  <td class="px-4 py-3">
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                      {{#ifEq this.role 'admin'}}bg-red-100 text-red-800{{/ifEq}}
                      {{#ifEq this.role 'staff'}}bg-blue-100 text-blue-800{{/ifEq}}
                      {{#ifEq this.role 'user'}}bg-green-100 text-green-800{{/ifEq}}">
                      {{this.role}}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-sm text-gray-600">{{this.createdAt}}</td>
                  <td class="px-4 py-3">
                    <div class="flex items-center space-x-2">
                      <!-- Edit Role Form -->
                      <form method="POST" action="/admin/users" class="flex items-center space-x-2">
                        <input type="hidden" name="id" value="{{this.id}}">
                        <input type="hidden" name="name" value="{{this.name}}">
                        <input type="hidden" name="email" value="{{this.email}}">
                        <select name="role" class="text-xs px-2 py-1 border border-gray-300 rounded">
                          <option value="user" {{#ifEq this.role 'user'}}selected{{/ifEq}}>User</option>
                          <option value="staff" {{#ifEq this.role 'staff'}}selected{{/ifEq}}>Staff</option>
                          <option value="admin" {{#ifEq this.role 'admin'}}selected{{/ifEq}}>Admin</option>
                        </select>
                        <button type="submit" class="bg-blue-600 text-white px-2 py-1 rounded text-xs hover:bg-blue-700 transition-all">
                          Update
                        </button>
                      </form>

                      <!-- Delete Button -->
                      <button onclick="deleteUser({{this.id}})" class="bg-red-600 text-white px-2 py-1 rounded text-xs hover:bg-red-700 transition-all">
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="text-center py-12">
          <div class="text-6xl text-gray-300 mb-4">👥</div>
          <h3 class="text-lg font-medium text-gray-800 mb-2">No Users Found</h3>
          <p class="text-gray-600">Start by adding your first user above.</p>
        </div>
      {{/if}}

    </div>
  </main>


  <script>
    // Delete user function
    async function deleteUser(userId) {
      if (!confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
        return;
      }

      try {
        const response = await fetch(`/admin/users/${userId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
          }
        });

        if (response.ok) {
          // Remove the row from the table
          const row = document.querySelector(`tr[data-user-id="${userId}"]`);
          if (row) {
            row.remove();
          }
          
          // Show success message
          showMessage('User deleted successfully', 'success');
        } else {
          showMessage('Failed to delete user', 'error');
        }
      } catch (error) {
        console.error('Error deleting user:', error);
        showMessage('An error occurred while deleting the user', 'error');
      }
    }

    // Show message function
    function showMessage(message, type) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `fixed top-20 right-4 px-4 py-2 rounded-md text-white z-50 ${
        type === 'success' ? 'bg-green-600' : 'bg-red-600'
      }`;
      messageDiv.textContent = message;
      
      document.body.appendChild(messageDiv);
      
      setTimeout(() => {
        messageDiv.remove();
      }, 3000);
    }

    // Form validation
    document.querySelector('form[action="/admin/users"]').addEventListener('submit', function(e) {
      const name = this.querySelector('input[name="name"]').value.trim();
      const email = this.querySelector('input[name="email"]').value.trim();
      const password = this.querySelector('input[name="password"]').value;
      const role = this.querySelector('select[name="role"]').value;

      if (!name || !email || !password || !role) {
        e.preventDefault();
        showMessage('Please fill in all fields', 'error');
        return;
      }

      if (password.length < 6) {
        e.preventDefault();
        showMessage('Password must be at least 6 characters long', 'error');
        return;
      }
    });
  </script>

</body>