{{> head officeStyles=true}}<body class="office">{{> staffNav}}<main id="main" class="office-main">{{> officeFlash}}
<header class="page-heading"><div><h1>User and access management</h1><p>Assign office responsibilities. Citizen accounts keep access to their own requests, appointments and payments.</p></div></header>
<section class="panel"><h2>Add account</h2><form method="post" action="/admin/users"><div class="form-grid"><label><span>Full name *</span><input name="name" required maxlength="255" autocomplete="name"></label><label><span>Email *</span><input name="email" type="email" required maxlength="255" autocomplete="email"></label><label><span>Password (8–72 bytes) *</span><input name="password" type="password" required minlength="8" maxlength="72" autocomplete="new-password"></label><label><span>Role *</span><select name="role" required><option value="user">Citizen</option><option value="staff">Front desk staff</option><option value="registrar">Civil registrar</option><option value="resource_officer">Resource officer</option><option value="admin">Administrator</option></select></label></div><div class="actions"><button class="button" type="submit">Create account</button></div></form></section>
<section class="panel"><h2>Roles and responsibilities</h2><div class="table-wrap"><table class="office-table"><thead><tr><th>Role</th><th>Access</th></tr></thead><tbody><tr><td>Citizen</td><td>Own requests, appointments, payments and notifications</td></tr><tr><td>Front desk staff</td><td>Resident profiles, document requests and appointments</td></tr><tr><td>Civil registrar</td><td>Resident profiles, civil records, requests, appointments and registry reports</td></tr><tr><td>Resource officer</td><td>Personnel, supplies, equipment, stock movements and resource reports</td></tr><tr><td>Administrator</td><td>All office modules, users, audit history, operations and integration readiness</td></tr></tbody></table></div></section>
<section class="panel"><h2>Accounts ({{users.length}})</h2><div class="table-wrap"><table class="office-table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Created</th><th>Change access</th></tr></thead><tbody>{{#each users}}<tr><td>{{name}}</td><td>{{email}}</td><td>{{role}}</td><td>{{createdAt}}</td><td><form method="post" action="/admin/users" class="toolbar"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="name" value="{{name}}"><input type="hidden" name="email" value="{{email}}"><label><span>Role for {{name}}</span><select name="role"><option value="user" {{#ifEq role 'user'}}selected{{/ifEq}}>Citizen</option><option value="staff" {{#ifEq role 'staff'}}selected{{/ifEq}}>Front desk staff</option><option value="registrar" {{#ifEq role 'registrar'}}selected{{/ifEq}}>Civil registrar</option><option value="resource_officer" {{#ifEq role 'resource_officer'}}selected{{/ifEq}}>Resource officer</option><option value="admin" {{#ifEq role 'admin'}}selected{{/ifEq}}>Administrator</option></select></label><button class="button secondary" type="submit">Save role</button></form></td></tr>{{/each}}</tbody></table></div></section>
</main>{{> officeFooter}}</body></html>
