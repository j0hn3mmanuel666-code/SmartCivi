{{> head}}
<body>
  <div class="app-shell">
    {{> workspace-sidebar}}
    <main class="main-area">
      {{> workspace-topbar}}
      <div class="page-content">
        <section class="welcome-row"><div><p class="eyebrow"><span class="eyebrow-line"></span>{{currentDate}}</p><h1>Welcome, {{greeting}} <span class="wave">✳</span></h1><p class="welcome-subtitle">{{#if isApplicant}}Submit a civil document request and follow every update here.{{else}}Review document requests and keep each applicant informed.{{/if}}</p></div>{{#if isApplicant}}<a class="button button-primary" href="/requests/new"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>New request</a>{{/if}}</section>
        {{#each success_msg}}<div class="notice notice-success">{{this}}</div>{{/each}}{{#each error_msg}}<div class="notice notice-error">{{this}}</div>{{/each}}
        <section class="stat-grid" aria-label="Request summary">
          <article class="stat-card"><div class="stat-heading"><span>{{#if isApplicant}}My requests{{else}}Requests in workspace{{/if}}</span><span class="stat-icon icon-blue"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.75h7l4 4v12.5h-11a1.5 1.5 0 0 1-1.5-1.5v-13a2 2 0 0 1 1.5-2Z"/><path d="M13.5 4v4.5H18"/></svg></span></div><div class="stat-value">{{totalRequests}}</div><div class="stat-foot"><span>Registered document requests</span></div></article>
          <article class="stat-card"><div class="stat-heading"><span>Active requests</span><span class="stat-icon icon-amber"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/></svg></span></div><div class="stat-value">{{activeCount}}</div><div class="stat-foot"><span>Still in progress</span></div></article>
          <article class="stat-card"><div class="stat-heading"><span>Under review</span><span class="stat-icon icon-violet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12s3.2-6 9-6 9 6 9 6-3.2 6-9 6-9-6-9-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></span></div><div class="stat-value">{{lookup counts "Under Review"}}</div><div class="stat-foot"><span>Awaiting staff decision</span></div></article>
          <article class="stat-card"><div class="stat-heading"><span>{{#if isApplicant}}Correction requests{{else}}Ready for release{{/if}}</span><span class="stat-icon icon-green"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span></div><div class="stat-value">{{#if isApplicant}}{{lookup counts "Correction Requested"}}{{else}}{{lookup counts "Ready for Release"}}{{/if}}</div><div class="stat-foot"><span>{{#if isApplicant}}Need your attention{{else}}Approved documents{{/if}}</span></div></article>
        </section>
        <section class="content-grid workspace-grid">
          <section class="documents-panel panel" id="requests">
            <div class="panel-heading"><div><h2>{{#if isApplicant}}Your document requests{{else}}Document review queue{{/if}}</h2><p>{{#if isApplicant}}Track submitted requests and open a reference for its full history.{{else}}Review submissions, request corrections, approve or release records.{{/if}}</p></div>{{#if isStaff}}<a class="button button-light export-button" href="/reports.csv">Export report</a>{{/if}}</div>
            <div class="table-toolbar"><label class="search-box"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg><input type="search" id="requestSearch" placeholder="Search reference, name or document..." aria-label="Search requests"></label><label class="filter-select"><select id="requestFilter" aria-label="Filter requests"><option value="all">All statuses</option><option>Submitted</option><option>Under Review</option><option>Correction Requested</option><option>Approved</option><option>Rejected</option><option>Ready for Release</option><option>Released</option></select></label></div>
            <div class="table-scroll"><table class="document-table"><thead><tr><th>REFERENCE / DOCUMENT</th>{{#if isStaff}}<th>APPLICANT</th>{{/if}}<th>SUBMITTED</th><th>STATUS</th><th>ASSIGNED STAFF</th><th></th></tr></thead><tbody id="requestRows">
              {{#each requests}}<tr data-status="{{status}}"><td><div class="document-name"><span class="file-icon file-blue"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.75h7l4 4v12.5h-11a1.5 1.5 0 0 1-1.5-1.5v-13a2 2 0 0 1 1.5-2Z"/><path d="M13.5 4v4.5H18M8 13h8M8 16.5h5"/></svg></span><span><strong>{{documentType}}</strong><small>{{referenceNo}}</small></span></div></td>{{#if ../isStaff}}<td><span class="type-label">{{applicantName}}</span><br><span class="date-label">{{contactEmail}}</span></td>{{/if}}<td><span class="date-label">{{displayDate}}</span></td><td><span class="status status-{{statusClass}}"><i></i>{{status}}</span></td><td><span class="type-label">{{#if assignedStaff}}{{assignedStaff.name}}{{else}}Unassigned{{/if}}</span></td><td><a class="row-menu row-open" href="/requests/{{id}}" aria-label="Open {{referenceNo}}">↗</a></td></tr>{{else}}<tr><td class="empty-row" colspan="6"><strong>No requests yet</strong><span>{{#if isApplicant}}Start by submitting your first document request.{{else}}New applicant requests will appear in this review queue.{{/if}}</span>{{#if isApplicant}}<a class="button button-primary" href="/requests/new">Submit a request</a>{{/if}}</td></tr>{{/each}}
            </tbody></table><div class="empty-state" id="requestEmpty" hidden>No requests match this search.</div></div>
            <div class="table-footer"><span>Showing <strong id="requestCount">{{requests.length}}</strong> requests{{#if requestListTruncated}} (newest 500 shown){{/if}}</span></div>
          </section>
          <aside class="activity-panel panel"><div class="panel-heading activity-heading"><div><h2>Notifications</h2><p>Updates about your document requests</p></div></div><div class="notification-list">{{#each notifications}}<article class="notification-item {{#unless readAt}}notification-unread{{/unless}}"><span class="notification-indicator"></span><div><p>{{message}}</p><span>{{createdAt}}</span>{{#if request}}<a href="/requests/{{request.id}}">Open {{request.referenceNo}} →</a>{{/if}}</div>{{#unless readAt}}<form method="POST" action="/notifications/{{id}}/read"><input type="hidden" name="_csrf" value="{{../../csrfToken}}"><button class="mark-read" type="submit" aria-label="Mark notification as read">✓</button></form>{{/unless}}</article>{{else}}<div class="notification-empty">You’re all caught up. New request updates will appear here.</div>{{/each}}</div><a class="activity-link" href="/activity">View activity log <span>→</span></a></aside>
        </section>
        <footer class="page-footer"><span>© 2026 DocuTrack · Civil Document Processing and Tracking System</span><span><span class="system-status"></span> MySQL-backed request tracking</span></footer>
      </div>
    </main>
  </div>
  <script src="/workspace.js" defer></script>
{{> footer }}
